#!/usr/bin/env bash
# @file pre-push
# @brief Stop a push whose pushed content holds a secret-like match (plan 024 P1-5).
# @description
#   For each stdin line `<local ref> <local sha> <remote ref> <remote sha>` whose local sha is not all zeros, every commit
#   of `<remote sha>..<local sha>` (from `git merge-base origin/main <local sha>` when the remote sha is all zeros),
#   merges included, appends the whole content of each blob it adds or changes to a `mktemp` file: `git cat-file blob
#   <commit>:<path>`, the raw form of `git show <commit>:<path>` without textconv, so no binary attribute or NUL byte
#   turns it into a summary, then a newline, so no token joins the last word of the blob before it. `result-precheck.sh --secrets` scans that file; a match prints its count and the range,
#   never the text, and stops the push, as does a range git cannot read.
# @stdin The ref lines git passes to a pre-push hook.
# @exitcode 0 No pushed content holds a match. 1 A match, or a range that cannot be read.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
work="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
trap 'rm -rf -- "${work}"' EXIT
status=0
while read -r ref sha _ remote; do
    [[ ! ${sha} =~ ^0+$ ]] || continue
    [[ ! ${remote} =~ ^0+$ ]] || remote="$(git merge-base origin/main "${sha}")"
    : > "${work}/scan"
    git rev-list "${remote}..${sha}" > "${work}/commits"
    while read -r commit; do
        git diff-tree -r -m --root --no-commit-id --name-only -z --diff-filter=d "${commit}" > "${work}/paths"
        while IFS= read -r -d '' path; do
            [[ "$(git cat-file -t "${commit}:${path}")" == blob ]] || continue
            git cat-file blob "${commit}:${path}" >> "${work}/scan"
            echo >> "${work}/scan" # a boundary: a blob's last word never joins the next blob's first
        done < "${work}/paths"
    done < "${work}/commits"
    count="$(bash "${root}/scripts/orchestrator/result-precheck.sh" --secrets "${work}/scan" < /dev/null)" && continue
    echo "pre-push: ${count#secrets: } in ${remote}..${sha} (${ref}); the push is stopped" >&2
    status=1
done
exit "${status}"
