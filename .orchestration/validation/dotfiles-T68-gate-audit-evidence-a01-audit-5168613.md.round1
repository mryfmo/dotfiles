  1040	        for label, dispositions, message in (
  1041	            ("no dispositions", None, "AUDIT_DISPOSITIONS must name the acceptance record"),
  1042	            ("fixed commit", f"audit-finding: 1 fixed:{'a' * 7}\naudit-finding: 2 {reason}\n", "a fix moves HEAD"),
  1043	            ("short reason", f"audit-finding: 1 not-applicable:nope\naudit-finding: 2 {reason}\n", "at least 20"),
  1044	            ("one missing", f"audit-finding: 1 {reason}\n", "leaves audit finding(s) 2 of 2 without a disposition"),
  1045	            ("unnumbered repeat", f"audit-finding: x {reason}\naudit-finding: x {reason}\n", "must name its finding"),
  1046	            (
  1047	                "same finding twice",
  1048	                f"audit-finding: 1 {reason}\naudit-finding: 1 {reason}\n",
  1049	                "finding 1 more than once",
  1050	            ),
  1051	            ("out of range", f"audit-finding: 1 {reason}\naudit-finding: 3 {reason}\n", "<1-2>"),
