#!/usr/bin/env bash

# @file home/.chezmoiscripts/common/run_before_01-decrypt-private-key.sh.tmpl
# @brief Restore the private age identity when interactive input is available.
# @description
#   Runs before every apply, not once: an apply without a terminal (an agent
#   shell, ssh without a tty) cannot ask for the passphrase, and a run_once
#   script that skipped would be recorded as done and never asked again. Once
#   ~/.config/age/key.txt exists the script does nothing. A GitHub Actions
#   runner (is_ci_runner from scripts/lib/ci-runner.sh) is skipped silently.

set -Eeuo pipefail

if [ "${DOTFILES_DEBUG:-}" ]; then
    set -x
fi

{{ if or (not (hasKey . "usePrivate")) .usePrivate -}}
{{ include "../scripts/lib/ci-runner.sh" }}

# @description Return success when standard input is attached to a terminal.
function stdin_is_tty() {
    [ -t 0 ]
}

# @description Decrypt the private age identity without blocking non-interactive applies.
function decrypt_age_private_key() {
    local age_dir
    local age_src_key
    local age_dst_key
    local tmp_age_dst_key

    if is_ci_runner; then
        return 0
    fi

    age_dir="${HOME}/.config/age"
    age_src_key="{{ .chezmoi.sourceDir }}/.key.txt.age"
    age_dst_key="${age_dir}/key.txt"
    tmp_age_dst_key="${age_dst_key}.tmp"

    if [ -f "${age_dst_key}" ]; then
        return 0
    fi
    if ! stdin_is_tty; then
        echo "Notice: ${age_dst_key} not restored: no terminal for the age passphrase; the next interactive chezmoi apply asks again." >&2
        return 0
    fi
    if [ ! -f "${age_src_key}" ]; then
        echo "Warning: ${age_src_key} is missing. Skipping private encrypted dotfiles setup." >&2
        return 0
    fi

    mkdir -p "${age_dir}"

    echo "Decrypting ${age_src_key} to ${age_dst_key}"
    rm -f "${tmp_age_dst_key}"
    if ! chezmoi age decrypt --output "${tmp_age_dst_key}" --passphrase "${age_src_key}"; then
        rm -f "${tmp_age_dst_key}"
        echo "Warning: Failed to decrypt age identity key. Skipping private encrypted dotfiles setup." >&2
        return 0
    fi
    chmod 600 "${tmp_age_dst_key}"
    mv "${tmp_age_dst_key}" "${age_dst_key}"
}

# @description Run the private age identity restore flow.
function main() {
    decrypt_age_private_key
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main
fi
{{ end -}}
