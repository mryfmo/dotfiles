{{/* pstack skills for the omp consumers skills.pstack.audience names (docs/omp-skills.md): GitHub's source
     archive of cursor/plugins at assets.pstack.pin in dot_agents/agent-config.yaml, the manifest being the only
     place the pin and its sha256 live. harness/pstack/claude-code is the Claude Code build of the plugin (the
     cursor-plugins marketplace entry's source); its skills/* land in ~/.agents/pstack/skills, a root no agent
     scans by default (Codex and omp's agents provider read ~/.agents/skills), and its docs/** in
     ~/.agents/pstack/docs so a skill's ../../docs link resolves. The directory is exact: it holds the pinned
     archive's skills and docs and nothing else, so the skill names are the archive's own at every apply and a
     skill upstream drops is removed. skills.pstack.exclude is not an archive `exclude`: with both lists set,
     chezmoi extracts every member that matches neither (chezmoiexternal-format, rule 5); the omp consumers
     ignore those skills instead. */ -}}
{{ $pstack := (include "dot_agents/agent-config.yaml" | fromYaml).assets.pstack -}}
{{ $pstackURL := printf "https://github.com/cursor/plugins/archive/%s.tar.gz" $pstack.pin -}}
".agents/pstack":
  type: "archive"
  url: {{ $pstackURL | quote }}
  checksum:
    sha256: {{ $pstack.sha256 | quote }}
  exact: true
  stripComponents: 4
  include: ["*/harness/pstack/claude-code/skills/**", "*/harness/pstack/claude-code/docs/**"]
