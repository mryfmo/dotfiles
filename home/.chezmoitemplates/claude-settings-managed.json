{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1",
  "effortLevel": "xhigh",
  "advisorModel": "fable",
  "alwaysThinkingEnabled": true,
  "plansDirectory": "./.agents/worklog/claude",
  "permissions": {
    "allow": [
      "Bash(~/.local/bin/common/hcom-seat *)",
      "Bash(~/.local/bin/common/hcom-dispatch *)",
      "Bash(~/.local/bin/common/bus-history.sh *)",
      "Bash(~/.local/bin/common/worktree-gc.sh *)",
      "Bash(~/.local/bin/common/regime-init *)",
      "Bash(hcom list *)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Edit(.env*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Read(secrets/**)",
      "Read(config/credentials.json)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(terraform apply:*)",
      "Bash(kubectl apply:*)"
    ],
    "defaultMode": "auto",
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh issue:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api --method POST:*)",
      "Bash(gh api -XPOST:*)",
      "Bash(gh api --method=POST:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh api --method PATCH:*)",
      "Bash(gh api -XPATCH:*)",
      "Bash(gh api --method=PATCH:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(gh api -XPUT:*)",
      "Bash(gh api --method=PUT:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -XDELETE:*)",
      "Bash(gh api --method=DELETE:*)",
      "Bash(gh api -f:*)",
      "Bash(gh api -F:*)",
      "Bash(gh api --raw-field:*)",
      "Bash(gh api --field:*)",
      "Bash(gh api -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api --raw-field=*)",
      "Bash(gh api --field=*)",
      "Bash(git push *)",
      "Bash(gh *)"
    ]
  },
  "sandbox": {{ if eq .chezmoi.os "darwin" }}
{
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": false,
  "excludedCommands": [
    "git push *",
    "gh *"
  ],
  "filesystem": {
    "allowWrite": [
      "~/.cache/uv",
      "~/.local/state/hcom-regime",
      "~/.local/state/hcom",
      "~/.local/state/omp-seats",
      "~/Library/Caches/mise"
    ],
    "denyRead": [
      "~/**/.env",
      "~/**/.env.*",
      "/tmp/**/.env",
      "/tmp/**/.env.*",
      "/private/tmp/**/.env",
      "/private/tmp/**/.env.*"
    ]
  },
  "credentials": {
    "files": [
      {
        "path": "~/.ssh",
        "mode": "deny"
      },
      {
        "path": "~/.config/gh/hosts.yml",
        "mode": "deny"
      },
      {
        "path": "~/.claude/.credentials.json",
        "mode": "deny"
      },
      {
        "path": "~/.config/claude-code/oauth-token",
        "mode": "deny"
      },
      {
        "path": "~/.codex/auth.json",
        "mode": "deny"
      },
      {
        "path": "~/.omp/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.omp/profiles/*/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.config/age/key.txt",
        "mode": "deny"
      }
    ],
    "envVars": [
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "mode": "deny"
      }
    ]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "uploads.github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "allowMachLookup": [
      "com.apple.trustd.agent"
    ]
  }
}
{{ else }}
{
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": false,
  "excludedCommands": [
    "git push *",
    "gh *"
  ],
  "filesystem": {
    "allowWrite": [
      "~/.cache/uv",
      "~/.local/state/hcom-regime",
      "~/.local/state/hcom",
      "~/.local/state/omp-seats"
    ],
    "denyRead": [
      "~/**/.env",
      "~/**/.env.*",
      "/tmp/**/.env",
      "/tmp/**/.env.*"
    ]
  },
  "credentials": {
    "files": [
      {
        "path": "~/.ssh",
        "mode": "deny"
      },
      {
        "path": "~/.config/gh/hosts.yml",
        "mode": "deny"
      },
      {
        "path": "~/.claude/.credentials.json",
        "mode": "deny"
      },
      {
        "path": "~/.config/claude-code/oauth-token",
        "mode": "deny"
      },
      {
        "path": "~/.codex/auth.json",
        "mode": "deny"
      },
      {
        "path": "~/.omp/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.omp/profiles/*/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.config/age/key.txt",
        "mode": "deny"
      }
    ],
    "envVars": [
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "mode": "deny"
      }
    ]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "uploads.github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ]
  }
}
{{ end }},
  "env": {
    "GH_TELEMETRY": "false",
    "DO_NOT_TRACK": "1",
    "CHECKPOINT_DISABLE": "1",
    "AWS_EC2_METADATA_DISABLED": "true"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-uv.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/common/agent-session-staleness hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-edited-files.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-map-reload.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/common/permgate claude",
            "timeout": 10,
            "statusMessage": "Evaluating permission request"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "disableSkillShellExecution": true,
  "includeGitInstructions": true
}
