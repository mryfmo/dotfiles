  "sandbox": {{ if eq .chezmoi.os "darwin" }}
{
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": false,
  "excludedCommands": [
    "git push *",
    "gh *"
  ],
  "filesystem": {
    "allowWrite": [
      "~/.cache/uv",
      "~/.local/state/hcom-regime",
      "~/.local/state/hcom",
      "~/.local/state/omp-seats",
      "~/Library/Caches/mise"
    ],
    "denyRead": [
      "~/**/.env",
      "~/**/.env.*",
      "/tmp/**/.env",
      "/tmp/**/.env.*",
      "/private/tmp/**/.env",
      "/private/tmp/**/.env.*"
    ]
  },
  "credentials": {
    "files": [
      {
        "path": "~/.ssh",
        "mode": "deny"
      },
      {
        "path": "~/.config/gh/hosts.yml",
        "mode": "deny"
      },
      {
        "path": "~/.claude/.credentials.json",
        "mode": "deny"
      },
      {
        "path": "~/.config/claude-code/oauth-token",
        "mode": "deny"
      },
      {
        "path": "~/.codex/auth.json",
        "mode": "deny"
      },
      {
        "path": "~/.omp/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.omp/profiles/*/agent/agent.db*",
        "mode": "deny"
      },
      {
        "path": "~/.config/age/key.txt",
        "mode": "deny"
      }
    ],
    "envVars": [
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "mode": "deny"
      }
    ]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "uploads.github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "allowMachLookup": [
      "com.apple.trustd.agent"
    ]
  }
}
