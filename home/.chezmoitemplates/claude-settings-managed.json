{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1",
  "effortLevel": "xhigh",
  "advisorModel": "fable",
  "alwaysThinkingEnabled": true,
  "autoUpdates": false,
  "autoUpdatesChannel": "stable",
  "plansDirectory": "./.agents/worklog/claude",
  "permissions": {
    "allow": [
      "Bash(agmsg-dispatch:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(.env.*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Edit(.env*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Read(secrets/**)",
      "Read(config/credentials.json)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(terraform apply:*)",
      "Bash(kubectl apply:*)"
    ],
    "defaultMode": "auto",
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh issue:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api --method POST:*)",
      "Bash(gh api -XPOST:*)",
      "Bash(gh api --method=POST:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh api --method PATCH:*)",
      "Bash(gh api -XPATCH:*)",
      "Bash(gh api --method=PATCH:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(gh api -XPUT:*)",
      "Bash(gh api --method=PUT:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -XDELETE:*)",
      "Bash(gh api --method=DELETE:*)",
      "Bash(gh api -f:*)",
      "Bash(gh api -F:*)",
      "Bash(gh api --raw-field:*)",
      "Bash(gh api --field:*)",
      "Bash(gh api -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api --raw-field=*)",
      "Bash(gh api --field=*)"
    ]
  },
  "sandbox": {{ if eq .chezmoi.os "darwin" }}
{
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": true,
  "excludedCommands": [
    "agmsg-dispatch *",
    "herdr-agents *",
    "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/scripts/actas-claim.sh *"
  ],
  "filesystem": {
    "allowWrite": [
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/db",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/teams",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/run",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/ext-tools",
      "~/.cache/uv",
      "~/.local/state/mise",
      "~/.local/share/uv",
      "~/Library/Caches/mise"
    ]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "uploads.github.com",
      "objects.githubusercontent.com",
      "codeload.github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "allowMachLookup": [
      "com.apple.trustd.agent"
    ],
    "allowUnixSockets": [
      "~/.config/herdr/herdr.sock"
    ]
  }
}
{{ else }}
{
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": true,
  "excludedCommands": [
    "agmsg-dispatch *",
    "herdr-agents *",
    "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/scripts/actas-claim.sh *"
  ],
  "filesystem": {
    "allowWrite": [
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/db",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/teams",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/run",
      "{{ .chezmoi.homeDir }}/.agents/skills/agmsg/ext-tools",
      "~/.cache/uv",
      "~/.local/state/mise",
      "~/.local/share/uv"
    ]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "uploads.github.com",
      "objects.githubusercontent.com",
      "codeload.github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "allowUnixSockets": [
      "~/.config/herdr/herdr.sock"
    ]
  }
}
{{ end }},
  "env": {
    "GH_TELEMETRY": "false",
    "DO_NOT_TRACK": "1",
    "CHECKPOINT_DISABLE": "1",
    "AWS_EC2_METADATA_DISABLED": "true"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin HOME=\"$HOME\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" CLAUDE_ENV_FILE=\"${CLAUDE_ENV_FILE}\" \"$HOME/.claude/hooks/orchestrator-only.sh\" enforce-uv.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin HOME=\"$HOME\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" CLAUDE_ENV_FILE=\"${CLAUDE_ENV_FILE}\" \"$HOME/.claude/hooks/orchestrator-only.sh\" herdr-agent-state.sh \"${HERDR_PANE_ID}\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin HOME=\"$HOME\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" CLAUDE_ENV_FILE=\"${CLAUDE_ENV_FILE}\" \"$HOME/.claude/hooks/orchestrator-only.sh\" agent-session-staleness",
            "async": true,
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin HOME=\"$HOME\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" CLAUDE_ENV_FILE=\"${CLAUDE_ENV_FILE}\" \"$HOME/.claude/hooks/orchestrator-only.sh\" format-edited-files.py",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin HOME=\"$HOME\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" CLAUDE_ENV_FILE=\"${CLAUDE_ENV_FILE}\" \"$HOME/.claude/hooks/orchestrator-only.sh\" project-map-reload.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ output "/usr/bin/env" "-i" "PATH=/usr/bin:/bin" "/usr/bin/python3" "-I" "-c" "\nimport glob, json, os, shlex, sys\nfrom pathlib import Path\nhome = Path(sys.argv[2])\npolicy = json.loads(sys.argv[1].replace(\"{{ .chezmoi.homeDir }}\", json.dumps(str(home))[1:-1]))\ndef binary(pattern):\n    pattern = str(home) + pattern[1:] if pattern.startswith(\"~/\") else pattern\n    if not Path(pattern).is_absolute() or \":\" in pattern or \"shims\" in Path(pattern).parts:\n        raise SystemExit(\"invalid executable binding: \" + pattern)\n    matches = glob.glob(pattern)\n    if len(matches) != 1:\n        raise SystemExit(\"missing or ambiguous executable binding: \" + pattern)\n    path = Path(matches[0]).resolve(strict=True)\n    if not path.is_file() or not os.access(path, os.X_OK) or any(p.casefold() in (\"shims\", \".cache\", \".uv-cache\") for p in path.parts) or \"/.claude/worktrees/\" in str(path).casefold():\n        raise SystemExit(\"untrusted executable binding: \" + str(path))\n    return str(path)\npolicy[\"home\"] = str(home)\npolicy[\"tools\"] = {name: binary(pattern) for name, pattern in policy[\"tools\"].items()}\nif len(sys.argv) > 3:\n    command = policy[\"prefix\"].replace('HOME=\"$HOME\"', 'HOME=' + shlex.quote(str(home)))\n    command += shlex.join([policy[\"tools\"][\"uv\"], \"run\", \"--no-config\", \"--no-project\", \"--offline\", \"--python\", policy[\"tools\"][\"python3\"], \"python\", \"-I\", str(home / \".local/bin/common/permgate\"), \"claude\"])\n    print(json.dumps(command)[1:-1], end=\"\")\nelse:\n    print(\"python=\" + shlex.quote(binary(policy.pop(\"bootstrap\"))))\n    print(\"policy=\" + shlex.quote(json.dumps(policy)))\n" "{\"prefix\": \"/usr/bin/env -i PATH=/usr/bin:/bin HOME=\\\"$HOME\\\" LANG=C.UTF-8 TERM=dumb CLAUDE_PROJECT_DIR=\\\"${CLAUDE_PROJECT_DIR}\\\" CLAUDE_ENV_FILE=\\\"${CLAUDE_ENV_FILE}\\\" \", \"tools\": {\"uv\": \"~/.local/share/mise/installs/uv/latest/*/uv\", \"python3\": \"~/.local/share/mise/installs/python/latest/bin/python3\"}}" .chezmoi.homeDir "permission" }}",
            "timeout": 10,
            "statusMessage": "Evaluating permission request",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "disableSkillShellExecution": true,
  "includeGitInstructions": true
}
