+}
+
+// omp's legacy pi-ai shim does not export contentText; this is pi-ai 1.4.0's dist/utils/text.js:2-9 (MIT), same output.
+function contentText(content: string | readonly { type: string; text?: string }[], separator = "\n"): string {
+	if (typeof content === "string") return content;
+	return content
+		.filter((block) => block.type === "text")
+		.map((block) => block.text ?? "")
+		.join(separator);
 }
