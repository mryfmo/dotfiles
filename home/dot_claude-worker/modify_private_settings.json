#!/usr/bin/env python3
"""Replace worker policy with its dedicated baseline, preserving unrelated state."""

import json
import os
from pathlib import Path
import platform
import re
import shlex
import subprocess
import sys


def render_native_bindings(text, source, home, os_name):
    token = r'"(?:\\.|[^"\\])*"|\.chezmoi\.(?:homeDir|sourceDir|os)'
    values = {".chezmoi.homeDir": str(home), ".chezmoi.sourceDir": str(source), ".chezmoi.os": os_name}

    def expand(match):
        words = [values[word] if word in values else json.loads(word) for word in re.findall(token, match[1])]
        if words[:6] != ["/usr/bin/env", "-i", "PATH=/usr/bin:/bin", "/usr/bin/python3", "-I", "-c"]:
            raise ValueError("untrusted native binding command")
        return subprocess.check_output(words, text=True, cwd=source)

    return re.sub(r"{{ output ((?:(?:" + token + r")\s*)+)}}", expand, text)


def is_managed_permission_hook(hook):
    if not isinstance(hook, dict) or not isinstance(hook.get("command"), str):
        return False
    try:
        parts = shlex.split(hook["command"])
    except ValueError:
        return False
    if len(parts) == 2:
        return Path(parts[0]).name in ("permgate", "ccgate") and parts[1] == "claude"
    home = Path(os.environ.get("CHEZMOI_HOME_DIR", str(Path.home())))
    prefix = [
        "/usr/bin/env",
        "-i",
        "PATH=/usr/bin:/bin",
        "HOME=" + str(home),
        "LANG=C.UTF-8",
        "TERM=dumb",
        "CLAUDE_PROJECT_DIR=${CLAUDE_PROJECT_DIR}",
        "CLAUDE_ENV_FILE=${CLAUDE_ENV_FILE}",
    ]
    return (
        len(parts) == 19
        and parts[:8] == prefix
        and Path(parts[8]).is_absolute()
        and Path(parts[8]).name == "uv"
        and parts[9:14] == ["run", "--no-config", "--no-project", "--offline", "--python"]
        and Path(parts[14]).is_absolute()
        and parts[15:] == ["python", "-I", str(home / ".local/bin/common/permgate"), "claude"]
    )


source = Path(os.environ.get("CHEZMOI_SOURCE_DIR", Path(__file__).resolve().parents[1]))
home = os.environ.get("CHEZMOI_HOME_DIR", str(Path.home()))
if sys.argv[1:2] == ["--legacy"]:
    current = json.load(sys.stdin)
    scripts = Path(home) / ".agents/skills/agmsg/scripts"
    events = {
        "SessionStart": "session-start.sh",
        "SessionEnd": "session-end.sh",
        "Stop": "check-inbox.sh",
        "PostToolUse": "check-inbox.sh",
    }
    for event, groups in current.get("hooks", {}).items():
        retained = []
        for group_index, group in enumerate(groups):
            hooks = []
            for hook_index, hook in enumerate(group.get("hooks", [])):
                if hook.get("type") != "command" and "command" not in hook:
                    hooks.append(hook)
                    continue
                try:
                    words = shlex.split(hook.get("command", ""))
                except ValueError:
                    words = []
                if words[:1] in (["bash"], ["/bin/bash"]):
                    words = words[1:]
                expected = [str(scripts / events[event]), "claude-code", sys.argv[2]] if event in events else []
                if not expected or words not in (
                    expected,
                    expected + ["PostToolUse"] if event == "PostToolUse" else expected,
                ):
                    raise SystemExit(f"legacy command hook remains: {event}[{group_index}].hooks[{hook_index}]")
            if hooks:
                retained.append(group | {"hooks": hooks})
        current["hooks"][event] = retained
    sys.stdout.write(json.dumps(current, indent=2) + "\n")
    raise SystemExit(0)
text = render_native_bindings(
    (source / ".chezmoitemplates/claude-worker-settings.json").read_text(),
    source,
    home,
    "darwin" if platform.system() == "Darwin" else "linux",
)
text = re.sub(
    r'{{ if eq \.chezmoi\.os "darwin" }}(.*?){{ else }}(.*?){{ end }}',
    lambda m: m[1] if platform.system() == "Darwin" else m[2],
    text,
    flags=re.S,
)
managed = json.loads(text.replace("{{ .chezmoi.homeDir }}", home))
current_text = sys.stdin.read()
try:
    current = json.loads(current_text)
except json.JSONDecodeError:
    current = {}
current = current if isinstance(current, dict) else {}
merged = current | managed
sys.stdout.write(current_text if merged == current else json.dumps(merged, indent=2) + "\n")
