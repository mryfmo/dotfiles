#!/usr/bin/env python3
"""Merge managed Claude settings with Claude-owned runtime state.

Whitespace-only, missing, or invalid JSON input falls back to the rendered
managed baseline so `chezmoi apply` does not fail on a malformed runtime file.
"""

from __future__ import annotations

import json
import os
import platform
import re
import shlex
import sys
from pathlib import Path
from typing import Any

RUNTIME_KEYS = ("enabledPlugins",)
MANAGED_PERMISSION_EXECUTABLES = ("ccgate", "permgate")
# SessionStart entries are merged additively, so a managed command whose shape
# changes would leave its previous variant behind and fire the hook twice. Any
# entry invoking this script is managed, whatever home path it was rendered with.
# herdr-agents no longer has a managed hook (its --attach mode left with the
# old regime's tooling, regime-cutover U26); the name stays so an installed
# entry is still managed and leaves on the next merge. agent-session-staleness
# changed from async to synchronous (regime-cutover U69); without it here the
# installed async variant stayed next to the new entry and the hook ran twice.
MANAGED_SESSION_START_SCRIPTS = ("herdr-agent-state.sh", "herdr-agents", "agent-session-staleness")
# A SessionStart hook is managed when it runs one of those scripts, directly or as
# `<interpreter> <script>` (the herdr entry is `bash '<home>/.claude/hooks/herdr-agent-state.sh' session`).
SCRIPT_INTERPRETERS = ("bash", "sh", "zsh")
ENV_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=.*", re.DOTALL)
MANAGED_POST_TOOL_USE_SCRIPTS = ("format-edited-files.py", "project-map-reload.sh")
# Without a predicate a mixed entry (enforce-uv.sh next to an unmanaged hook)
# differs from the managed entry, so the additive merge appended it again.
# gh-merge-gate.sh is a retired hook the template never renders (regime-cutover
# U76, F033): it is managed here only so the merge drops it from an installed
# settings.json. It returned `allow` for gated merges, which an ask rule
# overrides (`Bash(gh *)` asks for every gh call), so dropping it changes no
# decision.
MANAGED_PRE_TOOL_USE_SCRIPTS = ("enforce-uv.sh", "gh-merge-gate.sh")
# Keys the managed template used to set and no longer does (regime-cutover U18,
# D-024-150): a current value still equal to the former managed default came from
# the template, so the merge drops it; a different value is an operator override
# and stays, like every other key the template does not manage.
# U79 retired `alwaysThinkingEnabled: true`, Claude Code's own default ("`true` changes nothing",
# code.claude.com/docs/en/settings-reference).
RETIRED_MANAGED_DEFAULTS: dict[str, Any] = {
    "autoUpdates": False,
    "autoUpdatesChannel": "stable",
    "alwaysThinkingEnabled": True,
}


def is_retired_managed_default(key: str, value: Any) -> bool:
    if key not in RETIRED_MANAGED_DEFAULTS:
        return False
    default = RETIRED_MANAGED_DEFAULTS[key]
    return type(value) is type(default) and value == default


def retired_managed_env() -> dict[str, str]:
    """The `env` entries the template set before regime-cutover U33, with the values it rendered.

    U16 put the dotfiles bus into every Claude session (`HCOM_DIR=<home>/.local/state/hcom-regime`,
    `HCOM_TEAM=regime`); U33 derives the store and team per repository instead. An installed value still equal to
    the old one came from the template and is dropped; a different value is an operator override and stays.
    """
    return {"HCOM_DIR": f"{home_dir()}/.local/state/hcom-regime", "HCOM_TEAM": "regime"}


def merge_env(managed: dict[str, Any], current: dict[str, Any]) -> dict[str, Any]:
    retired = retired_managed_env()
    kept = {
        name: value
        for name, value in current.items()
        if name in managed or name not in retired or value != retired[name]  # lint-comparisons: allow an env value, not a path identity
    }
    return kept | managed


def managed_hook_paths(names: tuple[str, ...]) -> set[str]:
    return {
        path
        for name in names
        for path in (f"~/.claude/hooks/{name}", str(home_dir() / ".claude" / "hooks" / name))
    }


def source_dir() -> Path:
    if os.environ.get("CHEZMOI_SOURCE_DIR"):
        return Path(os.environ["CHEZMOI_SOURCE_DIR"])
    return Path(__file__).resolve().parents[1]


def home_dir() -> Path:
    if os.environ.get("CHEZMOI_HOME_DIR"):
        return Path(os.environ["CHEZMOI_HOME_DIR"])
    return Path.home()


def render_managed_template(text: str) -> str:
    text = re.sub(
        r'\{\{ if eq \.chezmoi\.os "darwin" \}\}(.*?)\{\{ else \}\}(.*?)\{\{ end \}\}',
        lambda match: match[1] if platform.system() == "Darwin" else match[2],
        text,
        flags=re.DOTALL,
    )
    return text.replace("{{ .chezmoi.sourceDir }}", str(source_dir())).replace("{{ .chezmoi.homeDir }}", str(home_dir()))


def load_json_object(text: str) -> dict[str, Any] | None:
    if not text.strip():
        return None
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None
    return data if isinstance(data, dict) else None


def is_managed_permission_hook(hook: Any) -> bool:
    if not isinstance(hook, dict) or not isinstance(hook.get("command"), str):
        return False
    try:
        parts = shlex.split(hook["command"])
    except ValueError:
        return False
    return (
        len(parts) == 2
        and Path(parts[0]).name in MANAGED_PERMISSION_EXECUTABLES
        and parts[1] == "claude"
    )


def invoked_script(command: str) -> str | None:
    """Basename of the program a hook command runs: its first word after NAME=value
    assignments, or the script an interpreter in SCRIPT_INTERPRETERS is given. An
    argument that merely names a managed script (`logger -t <name>`) is not it."""
    try:
        parts = shlex.split(command)
    except ValueError:
        return None
    while parts and ENV_ASSIGNMENT.fullmatch(parts[0]):
        parts = parts[1:]
    if len(parts) > 1 and Path(parts[0]).name in SCRIPT_INTERPRETERS:
        parts = parts[1:]
    return Path(parts[0]).name if parts else None


def is_managed_session_start_hook(hook: Any) -> bool:
    if not isinstance(hook, dict) or not isinstance(hook.get("command"), str):
        return False
    return invoked_script(hook["command"]) in MANAGED_SESSION_START_SCRIPTS


def is_managed_script_hook(hook: Any, names: tuple[str, ...]) -> bool:
    if not isinstance(hook, dict) or not isinstance(hook.get("command"), str):
        return False
    # The whole command, not shlex's words: a quoted or escaped ~ is a literal directory, not the home path.
    return hook["command"].strip() in managed_hook_paths(names)


def is_managed_post_tool_use_hook(hook: Any) -> bool:
    return is_managed_script_hook(hook, MANAGED_POST_TOOL_USE_SCRIPTS)


def is_managed_pre_tool_use_hook(hook: Any) -> bool:
    return is_managed_script_hook(hook, MANAGED_PRE_TOOL_USE_SCRIPTS)


def entry_has_managed_hook(entry: Any, is_managed: Any) -> bool:
    if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
        return False
    return any(is_managed(hook) for hook in entry["hooks"])


def merge_managed_entries(current_hooks: Any, managed_entries: list[Any], is_managed: Any) -> list[Any]:
    """Replace managed entries in place so their position in the list is kept.

    A fully managed entry is swapped for its managed counterpart, which is what
    lets a stale command (for example one rendered with a different home
    directory) be dropped without reordering the surrounding hooks. A mixed
    entry keeps its unmanaged hooks where they are, and the managed hook is
    re-appended with the rest of the managed entries.
    """
    queue = [entry for entry in managed_entries if entry_has_managed_hook(entry, is_managed)]
    merged: list[Any] = []
    index = 0
    for entry in current_hooks:
        if not entry_has_managed_hook(entry, is_managed):
            merged.append(entry)
            continue
        unmanaged = [hook for hook in entry["hooks"] if not is_managed(hook)]
        if unmanaged:
            merged.append({**entry, "hooks": unmanaged})
            continue
        if index < len(queue):
            merged.append(queue[index])
            index += 1
    return merged + [entry for entry in managed_entries if entry not in merged]


MANAGED_HOOK_PREDICATES = {
    "PermissionRequest": is_managed_permission_hook,
    "SessionStart": is_managed_session_start_hook,
    "PostToolUse": is_managed_post_tool_use_hook,
    "PreToolUse": is_managed_pre_tool_use_hook,
}


def merge_hooks(
    managed: dict[str, Any], current: dict[str, Any]
) -> dict[str, Any]:
    merged: dict[str, Any] = {}
    for key, value in current.items():
        managed_value = managed.get(key)
        if key in MANAGED_HOOK_PREDICATES and isinstance(managed_value, list):
            current_hooks = value if isinstance(value, list) else []
            merged[key] = merge_managed_entries(
                current_hooks, managed_value, MANAGED_HOOK_PREDICATES[key]
            )
        elif isinstance(value, list) and isinstance(managed_value, list):
            # ponytail: hook arrays are tiny; index entries only if they grow materially.
            merged[key] = value + [entry for entry in managed_value if entry not in value]
        elif key in managed:
            merged[key] = managed_value
        else:
            merged[key] = value

    for key, value in managed.items():
        if key not in merged:
            merged[key] = value
    return merged


def merge_settings(managed: dict[str, Any], current: dict[str, Any] | None) -> dict[str, Any]:
    if current is None:
        return dict(managed)

    merged: dict[str, Any] = {}
    for key, value in current.items():
        if key in RUNTIME_KEYS:
            merged[key] = value
        elif key in managed:
            managed_value = managed[key]
            if (
                key == "hooks"
                and isinstance(value, dict)
                and isinstance(managed_value, dict)
            ):
                merged[key] = merge_hooks(managed_value, value)
            elif key == "env" and isinstance(value, dict) and isinstance(managed_value, dict):
                merged[key] = merge_env(managed_value, value)
            else:
                merged[key] = managed_value
        elif not is_retired_managed_default(key, value):
            merged[key] = value

    for key, value in managed.items():
        if key not in merged:
            merged[key] = value
    return merged


def dump_settings(settings: dict[str, Any]) -> str:
    return json.dumps(settings, indent=2) + "\n"


def main() -> int:
    baseline = source_dir() / ".chezmoitemplates/claude-settings-managed.json"
    managed = json.loads(render_managed_template(baseline.read_text()))
    current_text = sys.stdin.read()
    current = load_json_object(current_text)
    merged = merge_settings(managed, current)
    if current is not None and merged == current:
        sys.stdout.write(current_text)
    else:
        sys.stdout.write(dump_settings(merged))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
