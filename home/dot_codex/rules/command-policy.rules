    decision="forbidden",
    justification="Recursive force removal is never delegated; remove specific paths instead.",
    match=["rm -rf build", "rm -fr build", "rm -Rf build", "rm -vrf build", "/bin/rm -rf build", "/usr/bin/rm -fr build"],
    not_match=["rm build/file.txt", "rm -r build", "rm -f build", "rm -f report.txt", "rm -f /tmp/err.log other.txt", "terraform -chdir=infra plan -refresh=false"],
)

