[user]
	name = {{ get . "name" | default "Fumio Moriya" }}
	email = {{ .email | quote }}
{{- /* Signing is rendered only when the key exists at apply time: gpgsign with a missing key makes every commit fail. */}}
{{- $signing := stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub") }}
{{- if $signing }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
{{- end }}
[color]
	ui = auto
[url "git@github.com:"]
	pushinsteadof = https://github.com/
[pager]
	branch = cat
	config = cat
[ghq]
	root = ~/.local/share
	root = ~/ghq
{{- if $signing }}
[commit]
	gpgsign = true
[gpg]
	format = ssh
{{- end }}
[pull]
	rebase = true
[core]
	quotepath = false
[rebase]
	autoStash = true
[credential]
    helper = !gh auth git-credential
