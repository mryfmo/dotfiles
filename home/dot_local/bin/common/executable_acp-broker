probe=$(/usr/bin/env -i "${worker_env[@]}" "${srt_cmd[@]}" --settings "${settings}" -- /bin/sh -c 'if true 2> /dev/null > "$1"; then w=write-open; else w=write-denied; fi
if cat "$2" > /dev/null 2>&1; then r=read-open; else r=read-denied; fi
if ls "$3" > /dev/null 2>&1; then s=ssh-open; else s=ssh-denied; fi
if true 2> /dev/null > "$4"; then d=debug-open; else d=debug-denied; fi
echo "$w $r $s $d"' canary "${slot}/canary" "${settings}" "${HOME}/.ssh" "${debug_canary}" < /dev/null 4>&-) ||
    refuse "the sandbox canary did not run under ${srt_cmd[*]}; omp acp not started"
if [[ ${probe} == 'write-denied read-denied ssh-denied debug-open' || -e ${debug_canary} ]]; then
    if /bin/rm -f -- "${debug_canary}"; then :; fi
    refuse 'the sandbox does not hold (operator Claude debug writable); omp acp not started'
fi
if [[ ${probe} != 'write-denied read-denied ssh-denied debug-denied' || -e ${slot}/canary ]]; then
    refuse "the sandbox does not hold (canary: ${probe}); omp acp not started"
fi
log_line "canary ${probe}"
# omp's version under the same settings, by the checked argv, status first: a failed or shapeless read refuses.
version=$(/usr/bin/env -i "${worker_env[@]}" "${srt_cmd[@]}" --settings "${settings}" -- /usr/bin/env PATH="${seat_path}" "${omp_cmd[@]}" --version < /dev/null 4>&-) ||
    refuse "cannot read the omp version (${omp_cmd[*]} --version failed under ${srt_cmd[*]}); omp acp not started"
version=${version%%$'\n'*}
version=${version%% *}
