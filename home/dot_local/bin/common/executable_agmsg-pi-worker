#!/usr/bin/env bash

# @file agmsg-pi-worker
# @brief Bridge agmsg task delivery to one persistent Pi RPC worker.
# @description
#   Registers an explicit Pi identity, enforces a scratch-root cwd, and sends
#   raw AGMSG-TASK bodies to Pi as correlated prompt requests. Pi itself owns
#   AGMSG-RESULT delivery through the constrained agmsg_send tool.
# @option --team <team> agmsg team name.
# @option --identity <pi-name> Pi worker identity.
# @option --project <path> Existing scratch or worktree project directory.
# @option --provider <provider> Optional Pi provider identifier.
# @option --model <model> Optional Pi model identifier.
# @option --scratch-root <path> Required ancestor of the project directory.

set -uo pipefail

readonly FIXED_INSTRUCTION="Execute per the task file; send your AGMSG-RESULT using the agmsg_send tool; your final assistant text is not the RESULT."

TEAM=""
IDENTITY=""
PROJECT_INPUT=""
PROVIDER=""
MODEL=""
SCRATCH_INPUT=""

# @description Print command usage.
function usage() {
    cat >&2 << 'EOF'
Usage: agmsg-pi-worker --team <team> --identity <pi-name> --project <path>
       [--provider <provider> --model <model>] --scratch-root <path>
EOF
}

# @description Print one bridge lifecycle event.
# @arg $1 string Lifecycle detail without message content beyond an approved prefix.
function log_event() {
    printf 'agmsg-pi-worker: %s\n' "$1" >&2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
    --team | --identity | --project | --provider | --model | --scratch-root)
        [ "$#" -ge 2 ] || {
            usage
            exit 2
        }
        case "$1" in
        --team) TEAM="$2" ;;
        --identity) IDENTITY="$2" ;;
        --project) PROJECT_INPUT="$2" ;;
        --provider) PROVIDER="$2" ;;
        --model) MODEL="$2" ;;
        --scratch-root) SCRATCH_INPUT="$2" ;;
        esac
        shift 2
        ;;
    *)
        usage
        exit 2
        ;;
    esac
done

if [ -z "$TEAM" ] || [ -z "$IDENTITY" ] || [ -z "$PROJECT_INPUT" ] || [ -z "$SCRATCH_INPUT" ]; then
    usage
    exit 2
fi
case "$TEAM" in '' | *[!A-Za-z0-9._-]*)
    log_event "invalid team"
    exit 2
    ;;
esac
case "$IDENTITY" in pi-*) ;; *)
    log_event "identity must start with pi-"
    exit 2
    ;;
esac
case "$IDENTITY" in *[!A-Za-z0-9._-]*)
    log_event "invalid identity"
    exit 2
    ;;
esac

PROJECT="$(cd -- "$PROJECT_INPUT" 2> /dev/null && pwd -P)" || {
    log_event "project directory is unavailable"
    exit 2
}
SCRATCH_ROOT="$(cd -- "$SCRATCH_INPUT" 2> /dev/null && pwd -P)" || {
    log_event "scratch root is unavailable"
    exit 2
}
if [ "$SCRATCH_ROOT" = "/" ]; then
    log_event "scratch root must not be filesystem root"
    exit 2
fi
case "$PROJECT" in
"$SCRATCH_ROOT" | "$SCRATCH_ROOT"/*) ;;
*)
    log_event "project is outside scratch root"
    exit 2
    ;;
esac

readonly AGMSG_SCRIPTS="${HOME}/.agents/skills/agmsg/scripts"
readonly IDENTITIES_SCRIPT="${AGMSG_SCRIPTS}/identities.sh"
readonly JOIN_SCRIPT="${AGMSG_SCRIPTS}/join.sh"
readonly CHECK_INBOX_SCRIPT="${AGMSG_SCRIPTS}/check-inbox.sh"
readonly SEND_SCRIPT="${AGMSG_SCRIPTS}/send.sh"
readonly PERMGATE_EXTENSION="${HOME}/.pi/agent/extensions/permgate.ts"
readonly AGMSG_EXTENSION="${HOME}/.pi/agent/extensions/agmsg.ts"

for required_script in "$IDENTITIES_SCRIPT" "$JOIN_SCRIPT" "$CHECK_INBOX_SCRIPT" "$SEND_SCRIPT"; do
    if [ ! -x "$required_script" ]; then
        log_event "missing agmsg script ${required_script##*/}"
        exit 1
    fi
done
if [ ! -f "$PERMGATE_EXTENSION" ]; then
    log_event "missing permgate extension"
    exit 1
fi
if [ ! -f "$AGMSG_EXTENSION" ]; then
    log_event "missing agmsg extension"
    exit 1
fi
PI_BIN="$(command -v pi 2> /dev/null)" || {
    log_event "pi is not installed"
    exit 1
}

PAIRS="$($IDENTITIES_SCRIPT "$PROJECT" pi)" || {
    log_event "identity lookup failed"
    exit 1
}
if ! printf '%s\n' "$PAIRS" | awk -F '\t' -v team="$TEAM" -v identity="$IDENTITY" '
    $1 == team && $2 == identity { found = 1 }
    END { exit !found }
'; then
    if ! "$JOIN_SCRIPT" "$TEAM" "$IDENTITY" pi "$PROJECT" > /dev/null; then
        log_event "identity join failed"
        exit 1
    fi
    PAIRS="$($IDENTITIES_SCRIPT "$PROJECT" pi)" || exit 1
    if ! printf '%s\n' "$PAIRS" | awk -F '\t' -v team="$TEAM" -v identity="$IDENTITY" '
        $1 == team && $2 == identity { found = 1 }
        END { exit !found }
    '; then
        log_event "identity verification failed after join"
        exit 1
    fi
    log_event "identity-joined team=$TEAM identity=$IDENTITY"
else
    log_event "identity-present team=$TEAM identity=$IDENTITY"
fi

WORK_DIR="$(mktemp -d)" || exit 1
RPC_INPUT="${WORK_DIR}/rpc-input"
RPC_OUTPUT="${WORK_DIR}/rpc-output"
RPC_ERROR="${WORK_DIR}/rpc.stderr"
INBOX_JSON="${WORK_DIR}/inbox.json"
INBOX_RECORDS="${WORK_DIR}/inbox.records"
EVENT_JSON="${WORK_DIR}/event.json"
mkfifo "$RPC_INPUT" "$RPC_OUTPUT"

PI_PID=""

# @description Stop the child and remove bridge-private runtime files.
function cleanup() {
    exec 3>&- 2> /dev/null || true
    exec 4<&- 2> /dev/null || true
    if [ -n "$PI_PID" ] && kill -0 "$PI_PID" 2> /dev/null; then
        kill "$PI_PID" 2> /dev/null || true
        wait "$PI_PID" 2> /dev/null || true
    fi
    rm -rf -- "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

PI_ARGS=(--mode rpc)
if [ -n "$PROVIDER" ]; then
    PI_ARGS+=(--provider "$PROVIDER")
fi
if [ -n "$MODEL" ]; then
    PI_ARGS+=(--model "$MODEL")
fi
PI_ARGS+=(--extension "$PERMGATE_EXTENSION")
PI_ARGS+=(--extension "$AGMSG_EXTENSION")

(
    cd -- "$PROJECT" || exit 1
    export AGMSG_PI_IDENTITY="$IDENTITY"
    exec "$PI_BIN" "${PI_ARGS[@]}" < "$RPC_INPUT" > "$RPC_OUTPUT" 2> "$RPC_ERROR"
) &
PI_PID=$!
exec 3> "$RPC_INPUT"
exec 4< "$RPC_OUTPUT"
log_event "rpc-start pid=$PI_PID cwd=$PROJECT"

TASK_FROM=()
TASK_BODY=()
TASK_ID=()
TURN_SEQUENCE=0
ACTIVE_CORR=""
ACTIVE_FROM=""
ACTIVE_TASK_ID=""
ACTIVE_ACK=0
LAST_FROM=""
LAST_TASK_ID="bridge"

# @description Extract a task identifier from a one-line agmsg contract body.
# @arg $1 string agmsg message body.
function extract_task_id() {
    printf '%s\n' "$1" | sed -n 's/.* task_id=\([^ ]*\).*/\1/p' | head -1
}

# @description Send a bridge-level PONG through the agmsg transport.
# @arg $1 string Recipient identity.
# @arg $2 string Task identifier.
# @arg $3 string PONG status.
# @arg $4 string PONG note.
function send_pong() {
    "$SEND_SCRIPT" "$TEAM" "$IDENTITY" "$1" \
        "AGMSG-PONG v1 task_id=$2 status=$3 note=$4" > /dev/null
}

# @description Parse check-inbox JSON into team-filtered sender/body records.
function parse_inbox() {
    python3 - "$INBOX_JSON" "$TEAM" << 'PY'
import json
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
if not text.strip():
    raise SystemExit(0)
payload = json.loads(text)
reason = payload.get("reason", "")
selected_team = sys.argv[2]
current_team = None
for line in reason.splitlines():
    header = re.fullmatch(r"\d+ new message\(s\) in (.+):", line)
    if header:
        current_team = header.group(1)
        continue
    message = re.fullmatch(r"  \[[^]]*\] ([^:]+): (.*)", line)
    if message and current_team == selected_team:
        print(f"{message.group(1)}\x1f{message.group(2)}")
PY
}

# @description Fetch unread boundary messages and queue tasks or answer PINGs.
# @arg $1 string Boundary name for lifecycle logging.
function fetch_messages() {
    local boundary="$1" from body task_id prefix
    log_event "inbox-check boundary=$boundary"
    if ! AGMSG_ACTIVE_NAME="$IDENTITY" \
        AGMSG_TEAM_FILTER="$TEAM" \
        AGMSG_CHECK_INBOX_FORCE=1 \
        "$CHECK_INBOX_SCRIPT" pi "$PROJECT" > "$INBOX_JSON"; then
        log_event "inbox-check failed"
        return 1
    fi
    if ! parse_inbox > "$INBOX_RECORDS"; then
        log_event "inbox response is invalid"
        return 1
    fi
    while IFS=$'\x1f' read -r from body; do
        [ -n "$from" ] || continue
        task_id="$(extract_task_id "$body")"
        [ -n "$task_id" ] || task_id="unknown"
        LAST_FROM="$from"
        LAST_TASK_ID="$task_id"
        prefix="${body//$'\n'/ }"
        prefix="${prefix:0:80}"
        case "$body" in
        "AGMSG-TASK v1 "*)
            TASK_FROM+=("$from")
            TASK_BODY+=("$body")
            TASK_ID+=("$task_id")
            log_event "bus-task from=$from prefix=$prefix"
            ;;
        "AGMSG-PING v1 "*)
            if ! send_pong "$from" "$task_id" alive bridge-alive; then
                log_event "bus-pong send-failed task_id=$task_id"
                return 1
            fi
            log_event "bus-pong status=alive task_id=$task_id"
            ;;
        *) log_event "bus-ignore from=$from prefix=$prefix" ;;
        esac
    done < "$INBOX_RECORDS"
}

# @description Send one exact correlated prompt request to the Pi child.
# @arg $1 string Correlation identifier.
# @arg $2 string Prompt body.
function write_prompt() {
    printf '%s' "$2" | python3 -c '
import json
import sys
print(json.dumps({"id": sys.argv[1], "type": "prompt", "message": sys.stdin.read()}))
' "$1" >&3
}

# @description Dispatch the oldest queued task when no Pi turn is active.
function dispatch_next() {
    [ -z "$ACTIVE_CORR" ] || return 0
    [ "${#TASK_BODY[@]}" -gt 0 ] || return 0

    ACTIVE_FROM="${TASK_FROM[0]}"
    local raw_body="${TASK_BODY[0]}"
    ACTIVE_TASK_ID="${TASK_ID[0]}"
    unset 'TASK_FROM[0]' 'TASK_BODY[0]' 'TASK_ID[0]'
    if [ "${#TASK_BODY[@]}" -gt 0 ]; then
        TASK_FROM=("${TASK_FROM[@]}")
        TASK_BODY=("${TASK_BODY[@]}")
        TASK_ID=("${TASK_ID[@]}")
    else
        TASK_FROM=()
        TASK_BODY=()
        TASK_ID=()
    fi

    TURN_SEQUENCE=$((TURN_SEQUENCE + 1))
    ACTIVE_CORR="t68-${TURN_SEQUENCE}"
    ACTIVE_ACK=0
    if ! write_prompt "$ACTIVE_CORR" "${raw_body}"$'\n'"${FIXED_INSTRUCTION}"; then
        return 1
    fi
    log_event "prompt-sent corr=$ACTIVE_CORR task_id=$ACTIVE_TASK_ID"
}

# @description Notify the last bus peer that the RPC child died.
function report_child_died() {
    local target="${ACTIVE_FROM:-$LAST_FROM}"
    local task_id="${ACTIVE_TASK_ID:-$LAST_TASK_ID}"
    if [ -n "$target" ]; then
        send_pong "$target" "$task_id" blocked bridge-child-died || true
    fi
    log_event "bridge-child-died task_id=$task_id"
}

fetch_messages startup || exit 1
if ! dispatch_next; then
    report_child_died
    exit 1
fi

while true; do
    if ! IFS= read -r event_line <&4; then
        report_child_died
        exit 1
    fi
    printf '%s\n' "$event_line" > "$EVENT_JSON"
    if ! event_fields="$(
        python3 - "$EVENT_JSON" << 'PY'
import json
import sys

event = json.load(open(sys.argv[1], encoding="utf-8"))
success = event.get("success")
if success is True:
    success = "true"
elif success is False:
    success = "false"
else:
    success = ""
print(f"{event.get('type', 'unknown')}\x1f{event.get('id', '')}\x1f{success}")
PY
    )"; then
        log_event "rpc-event kind=invalid-json"
        continue
    fi
    IFS=$'\x1f' read -r event_kind event_id event_success <<< "$event_fields"
    log_event "rpc-event kind=$event_kind"
    case "$event_kind" in
    response)
        if [ -n "$ACTIVE_CORR" ] && [ "$event_id" = "$ACTIVE_CORR" ]; then
            log_event "rpc-response corr=$event_id success=${event_success:-unknown}"
            [ "$event_success" = "true" ] && ACTIVE_ACK=1
        fi
        ;;
    agent_end)
        if [ -n "$ACTIVE_CORR" ] && [ "$ACTIVE_ACK" -eq 1 ]; then
            log_event "turn-complete corr=$ACTIVE_CORR task_id=$ACTIVE_TASK_ID"
            ACTIVE_CORR=""
            ACTIVE_FROM=""
            ACTIVE_TASK_ID=""
            ACTIVE_ACK=0
            fetch_messages agent_end || exit 1
            if ! dispatch_next; then
                report_child_died
                exit 1
            fi
        fi
        ;;
    esac
done
