#!/usr/bin/env bash
# @file hcom-reply
# @brief Send one protocol line on a team thread as the seat hcom launched; the sender identity comes from the launch, never from the caller.
# @description
#   Plan 025 U6d (D-024-136). The audit seat reads pull-request content under a
#   restrictive policy (`home/dot_agents/omp/policies/audit.yml`) and its only
#   writable route is the bus reply. hcom authenticates neither `--name` nor
#   `--from` (a caller-chosen `--name worker-soma` was recorded with sender
#   `soma`, bus row 84, 2026-10-23) and the stop gate trusts a row's `from`
#   (`home/dot_agents/omp/hooks/stop-gate.ts:55-59`), so that policy denies
#   `hcom send` in every form and allows only `hcom-reply <team> -- <line>`.
#   The identity is `hcom list self name`, which hcom resolves from the launch
#   environment of a seat it started; from a plain shell it fails with
#   `Cannot use 'self' without identity` (hcom 0.7.30, measured 2026-10-23) and
#   this script refuses. The only word before `--` is the team, so no `--name`,
#   `--from` or `-b` ever comes from the caller; the words after `--` are joined
#   with spaces into one line, which reaches hcom as one argument after `--`
#   (`hcom send --help`: "Everything after -- is the message", "All flags must
#   come before --"). The send is `hcom send --thread <team> --name <self> --
#   <line>`, with no `--intent ack`, because hcom refuses `ack` without
#   `--reply-to` (`Intent 'ack' requires --reply-to <id>`, measured). hcom's
#   receipt stays on stdout and its exit status is passed through. The store is
#   `$HCOM_DIR` from the launch; an unset HCOM_DIR or an absent store is refused
#   before any hcom call, because hcom creates a store on first use and the
#   seats' launch owns that.
# @arg $1 string Team, the hcom thread (`^[a-z0-9][a-z0-9_-]{0,63}$`).
# @arg $2 string `--`; anything else here, a flag included, is refused.
# @arg $@ string Line words, joined with spaces into one message.
# @env HCOM_DIR The private hcom store directory (required, from the launch).
# @stdout hcom's own receipt.
# @exitcode 0 Sent.
# @exitcode 2 Refused before any send: HCOM_DIR unset or its store absent, a team outside the grammar, no `--` as the second word, an empty line, or no hcom identity.
# @exitcode * hcom's own status when the send fails (its error on stderr).
# @example
#   hcom-reply regime -- 'VERDICT v1 task_id=U11-audit verdict=correct head=3153f9ce6722b4356d1c2738bf5b9cb4dac9bd64'
set -euo pipefail

usage='usage: hcom-reply <team> -- <line words...>'
refuse() {
    printf 'hcom-reply: %s\n' "$1" >&2
    exit 2
}

[[ -n ${HCOM_DIR:-} ]] || refuse 'HCOM_DIR is unset; run from the seat hcom launched'
[[ -f ${HCOM_DIR}/hcom.db ]] || refuse "store absent: ${HCOM_DIR}/hcom.db"
(($# >= 2)) || refuse "${usage}"
team=$1
[[ ${team} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "team '${team}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"
[[ $2 == -- ]] || refuse "the second word must be --, got '$2'; no flag is accepted (${usage})"
shift 2
line=$*
[[ -n ${line} ]] || refuse "empty line (${usage})"
self=$(hcom list self name) || refuse 'no hcom identity here (hcom list self name failed); run from the seat hcom launched'
[[ ${self} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "hcom list self name printed '${self}', outside ^[a-z0-9][a-z0-9_-]{0,63}\$"
exec hcom send --thread "${team}" --name "${self}" -- "${line}"
