#!/usr/bin/env python3
"""Extract acceptance evidence from a Pi session JSONL file."""

from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path
from typing import Any


MAX_FILE_BYTES = 50 * 1024 * 1024
TOKEN_KEYS = ("input", "output", "cacheRead", "cacheWrite")
COST_KEYS = (*TOKEN_KEYS, "total")


class EvidenceError(Exception):
    """A clear command-line extraction failure."""


def read_session(path: Path) -> bytes:
    try:
        if path.stat().st_size > MAX_FILE_BYTES:
            raise EvidenceError("session file exceeds 50 MiB limit")
        with path.open("rb") as stream:
            content = stream.read(MAX_FILE_BYTES + 1)
    except EvidenceError:
        raise
    except OSError as error:
        raise EvidenceError(f"unable to read session file: {error}") from error
    if len(content) > MAX_FILE_BYTES:
        raise EvidenceError("session file exceeds 50 MiB limit")
    return content


def parse_entries(content: bytes) -> tuple[list[dict[str, Any]], int]:
    entries: list[dict[str, Any]] = []
    malformed = 0
    for line in content.splitlines():
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            malformed += 1
            continue
        if not isinstance(entry, dict):
            malformed += 1
            continue
        if entry.get("type") == "session":
            continue
        if (
            not isinstance(entry.get("type"), str)
            or not isinstance(entry.get("id"), str)
            or not entry["id"]
            or not (entry.get("parentId") is None or isinstance(entry.get("parentId"), str))
        ):
            malformed += 1
            continue
        entries.append(entry)
    return entries, malformed


def active_path(entries: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not entries:
        return []
    by_id = {entry["id"]: entry for entry in entries}
    path: list[dict[str, Any]] = []
    current: dict[str, Any] | None = entries[-1]
    visited: set[str] = set()
    while current and current["id"] not in visited:
        path.append(current)
        visited.add(current["id"])
        current = by_id.get(current.get("parentId"))
    path.reverse()
    return path


def number(value: object) -> int | float:
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


def string_list(value: object) -> list[str]:
    return [item for item in value if isinstance(item, str)] if isinstance(value, list) else []


def extract(path: Path) -> dict[str, Any]:
    entries, malformed = parse_entries(read_session(path))
    selected = active_path(entries)
    parent_ids = {
        entry["parentId"]
        for entry in entries
        if isinstance(entry.get("parentId"), str)
    }

    tokens = {key: 0 for key in TOKEN_KEYS}
    costs = {key: 0 for key in COST_KEYS}
    compactions: list[dict[str, Any]] = []
    model_changes: list[dict[str, str]] = []
    for entry in selected:
        if entry["type"] == "compaction":
            details = entry.get("details")
            details = details if isinstance(details, dict) else {}
            summary = entry.get("summary")
            compactions.append(
                {
                    "id": entry["id"],
                    "summary": summary[:120] if isinstance(summary, str) else "",
                    "tokensBefore": number(entry.get("tokensBefore")),
                    "readFiles": string_list(details.get("readFiles")),
                    "modifiedFiles": string_list(details.get("modifiedFiles")),
                }
            )
        elif entry["type"] == "model_change":
            model_changes.append(
                {
                    "id": entry["id"],
                    "provider": entry.get("provider") if isinstance(entry.get("provider"), str) else "",
                    "modelId": entry.get("modelId") if isinstance(entry.get("modelId"), str) else "",
                }
            )
        elif entry["type"] == "message":
            message = entry.get("message")
            if not isinstance(message, dict) or message.get("role") != "assistant":
                continue
            usage = message.get("usage")
            usage = usage if isinstance(usage, dict) else {}
            for key in TOKEN_KEYS:
                tokens[key] += number(usage.get(key))
            cost = usage.get("cost")
            cost = cost if isinstance(cost, dict) else {}
            for key in COST_KEYS:
                costs[key] += number(cost.get(key))

    return {
        "sessionFile": str(path),
        "activeLeafId": selected[-1]["id"] if selected else None,
        "malformedLines": malformed,
        "entryCounts": dict(sorted(Counter(entry["type"] for entry in selected).items())),
        "branch": {
            "totalEntries": len(entries),
            "activePathEntries": len(selected),
            "leafCount": len({entry["id"] for entry in entries if entry["id"] not in parent_ids}),
        },
        "compactions": compactions,
        "modelChanges": model_changes,
        "usage": {"tokens": tokens, "cost": costs},
    }


def print_human(evidence: dict[str, Any]) -> None:
    branch = evidence["branch"]
    print(f"Session: {evidence['sessionFile']}")
    print(f"Active leaf: {evidence['activeLeafId'] or '-'}")
    print(
        f"Entries: total={branch['totalEntries']} active={branch['activePathEntries']} "
        f"leaves={branch['leafCount']} malformed={evidence['malformedLines']}"
    )
    counts = evidence["entryCounts"]
    print("Types: " + (", ".join(f"{key}={value}" for key, value in counts.items()) or "-"))
    models = evidence["modelChanges"]
    print(
        "Models: "
        + (" -> ".join(f"{item['provider']}/{item['modelId']}" for item in models) or "-")
    )
    tokens = evidence["usage"]["tokens"]
    print("Usage tokens: " + " ".join(f"{key}={tokens[key]}" for key in TOKEN_KEYS))
    costs = evidence["usage"]["cost"]
    print("Usage cost: " + " ".join(f"{key}={costs[key]}" for key in COST_KEYS))
    print(f"Compactions: {len(evidence['compactions'])}")
    for compaction in evidence["compactions"]:
        print(
            f"- {compaction['id']}: tokensBefore={compaction['tokensBefore']} "
            f"readFiles={','.join(compaction['readFiles']) or '-'} "
            f"modifiedFiles={','.join(compaction['modifiedFiles']) or '-'} "
            f"summary={json.dumps(compaction['summary'], ensure_ascii=False)}"
        )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("session_file", type=Path)
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args(argv)
    try:
        evidence = extract(args.session_file)
    except EvidenceError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    if evidence["malformedLines"]:
        print(
            f"warning: skipped {evidence['malformedLines']} malformed line(s)",
            file=sys.stderr,
        )
    if args.as_json:
        print(json.dumps(evidence, ensure_ascii=False, sort_keys=True))
    else:
        print_human(evidence)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
