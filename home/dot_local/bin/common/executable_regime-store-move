#!/usr/bin/env bash
# @file regime-store-move
# @brief Copy a program's live store out of the main checkout into the derived store root, verify the copy, and print the operator's one step that empties the checkout's copy.
# @description
#   Regime-cutover U221, store move 5 of 5 (handoff/07-store-move-design.md; U215 gave regime-env the root, U216 and
#   U220 gave the levers the two-form rule, U219 the seats' grants). The live store of a program is written unmasked
#   inside the main checkout's working tree at `.orchestration/orchestrate/<program>/` while `main` holds its masked
#   copies, so the checkout is never clean after a records sync and nothing fast-forwards it (standing order 40,
#   struck: no procedure or lever writes the coordinator's live main checkout again; decisions 2026-11-05T23:34:51Z).
#   This lever is the mechanism that ends the class: run once per program by the coordinator or the operator, from a
#   terminal outside every seat, in the main checkout (a linked worktree is refused), it reads the checkout and writes
#   only under the derived root `${REGIME_STORE_ROOT}` the sourced `regime-env` derives from the physical HOME and the
#   checkout's slug. It copies every regular file of the live store, the listing U220's derived walk uses
#   (`find ! -type d` through `read_listing`, every entry a regular file below the store with no symlink component, no
#   control character, no `..`, no name beginning with `.`; `redact-words.txt` included this time, since the new root
#   is the live store), to `${REGIME_STORE_ROOT}/<program>`, made 0700 as regime-init makes the components (each held
#   a real directory of this user with mode 0700, read by `/usr/bin/stat`; a directory that already holds any entry
#   refuses), each file with `cp -p` and read back with `cmp`, and the count of files below the destination equal to
#   the listing's; then it prints the operator's step, the only write to the checkout's working tree and the last of
#   its class, as three complete commands (the checkout's own `checkout -- <prefix>`, `clean -fd -- <prefix>` and
#   `pull --ff-only`, run with git's `-C <checkout>`), to be run only after the last records sync from inside has
#   merged. The lever itself runs no git against the checkout but `rev-parse` and the scratch repository's reads.
#   Before anything is written it checks that a sync is not still due: origin's `main` is fetched into a scratch
#   repository (`git init --bare --template=` under `$TMPDIR`, every command through `git_isolated`, the https URL read
#   once from the checkout, the credential helper `!gh auth git-credential` only), its tree is listed at the published
#   prefix (`ls-tree -r -z`), each live file is copied into the scratch directory and masked there with main's
#   `scripts/validate-agent-assets.py --mask-secrets` (the checkout's files are never changed; the masker's output is
#   withheld), and the masked copy's `<mode> blob <oid>` must equal main's entry for every path, no live path may be
#   absent from main but `redact-words.txt`, and no path of main may be absent from the live store (a deletion the sync
#   would carry); otherwise `refused: a records sync is still due (<n> path(s) differ ...)`, the count and not the
#   paths (a path may hold a redact word). `--check` does every read and every comparison and writes nothing (the
#   scratch directory aside), then prints the step; the default run does the same, then the copy, the verification,
#   `copied <n> files to <dir>` and the step. A failed `cp`, `cmp` or walk after the copy began removes the partial
#   copy (the program directory this run made is removed; one that stood empty before is emptied) and names the step.
#   The scratch directory is removed on every exit. Nothing under the checkout changes, in either mode.
# @arg $1 string The program (`^[a-z0-9][a-z0-9_-]{0,63}$`), whose live store is `<toplevel>/.orchestration/orchestrate/<program>/`.
# @option --check Every read and every comparison, nothing written; the step printed.
# @stdout `check: <n> files would be copied to <dir>; nothing written` or `copied <n> files to <dir>`, then the step, three lines.
# @stderr `regime-store-move: live store <dir> (<n> files); derived store <dir>; origin/main <sha> at <prefix>/ equals the live store masked`, then refusals.
# @exitcode 0 The check passed, or the copy was made and verified.
# @exitcode 1 A step failed after the checks (the fetch, the masking, a copy, a read-back, the walk of the destination); the partial copy was removed.
# @exitcode 2 Refused before anything was written: usage, a linked worktree, no live store, a listed entry outside the derived walk's shape, a destination that is not an empty 0700 directory of this user or absent, a sync still due.
# @example
#   regime-store-move regime-cutover --check
#   regime-store-move regime-cutover
set -euo pipefail

# @description Refuse to run unless this file's sha256 equals its pin in the manifest beside it (regime-cutover U31):
#   `~/.agents/agent-config.yaml` for the installed copy under ~/.local/bin/common, which a sandboxed session cannot
#   write, else the checkout's home/dot_agents/agent-config.yaml. Every read is checked; a failure exits 2 naming the
#   file. The pin is the `claude.levers.sha256.<name>` line, which `scripts/generate-agent-configs.py` refreshes. The
#   HOME read and the hash read are each tested where they stand (an `if`, a `||` with the refusal), so no read
#   carries a producer-status allow comment (U221).
# @set LEVER_MANIFEST The manifest the pin came from.
# @set LEVER_DIR The physical directory of this file, where the sourced libraries sit.
lever_self_check() {
    local src dir self name pin digest home
    # The directory is split from the path in the shell, so no external producer (dirname) can fail unseen.
    src=${BASH_SOURCE[0]}
    case ${src} in
    */*) dir=${src%/*} ;;
    *) dir=. ;;
    esac
    [[ -n ${dir} ]] || dir=/
    dir=$(cd "${dir}" && pwd -P) || {
        echo "${src##*/}: refused: cannot resolve the script directory of ${src}" >&2
        exit 2
    }
    self=${dir}/${BASH_SOURCE[0]##*/}
    LEVER_DIR=${dir}
    name=${self##*/}
    # The checkout layout unless this file sits in the installed directory under the physical HOME; a HOME that cannot
    # be entered is the checkout layout too, decided here, not by an empty value read later.
    LEVER_MANIFEST=${dir}/../../home/dot_agents/agent-config.yaml
    if home=$(cd "${HOME}" 2> /dev/null && pwd -P); then
        if [[ ${dir} == "${home}/.local/bin/common" ]]; then # lint-comparisons: allow both sides are pwd -P forms
            LEVER_MANIFEST=${HOME}/.agents/agent-config.yaml
        fi
    fi
    [[ -r ${LEVER_MANIFEST} ]] || {
        echo "${name}: refused: manifest unreadable: ${LEVER_MANIFEST}" >&2
        exit 2
    }
    pin=$(sed -n -E "s/^      ${name//./\\.}: ([0-9a-f]{64})\$/\\1/p" "${LEVER_MANIFEST}") || {
        echo "${name}: refused: cannot read ${LEVER_MANIFEST}" >&2
        exit 2
    }
    [[ ${pin} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: no single sha256 pin for ${name} in ${LEVER_MANIFEST}" >&2
        exit 2
    }
    if command -v sha256sum > /dev/null; then
        digest=$(sha256sum < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    else
        digest=$(shasum -a 256 < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    fi
    digest=${digest%% *}
    [[ ${digest} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: cannot hash ${self}" >&2
        exit 2
    }
    [[ ${digest} == "${pin}" ]] || {
        echo "${name}: refused: sha256 ${digest} of ${self} differs from the pin in ${LEVER_MANIFEST}" >&2
        exit 2
    }
}
lever_self_check
# The isolated git and the environment scrub come from the library beside this script (U113). The scrub runs here,
# before the first git: GIT_CONFIG_* would add config, includes and URL rewrites to every git command, GIT_DIR would
# point every command at another repository, and a proxy or certificate variable would steer the fetch.
[[ -r ${LEVER_DIR}/git-isolated.sh ]] || {
    echo "regime-store-move: refused: git-isolated.sh unreadable beside this script: ${LEVER_DIR}/git-isolated.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/git-isolated.sh
. "${LEVER_DIR}/git-isolated.sh"
# shellcheck disable=SC2119 # no name is kept: every GIT_* and transport variable goes
git_env_scrub

[[ -r ${LEVER_DIR}/read-lib.sh ]] || {
    echo "regime-store-move: refused: read-lib.sh unreadable beside this script: ${LEVER_DIR}/read-lib.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/read-lib.sh
. "${LEVER_DIR}/read-lib.sh"

# The store root (U215, U216): the program stores lie under `REGIME_STORE_ROOT`, the root the sourced regime-env
# derives from the physical HOME and this checkout's slug and holds component by component; the helper is sourced
# from the directory this lever runs from and self-checked like a lever (U33), so a rewritten copy stops this lever.
# The call that derives the root comes after this lever's own checkout checks, below.
[[ -r ${LEVER_DIR}/regime-env ]] || {
    echo "regime-store-move: refused: regime-env unreadable beside this script: ${LEVER_DIR}/regime-env" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/regime-env
. "${LEVER_DIR}/regime-env"

lever=regime-store-move
usage='usage: regime-store-move <program> [--check]'

# @description Print the refusal on stderr and exit 2.
# @arg $@ string The reason.
refuse() {
    echo "${lever}: refused: $*" >&2
    exit 2
}

# @description Print the failure on stderr and exit 1 (the EXIT trap removes the partial copy and the scratch directory).
# @arg $@ string The reason.
fail() {
    echo "${lever}: $*" >&2
    exit 1
}

scratch='' dest='' dest_made=0 copy_state=''
# @description Remove this run's scratch directory, and, when the copy had begun and did not end verified, the partial
#   copy: the program directory this run made is removed; one that stood empty before the run is emptied and made again
#   0700, as it was. Runs from the EXIT trap, so a `fail` or `refuse` after the copy began leaves no partial store.
cleanup() {
    if [[ ${copy_state} == copying ]]; then
        rm -rf -- "${dest}" 2> /dev/null || echo "${lever}: could not remove the partial copy under ${dest}" >&2
        if [[ ${dest_made} == 0 ]]; then
            (umask 077 && mkdir "${dest}") 2> /dev/null || echo "${lever}: could not remake the empty program store ${dest}" >&2
        fi
        echo "${lever}: the partial copy under ${dest} was removed; nothing in the checkout changed" >&2
    fi
    if [[ -n ${scratch} && -d ${scratch} ]]; then
        rm -r "${scratch}" 2> /dev/null || echo "${lever}: could not remove ${scratch}" >&2
    fi
}

# @description Run the isolated git in the comparison's own repository (the shape of records-sync.sh, U101): the
#   repository named by `--git-dir`, so no checkout is consulted, and nothing of the user, system or checkout
#   configuration (git-isolated.sh, U113).
# @arg $@ string The `git` arguments.
git_scratch() {
    git_isolated --git-dir="${repo}" "$@"
}

# @description Print the operator's step: the three commands that empty the checkout's copy of the store and move the
#   checkout to origin/main, each complete, the paths quoted for the shell. The step is printed, never run: the live
#   checkout is written by the operator's hand alone, once (the struck order 40's successor rule).
print_step() {
    printf 'git -C %q checkout -- %q\n' "${top_real}" "${records}"
    printf 'git -C %q clean -fd -- %q\n' "${top_real}" "${records}"
    printf 'git -C %q pull --ff-only\n' "${top_real}"
}

case ${OSTYPE} in
darwin*) stat_mode=(-f %Lp) ;;
*) stat_mode=(-c %a) ;;
esac

# @description Hold one component of the destination (`regime-store`, the store root `<slug>`, the program directory)
#   as regime-init holds them (U215b, U215c): a symbolic link refuses by name; present, it must be a real directory of
#   this user whose mode is 0700, read by `/usr/bin/stat` with its status (a failed read refuses, standing order 21);
#   absent, nothing (store_dir_make makes it in the move). Nothing is written.
# @arg $1 path The directory.
# @arg $2 string What it is, for the refusal.
store_dir_hold() {
    local path=$1 what=$2 mode
    [[ ! -L ${path} ]] || refuse "${what} ${path} is a symlink"
    [[ -e ${path} ]] || return 0
    [[ -d ${path} && -O ${path} ]] || refuse "${what} ${path} is not a real directory of this user"
    mode=$(/usr/bin/stat "${stat_mode[@]}" "${path}") || refuse "cannot read the mode of ${what} ${path}"
    [[ ${mode} == 700 ]] || refuse "${what} ${path} has mode ${mode}, not 0700"
}

# @description Make one component of the destination when absent, by its own `mkdir` under `umask 077` (no `-p`, so
#   none is made through an entry planted above it; mkdir takes no existing entry, so a link planted between the hold
#   and the mkdir fails it instead of being followed), then hold it as store_dir_hold does.
# @arg $1 path The directory.
# @arg $2 string What it is, for the refusal.
# @set made 1 when this call made the directory, else 0.
store_dir_make() {
    local path=$1 what=$2
    made=0
    [[ ! -L ${path} ]] || refuse "${what} ${path} is a symlink"
    if [[ ! -e ${path} ]]; then
        (umask 077 && mkdir "${path}") || refuse "cannot create ${what} ${path}"
        made=1
    fi
    store_dir_hold "${path}" "${what}"
}

# @description Hold one entry of the live store's walk to the derived walk's shape (U220, U28b F2): below the store,
#   no control character (a newline would hide a component), no `..`, no component beginning with `.` (no record
#   carries such a name, and the derived form's walk refuses it, so the move does too), no symbolic link at any
#   component, a regular file whose directory resolves (`pwd -P`) inside the store; then append its store-relative
#   path to the file list. A refusal names the entry's store-relative path, never its text.
# @arg $1 path The entry as find prints it.
check_entry() {
    local entry=$1 rel prefix part rest source_dir
    case ${entry} in # lint-comparisons: allow a path as find prints it, refused unless below the live store
    "${live}"/?*) ;;
    *) refuse "the walk of ${live} names a path outside the store; nothing copied" ;;
    esac
    rel=${entry#"${live}/"}
    [[ ${rel} != *[[:cntrl:]]* ]] || refuse "a path of the live store holds a control character; nothing copied" # lint-comparisons: allow a character test on the raw path
    [[ ${rel} != *..* ]] || refuse "a path of the live store holds '..': ${rel}; nothing copied"                 # lint-comparisons: allow refuses a raw path that holds ..
    prefix=${live}
    rest=${rel}
    # Split on `/` by parameter expansion (no here-string, so no temporary file can go missing, U101).
    while [[ -n ${rest} ]]; do
        part=${rest%%/*}
        if [[ ${rest} == */* ]]; then # lint-comparisons: allow splits the path into its components
            rest=${rest#*/}
        else
            rest=''
        fi
        [[ ${part} != .* ]] || # lint-comparisons: allow a name test on one component of the walk
            refuse "a name of the live store begins with '.', which no record carries and the derived walk refuses (U220): ${rel}; remove it by hand, nothing copied"
        prefix=${prefix}/${part}
        [[ ! -L ${prefix} ]] || refuse "a component of a path of the live store is a symlink: ${prefix}; nothing copied"
    done
    [[ -f ${prefix} ]] || refuse "a path of the live store is not a regular file: ${rel}; nothing copied"
    source_dir=$(cd "${prefix%/*}" && pwd -P) || refuse "cannot resolve the directory of ${rel}"
    [[ ${source_dir} == "${live}" || ${source_dir} == "${live}"/* ]] || # lint-comparisons: allow both sides are pwd -P forms
        refuse "a path of the live store resolves outside ${live}: ${rel}; nothing copied"
    printf '%s\0' "${rel}" >> "${scratch}/rels" || fail 'cannot write the file list'
}

program='' check=0
for arg in "$@"; do
    case ${arg} in
    --check) check=1 ;;
    -*) refuse "${usage}" ;;
    *)
        [[ -z ${program} ]] || refuse "${usage}"
        program=${arg}
        ;;
    esac
done
[[ -n ${program} ]] || refuse "${usage}"
[[ ${program} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "program '${program}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"

toplevel=$(git_isolated rev-parse --show-toplevel 2> /dev/null) || refuse 'not in a git checkout'
git_dir=$(git_isolated rev-parse --path-format=absolute --git-dir) || refuse 'cannot read the git directory'
common_dir=$(git_isolated rev-parse --path-format=absolute --git-common-dir) || refuse 'cannot read the git common directory'
git_dir=$(cd "${git_dir}" && pwd -P) || refuse "cannot resolve ${git_dir}"
common_dir=$(cd "${common_dir}" && pwd -P) || refuse "cannot resolve ${common_dir}"
[[ ${git_dir} == "${common_dir}" ]] || # lint-comparisons: allow both sides are pwd -P forms
    refuse "${toplevel} is a linked worktree; run from the main checkout, where the live store lies"
cd "${toplevel}" || refuse "cannot enter ${toplevel}"
# The toplevel is physical, so every path below is measured against the real checkout (U28b F2).
top_real=$(pwd -P) || refuse "cannot resolve ${toplevel}"
# regime-env derives `REGIME_STORE_ROOT` for this checkout (its own refusals name this lever). This lever reads nothing
# in the hcom store, so the store's `origin` binding is not asked of it (`--unbound-ok`, as pr-merge.sh and
# records-sync.sh ask: the dotfiles program runs on the pre-U33 store pair and its derived hcom store carries no
# `origin`); the collision refusal and every store-root hold stay. The helper's return 1 is this lever's exit 2.
regime_env regime-store-move --unbound-ok || exit 2
[[ -n ${REGIME_STORE_ROOT:-} ]] || refuse "regime-env derived no store root for ${top_real}; the derived store is made under it (U215, U216)"

# The live store: the checkout's own `.orchestration/orchestrate/<program>`, the pre-move form, each of its three
# components a directory of this user and no symlink (the pr-merge.sh hold of U216).
records=.orchestration/orchestrate/${program}
live=${top_real}/${records}
path=${top_real}
for part in .orchestration orchestrate "${program}"; do
    path=${path}/${part}
    [[ -d ${path} && ! -L ${path} && -O ${path} ]] ||
        refuse "${path} is not a directory of this user (a symlink or a missing store); the live store this lever moves is the checkout's ${records}/"
done
# The destination and its components, outermost first: `regime-store`, the store root `<slug>`, the program store.
store_root=${REGIME_STORE_ROOT}
store_parent=${store_root%/*}
state_dir=${store_parent%/*}
dest=${store_root}/${program}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/regime-store-move.XXXXXX") || fail 'mktemp failed'
trap cleanup EXIT

# The destination before anything is read from the store: every component held (nothing written), and the program
# directory, when present, empty: any entry below it, a dot file included, refuses by name.
store_dir_hold "${store_parent}" 'the store parent'
store_dir_hold "${store_root}" 'the store root'
store_dir_hold "${dest}" 'the program store'
if [[ -d ${dest} ]]; then
    status=0
    read_listing "${scratch}/dest-entries" "${scratch}/dest-entries.err" find "${dest}" -mindepth 1 -print0 || status=$?
    case ${status} in
    1) ;;
    0) refuse "${dest} already holds entries; the derived program store must be empty before the move (nothing copied)" ;;
    *) refuse "cannot list ${dest} (its output is withheld); nothing copied" ;;
    esac
fi

# The live store's walk (U220's derived walk): the directories first, each readable and searchable (find exits
# non-zero for a directory it cannot read, and any warning of either producer refuses the run, read_listing); then
# every entry below the store that is not a directory (`-type f` would skip a symbolic link instead of refusing it),
# each held by check_entry. Neither output is shown (a store path may hold a redact word).
read_listing "${scratch}/dirs" "${scratch}/dirs.err" find "${live}" -type d -print0 ||
    refuse "the directory walk of ${live} failed or warned (its output is withheld); nothing copied"
dir=''
while read -r -d '' dir; do
    [[ -r ${dir} && -x ${dir} ]] || refuse "a directory under ${live} cannot be read or entered; nothing copied"
done < "${scratch}/dirs"
[[ -z ${dir} ]] || refuse "the directory walk of ${live} ends mid-entry; nothing copied"
status=0
read_listing "${scratch}/listing" "${scratch}/listing.err" find "${live}" ! -type d -print0 || status=$?
case ${status} in
0) ;;
1) refuse "the live store ${live} holds no file; nothing to move" ;;
*) refuse "the walk of ${live} failed or warned (its output is withheld); nothing copied" ;;
esac
: > "${scratch}/rels" || fail 'cannot write the file list'
entry=''
while read -r -d '' entry; do
    check_entry "${entry}"
done < "${scratch}/listing"
[[ -z ${entry} ]] || refuse "the walk of ${live} ends mid-entry; nothing copied"
# The count is read from the listing's NUL ends, never kept by hand (a name ending in a blank is read without it by
# the loop above and fails the copy or the read-back below, so the count is never overstated).
count=$(tr -cd '\000' < "${scratch}/listing" | wc -c) || fail 'cannot count the listing'
count=${count//[[:space:]]/}

# origin's main, fetched into a scratch repository from the https URL read once from the checkout (the shape of
# records-sync.sh, U101): the checkout's own `refs/remotes/origin/main` may be stale, and its configuration is not
# read. The listing at the published prefix is the comparison's other side.
status=0
push_url=''
read_config git_isolated remote.origin.url push_url "${scratch}/config.err" || status=$?
case ${status} in
0) ;;
1) refuse 'remote.origin.url is unset or empty in the checkout; origin/main is fetched from it' ;;
*) fail 'cannot read git config remote.origin.url' ;;
esac
case ${push_url} in # lint-comparisons: allow the URL's scheme as configured, the fetch source itself
https://?*) ;;
*) refuse "the fetch of origin/main needs an https origin URL, not ${push_url}" ;;
esac
repo=${scratch}/repo.git
git_isolated init --quiet --bare --template= "${repo}" || fail 'git init --bare for the comparison failed'
git_scratch -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
    fetch --quiet --no-tags "${push_url}" refs/heads/main || fail 'git fetch main from origin failed'
main=$(git_scratch rev-parse --verify 'FETCH_HEAD^{commit}') || fail 'cannot read the fetched main'
# Full entries (`<mode> blob <oid>` TAB path) of main at the published prefix.
git_scratch ls-tree -r -z "${main}" -- "${records}/" > "${scratch}/main-listing" || fail "git ls-tree origin/main ${records}/ failed"
base_entries=$'\n'
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != *[[:cntrl:]]* ]] || refuse "a path of origin/main:${records}/ holds a control character" # lint-comparisons: allow a character test on the raw git path
    base_entries+=${path}$'\t'${entry%%$'\t'*}$'\n'
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"

# The masker and the comparison: main's validator alone in a tools tree whose `home/` holds main's top-level entry
# names (so its home-path pattern skips the repository's own `home/<entry>` paths as in a checkout; empty when main has
# no `home/`); each live file but `redact-words.txt` copied into the scratch directory and masked there; the masked
# copy's `<mode> blob <oid>` against main's entry. The checkout's files are never changed.
tools=${scratch}/tools
mkdir -p "${tools}/scripts" "${tools}/home" || fail 'cannot make the tools tree'
git_scratch cat-file blob "${main}:scripts/validate-agent-assets.py" > "${tools}/scripts/validate-agent-assets.py" ||
    fail 'cannot read scripts/validate-agent-assets.py of origin/main'
git_scratch ls-tree -z --name-only "${main}" -- home/ > "${scratch}/home-entries" || fail 'cannot list home/ of origin/main'
entry=''
while read -r -d '' entry; do
    entry=${entry#home/}
    [[ -n ${entry} && ${entry} != *[/[:cntrl:]]* && ${entry} != . && ${entry} != .. ]] || # lint-comparisons: allow a tree entry name as git prints it
        fail 'home/ of origin/main holds an unusable entry name'
    mkdir "${tools}/home/${entry}" || fail 'cannot make the tools tree'
done < "${scratch}/home-entries"
[[ -z ${entry} ]] || fail 'the listing of home/ of origin/main ends mid-entry'
copies=${scratch}/copies
masked=()
rel=''
while read -r -d '' rel; do
    [[ ${rel} != redact-words.txt ]] || continue
    case ${rel} in # lint-comparisons: allow the store-relative path's directory part, made under the scratch copies
    */*) mkdir -p "${copies}/${records}/${rel%/*}" || fail "mkdir for ${rel} failed" ;;
    *) mkdir -p "${copies}/${records}" || fail "mkdir for ${rel} failed" ;;
    esac
    cp -p "${live}/${rel}" "${copies}/${records}/${rel}" || fail "cp of ${rel} into the scratch copies failed"
    masked+=("${copies}/${records}/${rel}")
done < "${scratch}/rels"
[[ -z ${rel} ]] || fail 'the file list ends mid-entry'
if [[ -n ${masked[*]:-} ]]; then
    # The masker prints each copy's path and, on a key collision, the original keys; either may hold a redact word or
    # a secret, so its output goes to a file in the scratch directory and a failure says only that it happened.
    status=0
    uv run --no-project python -I "${tools}/scripts/validate-agent-assets.py" --mask-secrets "${masked[@]}" \
        > "${scratch}/mask.log" 2>&1 || status=$?
    [[ ${status} == 0 ]] || fail "masking the copies failed (exit ${status}); its output is withheld, nothing copied"
fi
: > "${scratch}/differ" || fail 'cannot write the difference list'
live_paths=$'\n'
rel=''
while read -r -d '' rel; do
    [[ ${rel} != redact-words.txt ]] || continue
    path=${records}/${rel}
    live_paths+=${path}$'\n'
    blob=$(git_scratch hash-object --no-filters -- "${copies}/${path}") || fail "git hash-object of the masked copy of ${rel} failed"
    mode=100644
    if [[ -x ${copies}/${path} ]]; then
        mode=100755
    fi
    if [[ ${base_entries} != *$'\n'"${path}"$'\t'"${mode} blob ${blob}"$'\n'* ]]; then # lint-comparisons: allow a published path and an object id as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/rels"
[[ -z ${rel} ]] || fail 'the file list ends mid-entry'
# A path main holds that the live store does not is a deletion the sync would carry: a difference too.
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != "${records}/redact-words.txt" ]] || continue # lint-comparisons: allow the one published path the sync never writes
    if [[ ${live_paths} != *$'\n'"${path}"$'\n'* ]]; then      # lint-comparisons: allow published paths as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"
differ=$(tr -cd '\000' < "${scratch}/differ" | wc -c) || fail 'cannot count the differences'
differ=${differ//[[:space:]]/}
[[ ${differ} == 0 ]] ||
    refuse "a records sync is still due (${differ} path(s) differ between the live store, masked, and origin/main at ${records}/); run records-sync.sh, merge it and run this lever again (a path git ignores never syncs and must be removed from the live store by hand); nothing copied"
echo "${lever}: live store ${live} (${count} files); derived store ${dest}; origin/main ${main} at ${records}/ equals the live store masked" >&2

if [[ ${check} == 1 ]]; then
    echo "check: ${count} files would be copied to ${dest}; nothing written"
    print_step
    exit 0
fi

# The move: the components made as regime-init makes them (`.local/state` is a shared XDG directory, held absent or a
# real directory of this user by regime-env, made with its parent when a fresh host lacks it and not held to a mode;
# `regime-store`, `<slug>` and `<program>` each 0700), then every listed file copied with `cp -p` under `umask 077` for
# the directories below the program store, read back with `cmp`, and the destination walked: every entry a regular
# file, their count the listing's. A failure after this point is `fail`, and the EXIT trap removes the partial copy.
if [[ ! -e ${state_dir} ]]; then
    mkdir -p "${state_dir}" || refuse "cannot create ${state_dir}"
fi
made=0
store_dir_make "${store_parent}" 'the store parent'
store_dir_make "${store_root}" 'the store root'
store_dir_make "${dest}" 'the program store'
dest_made=${made}
copy_state=copying
rel=''
while read -r -d '' rel; do
    case ${rel} in # lint-comparisons: allow the store-relative path's directory part, made under the program store
    */*) (umask 077 && mkdir -p "${dest}/${rel%/*}") || fail "mkdir for ${rel} under ${dest} failed (the copy step)" ;;
    esac
    cp -p "${live}/${rel}" "${dest}/${rel}" || fail "cp of ${rel} exited $? (the copy step)"
    cmp -s "${live}/${rel}" "${dest}/${rel}" || fail "cmp of ${rel} exited $? (the read-back step)"
done < "${scratch}/rels"
[[ -z ${rel} ]] || fail 'the file list ends mid-entry (the copy step)'
status=0
read_listing "${scratch}/dest-listing" "${scratch}/dest-listing.err" find "${dest}" ! -type d -print0 || status=$?
[[ ${status} == 0 ]] || fail "the walk of ${dest} after the copy failed, warned or found nothing (the read-back step)"
entry=''
while read -r -d '' entry; do
    [[ -f ${entry} && ! -L ${entry} ]] || fail "an entry below ${dest} is not a regular file after the copy (the read-back step)"
done < "${scratch}/dest-listing"
[[ -z ${entry} ]] || fail "the walk of ${dest} ends mid-entry (the read-back step)"
copied=$(tr -cd '\000' < "${scratch}/dest-listing" | wc -c) || fail 'cannot count the copied files'
copied=${copied//[[:space:]]/}
[[ ${copied} == "${count}" ]] ||
    fail "${copied} files below ${dest} after the copy, ${count} listed in the live store (the read-back step)"
copy_state=verified
echo "copied ${count} files to ${dest}"
print_step
