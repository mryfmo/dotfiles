#!/usr/bin/env bash
# @file regime-store-move
# @brief Copy a program's live store out of the main checkout into a staging directory under the derived store root, prove the source stood still, rename the staging directory into place, and print the operator's one step that empties the checkout's copy.
# @description
#   Regime-cutover U221, store move 5 of 5 (handoff/07-store-move-design.md; U215 gave regime-env the root, U216 and
#   U220 gave the levers the two-form rule, U219 the seats' grants), reshaped by U221b (verdict U221-e82581f3, class
#   move-race). The live store of a program is written unmasked inside the main checkout's working tree at
#   `.orchestration/orchestrate/<program>/` while `main` holds its masked copies, so the checkout is never clean after
#   a records sync and nothing fast-forwards it (standing order 40, struck: no procedure or lever writes the
#   coordinator's live main checkout again; decisions 2026-11-05T23:34:51Z). This lever is the mechanism that ends the
#   class: run once per program by the coordinator or the operator, from a terminal outside every seat, in the main
#   checkout (a linked worktree is refused), it reads the checkout and writes only under the derived root
#   `${REGIME_STORE_ROOT}` the sourced `regime-env` derives from the physical HOME and the checkout's slug.
#   The shape (U221b). One source manifest, taken once at the start: every path of the live store's walk (U220's
#   derived walk, `find ! -type d` through `read_listing`, every entry a regular file below the store with no symlink
#   component, no control character, no `..`, no name beginning with `.`; `redact-words.txt` included, since the new
#   root is the live store) with its size (`wc -c`) and its sha256 (`sha256sum`, else `shasum -a 256`, the status
#   read), one line per path, sorted, held in the scratch directory. The comparison with `origin/main`, the copy, the
#   verification and the printed count all read that manifest and nothing else of the source. The copy lands in a
#   staging directory `${REGIME_STORE_ROOT}/.<program>.moving-<pid>`, made by `mkdir` (never `-p`) under `umask 077`
#   (an entry of that name fails it, refused by name), filled by `cp -p` of each manifest path and read back by `cmp`;
#   then the live store is walked again and its second manifest must equal the first byte for byte (else `refused: the
#   live store changed during the move (<n> paths); nothing moved, rerun`), the staging directory is walked and its
#   manifest must equal the first too (the count and the bytes of the copy, in one comparison), and the staging
#   directory is renamed to `${REGIME_STORE_ROOT}/<program>` by one `mv` under `-n`, its status read. The rename's
#   proof is the identity hold, not mv's status: `mv` of a directory onto a name that exists moves the staging directory
#   into a directory that took the name (GNU, BSD and uutils mv alike, status 0) and skips a file there (status 0), so
#   after the rename the final name must be a directory whose device and inode (`/usr/bin/stat`, the status read)
#   equal the staging directory's before it; else the run refuses, and the staging directory, found again by that
#   identity wherever the rename left it, is removed with nothing else under the final name touched. A
#   `${REGIME_STORE_ROOT}/<program>` that exists at the start refuses before the fetch, populated or empty: no
#   populated destination is ever written into, and the final name is made by the rename alone. Cleanup on any failure
#   or refusal removes the staging directory alone, by its own name (or by its identity after a rename that moved it),
#   never the final name and never another entry of the root.
#   Before anything is written it checks that a sync is not still due: origin's `main` is fetched into a scratch
#   repository (`git init --bare --template=` under `$TMPDIR`, every command through `git_isolated`, the https URL read
#   once from the checkout, the credential helper `!gh auth git-credential` only), its tree is listed at the published
#   prefix (`ls-tree -r -z`), each manifest path is copied into the scratch directory and masked there with main's
#   `scripts/validate-agent-assets.py --mask-secrets` (the checkout's files are never changed; the masker's output is
#   withheld), and the masked copy's `<mode> blob <oid>` must equal main's entry for every path, no live path may be
#   absent from main but `redact-words.txt`, and no path of main may be absent from the live store (a deletion the sync
#   would carry); otherwise `refused: a records sync is still due (<n> path(s) differ ...)`, the count and not the
#   paths (a path may hold a redact word). `--check` does every read and every comparison and writes nothing (the
#   scratch directory aside), then prints the step; the default run does the same, then the staging copy, the two
#   manifests, the rename, `copied <n> files to <dir>` and the step: the three complete commands (the checkout's own
#   `checkout -- <prefix>`, `clean -fd -- <prefix>` and `pull --ff-only`, run with git's `-C <checkout>`) that are
#   the only write to the checkout's working tree and the last of its class, to be run only after the last records
#   sync from inside has merged. The lever itself runs no git against the checkout but `rev-parse` and the scratch
#   repository's reads. Every producer's status is read (standing order 21): a failed or warning walk, a hash or size
#   that fails, an unreadable `origin` URL or an identity that cannot be read refuses (exit 2); a step after the reads
#   that fails (the fetch, the masker, a `cp`, a `cmp`, a `mkdir`, the `mv`) exits 1 naming the step. The scratch
#   directory is removed on every exit. Nothing under the checkout changes, in either mode.
# @arg $1 string The program (`^[a-z0-9][a-z0-9_-]{0,63}$`), whose live store is `<toplevel>/.orchestration/orchestrate/<program>/`.
# @option --check Every read and every comparison, nothing written; the step printed.
# @stdout `check: <n> files would be copied to <dir>; nothing written` or `copied <n> files to <dir>`, then the step, three lines.
# @stderr `regime-store-move: live store <dir> (<n> files); derived store <dir>; origin/main <sha> at <prefix>/ equals the live store masked`, then `regime-store-move: staging <dir> (identity <dev>:<inode>) renamed to <dir>`, or the refusal.
# @exitcode 0 The check passed, or the copy was made, verified and renamed into place.
# @exitcode 1 A step failed after the reads (the fetch, the masking, a copy, a read-back, a mkdir, the rename); the staging directory was removed.
# @exitcode 2 Refused: usage, a linked worktree, no live store, a listed entry outside the derived walk's shape, a destination component that is not a 0700 directory of this user, a program store that already exists, a sync still due, a failed or warning read (a walk, a hash, a size, the origin URL, an identity), the live store changed during the move, the final name taken during the move; nothing stands at the final name that this run made.
# @example
#   regime-store-move regime-cutover --check
#   regime-store-move regime-cutover
set -euo pipefail

# @description Refuse to run unless this file's sha256 equals its pin in the manifest beside it (regime-cutover U31):
#   `~/.agents/agent-config.yaml` for the installed copy under ~/.local/bin/common, which a sandboxed session cannot
#   write, else the checkout's home/dot_agents/agent-config.yaml. Every read is checked; a failure exits 2 naming the
#   file. The pin is the `claude.levers.sha256.<name>` line, which `scripts/generate-agent-configs.py` refreshes. The
#   HOME read and the hash read are each tested where they stand (an `if`, a `||` with the refusal), so no read
#   carries a producer-status allow comment (U221).
# @set LEVER_MANIFEST The manifest the pin came from.
# @set LEVER_DIR The physical directory of this file, where the sourced libraries sit.
lever_self_check() {
    local src dir self name pin digest home
    # The directory is split from the path in the shell, so no external producer (dirname) can fail unseen.
    src=${BASH_SOURCE[0]}
    case ${src} in
    */*) dir=${src%/*} ;;
    *) dir=. ;;
    esac
    [[ -n ${dir} ]] || dir=/
    dir=$(cd "${dir}" && pwd -P) || {
        echo "${src##*/}: refused: cannot resolve the script directory of ${src}" >&2
        exit 2
    }
    self=${dir}/${BASH_SOURCE[0]##*/}
    LEVER_DIR=${dir}
    name=${self##*/}
    # The checkout layout unless this file sits in the installed directory under the physical HOME; a HOME that cannot
    # be entered is the checkout layout too, decided here, not by an empty value read later.
    LEVER_MANIFEST=${dir}/../../home/dot_agents/agent-config.yaml
    if home=$(cd "${HOME}" 2> /dev/null && pwd -P); then
        if [[ ${dir} == "${home}/.local/bin/common" ]]; then # lint-comparisons: allow both sides are pwd -P forms
            LEVER_MANIFEST=${HOME}/.agents/agent-config.yaml
        fi
    fi
    [[ -r ${LEVER_MANIFEST} ]] || {
        echo "${name}: refused: manifest unreadable: ${LEVER_MANIFEST}" >&2
        exit 2
    }
    pin=$(sed -n -E "s/^      ${name//./\\.}: ([0-9a-f]{64})\$/\\1/p" "${LEVER_MANIFEST}") || {
        echo "${name}: refused: cannot read ${LEVER_MANIFEST}" >&2
        exit 2
    }
    [[ ${pin} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: no single sha256 pin for ${name} in ${LEVER_MANIFEST}" >&2
        exit 2
    }
    if command -v sha256sum > /dev/null; then
        digest=$(sha256sum < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    else
        digest=$(shasum -a 256 < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    fi
    digest=${digest%% *}
    [[ ${digest} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: cannot hash ${self}" >&2
        exit 2
    }
    [[ ${digest} == "${pin}" ]] || {
        echo "${name}: refused: sha256 ${digest} of ${self} differs from the pin in ${LEVER_MANIFEST}" >&2
        exit 2
    }
}
lever_self_check
# The isolated git and the environment scrub come from the library beside this script (U113). The scrub runs here,
# before the first git: GIT_CONFIG_* would add config, includes and URL rewrites to every git command, GIT_DIR would
# point every command at another repository, and a proxy or certificate variable would steer the fetch.
[[ -r ${LEVER_DIR}/git-isolated.sh ]] || {
    echo "regime-store-move: refused: git-isolated.sh unreadable beside this script: ${LEVER_DIR}/git-isolated.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/git-isolated.sh
. "${LEVER_DIR}/git-isolated.sh"
# shellcheck disable=SC2119 # no name is kept: every GIT_* and transport variable goes
git_env_scrub

[[ -r ${LEVER_DIR}/read-lib.sh ]] || {
    echo "regime-store-move: refused: read-lib.sh unreadable beside this script: ${LEVER_DIR}/read-lib.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/read-lib.sh
. "${LEVER_DIR}/read-lib.sh"

# The store root (U215, U216): the program stores lie under `REGIME_STORE_ROOT`, the root the sourced regime-env
# derives from the physical HOME and this checkout's slug and holds component by component; the helper is sourced
# from the directory this lever runs from and self-checked like a lever (U33), so a rewritten copy stops this lever.
# The call that derives the root comes after this lever's own checkout checks, below.
[[ -r ${LEVER_DIR}/regime-env ]] || {
    echo "regime-store-move: refused: regime-env unreadable beside this script: ${LEVER_DIR}/regime-env" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/regime-env
. "${LEVER_DIR}/regime-env"

lever=regime-store-move
usage='usage: regime-store-move <program> [--check]'

# @description Print the refusal on stderr and exit 2.
# @arg $@ string The reason.
refuse() {
    echo "${lever}: refused: $*" >&2
    exit 2
}

# @description Print the failure on stderr and exit 1 (the EXIT trap removes the staging directory and the scratch directory).
# @arg $@ string The reason.
fail() {
    echo "${lever}: $*" >&2
    exit 1
}

scratch='' dest='' staging='' staging_made=0 staging_id='' move_state=''
# @description Remove this run's scratch directory, and, when the staging directory was made and the rename did not
#   end verified, the staging directory alone: by its own name when it still stands there, else by its identity at
#   `<final name>/<staging name>`, where `mv` puts a directory whose target name was taken by another directory
#   during the move (that entry's own files are never touched). The final name made by a verified rename is never
#   removed, nor any other entry of the root. Runs from the EXIT trap, so a `fail` or `refuse` at any point leaves no
#   staging directory.
cleanup() {
    local moved id
    if [[ ${staging_made} == 1 && ${move_state} != renamed ]]; then
        if [[ -d ${staging} && ! -L ${staging} ]]; then
            rm -rf -- "${staging}" 2> /dev/null || echo "${lever}: could not remove the staging directory ${staging}" >&2
            echo "${lever}: the staging directory ${staging} was removed; nothing moved, nothing in the checkout changed" >&2
        fi
        moved=${dest}/${staging##*/}
        if [[ -n ${staging_id} && -d ${moved} && ! -L ${moved} ]]; then
            if id=$(identity_read "${moved}"); then
                if [[ ${id} == "${staging_id}" ]]; then
                    rm -rf -- "${moved}" 2> /dev/null || echo "${lever}: could not remove the staging directory at ${moved}" >&2
                    echo "${lever}: the staging directory, moved to ${moved} by the rename, was removed by its identity; nothing else under ${dest} is touched" >&2
                fi
            fi
        fi
    fi
    if [[ -n ${scratch} && -d ${scratch} ]]; then
        rm -r "${scratch}" 2> /dev/null || echo "${lever}: could not remove ${scratch}" >&2
    fi
}

# @description Run the isolated git in the comparison's own repository (the shape of records-sync.sh, U101): the
#   repository named by `--git-dir`, so no checkout is consulted, and nothing of the user, system or checkout
#   configuration (git-isolated.sh, U113).
# @arg $@ string The `git` arguments.
git_scratch() {
    git_isolated --git-dir="${repo}" "$@"
}

# @description Print the operator's step: the three commands that empty the checkout's copy of the store and move the
#   checkout to origin/main, each complete, the paths quoted for the shell. The step is printed, never run: the live
#   checkout is written by the operator's hand alone, once (the struck order 40's successor rule).
print_step() {
    printf 'git -C %q checkout -- %q\n' "${top_real}" "${records}"
    printf 'git -C %q clean -fd -- %q\n' "${top_real}" "${records}"
    printf 'git -C %q pull --ff-only\n' "${top_real}"
}

case ${OSTYPE} in
darwin*)
    stat_mode=(-f %Lp)
    stat_identity=(-f %d:%i)
    ;;
*)
    stat_mode=(-c %a)
    stat_identity=(-c %d:%i)
    ;;
esac
# The hash tool of the manifest, the self-check's preference: `sha256sum` when PATH has one, else `shasum -a 256`.
if command -v sha256sum > /dev/null; then
    hash_tool=(sha256sum)
else
    hash_tool=(shasum -a 256)
fi

# @description Print one file's sha256, read with its status: the tool's first field, held to 64 hex digits.
# @arg $1 path The file.
# @exitcode 0 The digest was printed.
# @exitcode 2 The tool failed or printed no digest.
hash_file() {
    local hf_out
    hf_out=$("${hash_tool[@]}" -- "$1") || return 2
    hf_out=${hf_out%% *}
    [[ ${hf_out} =~ ^[0-9a-f]{64}$ ]] || return 2
    printf '%s\n' "${hf_out}"
}

# @description Print one entry's identity, `<device>:<inode>`, read by `/usr/bin/stat` without following a link (the
#   entry itself, so a link planted at the name has its own identity), with its status.
# @arg $1 path The entry.
# @exitcode 0 The identity was printed.
# @exitcode 2 stat failed or printed something else.
identity_read() {
    local ir_out
    ir_out=$(/usr/bin/stat "${stat_identity[@]}" "$1") || return 2
    [[ ${ir_out} =~ ^[0-9]+:[0-9]+$ ]] || return 2
    printf '%s\n' "${ir_out}"
}

# @description Hold one component of the destination (`regime-store`, the store root `<slug>`, the program directory)
#   as regime-init holds them (U215b, U215c): a symbolic link refuses by name; present, it must be a real directory of
#   this user whose mode is 0700, read by `/usr/bin/stat` with its status (a failed read refuses, standing order 21);
#   absent, nothing. Nothing is written.
# @arg $1 path The directory.
# @arg $2 string What it is, for the refusal.
store_dir_hold() {
    local path=$1 what=$2 mode
    [[ ! -L ${path} ]] || refuse "${what} ${path} is a symlink"
    [[ -e ${path} ]] || return 0
    [[ -d ${path} && -O ${path} ]] || refuse "${what} ${path} is not a real directory of this user"
    mode=$(/usr/bin/stat "${stat_mode[@]}" "${path}") || refuse "cannot read the mode of ${what} ${path}"
    [[ ${mode} == 700 ]] || refuse "${what} ${path} has mode ${mode}, not 0700"
}

# @description Make one component of the destination when absent, by its own `mkdir` under `umask 077` (no `-p`, so
#   none is made through an entry planted above it; mkdir takes no existing entry, so a link planted between the hold
#   and the mkdir fails it instead of being followed), then hold it as store_dir_hold does.
# @arg $1 path The directory.
# @arg $2 string What it is, for the refusal.
store_dir_make() {
    local path=$1 what=$2
    [[ ! -L ${path} ]] || refuse "${what} ${path} is a symlink"
    if [[ ! -e ${path} ]]; then
        (umask 077 && mkdir "${path}") || refuse "cannot create ${what} ${path}"
    fi
    store_dir_hold "${path}" "${what}"
}

# @description Hold one entry of a walk to the derived walk's shape (U220, U28b F2): below the walked directory, no
#   control character (a newline would hide a component), no `..`, no component beginning with `.` (no record
#   carries such a name, and the derived form's walk refuses it, so the move does too), no symbolic link at any
#   component, a regular file whose directory resolves (`pwd -P`) inside the walked directory; then append its
#   relative path to the file list. A refusal names the entry's relative path, never its text.
# @arg $1 path The walked directory (the live store, or the staging directory).
# @arg $2 path The entry as find prints it.
# @arg $3 path The NUL-separated file list the relative path is appended to.
# @arg $4 string What the walked directory is, for the refusals.
check_entry() {
    local ce_root=$1 ce_entry=$2 ce_out=$3 ce_what=$4 rel prefix part rest entry_dir
    case ${ce_entry} in # lint-comparisons: allow a path as find prints it, refused unless below the walked directory
    "${ce_root}"/?*) ;;
    *) refuse "the walk of ${ce_root} names a path outside ${ce_what}; nothing moved" ;;
    esac
    rel=${ce_entry#"${ce_root}/"}
    [[ ${rel} != *[[:cntrl:]]* ]] || refuse "a path of ${ce_what} holds a control character; nothing moved" # lint-comparisons: allow a character test on the raw path
    [[ ${rel} != *..* ]] || refuse "a path of ${ce_what} holds '..': ${rel}; nothing moved"                 # lint-comparisons: allow refuses a raw path that holds ..
    prefix=${ce_root}
    rest=${rel}
    # Split on `/` by parameter expansion (no here-string, so no temporary file can go missing, U101).
    while [[ -n ${rest} ]]; do
        part=${rest%%/*}
        if [[ ${rest} == */* ]]; then # lint-comparisons: allow splits the path into its components
            rest=${rest#*/}
        else
            rest=''
        fi
        [[ ${part} != .* ]] || # lint-comparisons: allow a name test on one component of the walk
            refuse "a name of ${ce_what} begins with '.', which no record carries and the derived walk refuses (U220): ${rel}; remove it by hand, nothing moved"
        prefix=${prefix}/${part}
        [[ ! -L ${prefix} ]] || refuse "a component of a path of ${ce_what} is a symlink: ${prefix}; nothing moved"
    done
    [[ -f ${prefix} ]] || refuse "a path of ${ce_what} is not a regular file: ${rel}; nothing moved"
    entry_dir=$(cd "${prefix%/*}" && pwd -P) || refuse "cannot resolve the directory of ${rel}"
    [[ ${entry_dir} == "${ce_root}" || ${entry_dir} == "${ce_root}"/* ]] || # lint-comparisons: allow both sides are pwd -P forms
        refuse "a path of ${ce_what} resolves outside ${ce_root}: ${rel}; nothing moved"
    printf '%s\0' "${rel}" >> "${ce_out}" || fail 'cannot write the file list'
}

# @description Walk one directory as U220's derived walk does: the directories first, each readable and searchable
#   (find exits non-zero for a directory it cannot read, and any warning of either producer refuses the run,
#   read_listing); then every entry below it that is not a directory (`-type f` would skip a symbolic link instead of
#   refusing it), each held by check_entry, its relative path appended to the file list. Neither find output is shown
#   (a store path may hold a redact word).
# @arg $1 path The directory (the live store, or the staging directory).
# @arg $2 path The NUL-separated file list this writes, under the scratch directory.
# @arg $3 string What the directory is, for the refusals.
walk_store() {
    local ws_root=$1 ws_out=$2 ws_what=$3 ws_dir='' ws_entry='' ws_status=0
    read_listing "${ws_out}.dirs" "${ws_out}.dirs.err" find "${ws_root}" -type d -print0 ||
        refuse "the directory walk of ${ws_what} ${ws_root} failed or warned (find; its output is withheld); nothing moved"
    while read -r -d '' ws_dir; do
        [[ -r ${ws_dir} && -x ${ws_dir} ]] || refuse "a directory under ${ws_root} cannot be read or entered; nothing moved"
    done < "${ws_out}.dirs"
    [[ -z ${ws_dir} ]] || refuse "the directory walk of ${ws_root} ends mid-entry; nothing moved"
    read_listing "${ws_out}.listing" "${ws_out}.listing.err" find "${ws_root}" ! -type d -print0 || ws_status=$?
    case ${ws_status} in
    0) ;;
    1) refuse "${ws_what} ${ws_root} holds no file; nothing to move" ;;
    *) refuse "the walk of ${ws_what} ${ws_root} failed or warned (find; its output is withheld); nothing moved" ;;
    esac
    : > "${ws_out}" || fail "cannot write the file list ${ws_out}"
    while read -r -d '' ws_entry; do
        check_entry "${ws_root}" "${ws_entry}" "${ws_out}" "${ws_what}"
    done < "${ws_out}.listing"
    [[ -z ${ws_entry} ]] || refuse "the walk of ${ws_root} ends mid-entry; nothing moved"
}

# @description Write one manifest: for every relative path of a file list, one line `<path>TAB<size>TAB<sha256>`
#   (the size by `wc -c`, the digest by hash_file, each read with its status), sorted under `LC_ALL=C`, so two
#   manifests of one tree compare byte for byte with `cmp`. A name beginning or ending in a blank, which `read`
#   strips, names no file here and refuses (the derived walk never produced one).
# @arg $1 path The walked directory the relative paths are below.
# @arg $2 path The NUL-separated file list.
# @arg $3 path The manifest this writes.
manifest_write() {
    local mw_root=$1 mw_rels=$2 mw_out=$3 mw_rel='' mw_sum mw_size
    : > "${mw_out}.unsorted" || fail "cannot write the manifest ${mw_out}"
    while read -r -d '' mw_rel; do
        mw_sum=$(hash_file "${mw_root}/${mw_rel}") ||
            refuse "cannot hash a file of ${mw_root} (${hash_tool[*]} failed or printed no digest); nothing moved"
        mw_size=$(wc -c < "${mw_root}/${mw_rel}") || refuse "cannot size a file of ${mw_root} (wc failed); nothing moved"
        mw_size=${mw_size//[[:space:]]/}
        printf '%s\t%s\t%s\n' "${mw_rel}" "${mw_size}" "${mw_sum}" >> "${mw_out}.unsorted" || fail "cannot write the manifest ${mw_out}"
    done < "${mw_rels}"
    [[ -z ${mw_rel} ]] || refuse "the file list of ${mw_root} ends mid-entry; nothing moved"
    LC_ALL=C sort "${mw_out}.unsorted" > "${mw_out}" || fail "cannot sort the manifest ${mw_out}"
}

# @description Print the number of distinct paths whose lines differ between two manifests (`comm -3`, the lines of
#   either side only; a changed file is one path, an added or removed one too), for the refusal that names a count.
# @arg $1 path The first manifest.
# @arg $2 path The second manifest.
# @exitcode 0 The count was printed.
# @exitcode 2 comm or a write under the scratch directory failed.
manifest_diff_count() {
    local md_line='' md_rel md_seen=$'\n'
    LC_ALL=C comm -3 "$1" "$2" > "${scratch}/manifest-diff" || return 2
    : > "${scratch}/manifest-diff-rels" || return 2
    while read -r md_line; do
        md_rel=${md_line%%$'\t'*}
        if [[ ${md_seen} != *$'\n'"${md_rel}"$'\n'* ]]; then
            md_seen+=${md_rel}$'\n'
            printf '%s\n' "${md_rel}" >> "${scratch}/manifest-diff-rels" || return 2
        fi
    done < "${scratch}/manifest-diff"
    wc -l < "${scratch}/manifest-diff-rels"
}

program='' check=0
for arg in "$@"; do
    case ${arg} in
    --check) check=1 ;;
    -*) refuse "${usage}" ;;
    *)
        [[ -z ${program} ]] || refuse "${usage}"
        program=${arg}
        ;;
    esac
done
[[ -n ${program} ]] || refuse "${usage}"
[[ ${program} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "program '${program}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"

toplevel=$(git_isolated rev-parse --show-toplevel 2> /dev/null) || refuse 'not in a git checkout'
git_dir=$(git_isolated rev-parse --path-format=absolute --git-dir) || refuse 'cannot read the git directory'
common_dir=$(git_isolated rev-parse --path-format=absolute --git-common-dir) || refuse 'cannot read the git common directory'
git_dir=$(cd "${git_dir}" && pwd -P) || refuse "cannot resolve ${git_dir}"
common_dir=$(cd "${common_dir}" && pwd -P) || refuse "cannot resolve ${common_dir}"
[[ ${git_dir} == "${common_dir}" ]] || # lint-comparisons: allow both sides are pwd -P forms
    refuse "${toplevel} is a linked worktree; run from the main checkout, where the live store lies"
cd "${toplevel}" || refuse "cannot enter ${toplevel}"
# The toplevel is physical, so every path below is measured against the real checkout (U28b F2).
top_real=$(pwd -P) || refuse "cannot resolve ${toplevel}"
# regime-env derives `REGIME_STORE_ROOT` for this checkout (its own refusals name this lever). This lever reads nothing
# in the hcom store, so the store's `origin` binding is not asked of it (`--unbound-ok`, as pr-merge.sh and
# records-sync.sh ask: the dotfiles program runs on the pre-U33 store pair and its derived hcom store carries no
# `origin`); the collision refusal and every store-root hold stay. The helper's return 1 is this lever's exit 2.
regime_env regime-store-move --unbound-ok || exit 2
[[ -n ${REGIME_STORE_ROOT:-} ]] || refuse "regime-env derived no store root for ${top_real}; the derived store is made under it (U215, U216)"

# The live store: the checkout's own `.orchestration/orchestrate/<program>`, the pre-move form, each of its three
# components a directory of this user and no symlink (the pr-merge.sh hold of U216).
records=.orchestration/orchestrate/${program}
live=${top_real}/${records}
path=${top_real}
for part in .orchestration orchestrate "${program}"; do
    path=${path}/${part}
    [[ -d ${path} && ! -L ${path} && -O ${path} ]] ||
        refuse "${path} is not a directory of this user (a symlink or a missing store); the live store this lever moves is the checkout's ${records}/"
done
# The destination and its components, outermost first: `regime-store`, the store root `<slug>`, the program store.
store_root=${REGIME_STORE_ROOT}
store_parent=${store_root%/*}
state_dir=${store_parent%/*}
dest=${store_root}/${program}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/regime-store-move.XXXXXX") || fail 'mktemp failed'
trap cleanup EXIT

# The destination before anything is read from the store: every component held (nothing written), and the program
# store absent: the rename makes it, and a directory that is already there, populated or empty, is never written
# into (U221b).
store_dir_hold "${store_parent}" 'the store parent'
store_dir_hold "${store_root}" 'the store root'
store_dir_hold "${dest}" 'the program store'
[[ ! -e ${dest} ]] ||
    refuse "${dest} already exists; the move renames its staging directory to that name and never writes into a directory that is already there (one that holds the records, or an empty one: remove it by hand first); nothing copied"

# The source manifest, taken once: the live store's walk, each path with its size and sha256, sorted. Every later
# step reads this manifest; the count is its line count.
walk_store "${live}" "${scratch}/rels" 'the live store'
manifest_write "${live}" "${scratch}/rels" "${scratch}/manifest"
count=$(wc -l < "${scratch}/manifest") || fail 'cannot count the manifest'
count=${count//[[:space:]]/}

# origin's main, fetched into a scratch repository from the https URL read once from the checkout (the shape of
# records-sync.sh, U101): the checkout's own `refs/remotes/origin/main` may be stale, and its configuration is not
# read. The listing at the published prefix is the comparison's other side.
status=0
push_url=''
read_config git_isolated remote.origin.url push_url "${scratch}/config.err" || status=$?
case ${status} in
0) ;;
1) refuse 'remote.origin.url is unset or empty in the checkout; origin/main is fetched from it' ;;
*) refuse 'cannot read git config remote.origin.url (git config failed); nothing moved' ;;
esac
case ${push_url} in # lint-comparisons: allow the URL's scheme as configured, the fetch source itself
https://?*) ;;
*) refuse "the fetch of origin/main needs an https origin URL, not ${push_url}" ;;
esac
repo=${scratch}/repo.git
git_isolated init --quiet --bare --template= "${repo}" || fail 'git init --bare for the comparison failed'
git_scratch -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
    fetch --quiet --no-tags "${push_url}" refs/heads/main || fail 'git fetch main from origin failed'
main=$(git_scratch rev-parse --verify 'FETCH_HEAD^{commit}') || fail 'cannot read the fetched main'
# Full entries (`<mode> blob <oid>` TAB path) of main at the published prefix.
git_scratch ls-tree -r -z "${main}" -- "${records}/" > "${scratch}/main-listing" || fail "git ls-tree origin/main ${records}/ failed"
base_entries=$'\n'
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != *[[:cntrl:]]* ]] || refuse "a path of origin/main:${records}/ holds a control character" # lint-comparisons: allow a character test on the raw git path
    base_entries+=${path}$'\t'${entry%%$'\t'*}$'\n'
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"

# The masker and the comparison: main's validator alone in a tools tree whose `home/` holds main's top-level entry
# names (so its home-path pattern skips the repository's own `home/<entry>` paths as in a checkout; empty when main has
# no `home/`); each manifest path but `redact-words.txt` copied into the scratch directory and masked there; the masked
# copy's `<mode> blob <oid>` against main's entry. The checkout's files are never changed.
tools=${scratch}/tools
mkdir -p "${tools}/scripts" "${tools}/home" || fail 'cannot make the tools tree'
git_scratch cat-file blob "${main}:scripts/validate-agent-assets.py" > "${tools}/scripts/validate-agent-assets.py" ||
    fail 'cannot read scripts/validate-agent-assets.py of origin/main'
git_scratch ls-tree -z --name-only "${main}" -- home/ > "${scratch}/home-entries" || fail 'cannot list home/ of origin/main'
entry=''
while read -r -d '' entry; do
    entry=${entry#home/}
    [[ -n ${entry} && ${entry} != *[/[:cntrl:]]* && ${entry} != . && ${entry} != .. ]] || # lint-comparisons: allow a tree entry name as git prints it
        fail 'home/ of origin/main holds an unusable entry name'
    mkdir "${tools}/home/${entry}" || fail 'cannot make the tools tree'
done < "${scratch}/home-entries"
[[ -z ${entry} ]] || fail 'the listing of home/ of origin/main ends mid-entry'
copies=${scratch}/copies
masked=()
line=''
while read -r line; do
    rel=${line%%$'\t'*}
    [[ ${rel} != redact-words.txt ]] || continue
    case ${rel} in # lint-comparisons: allow the store-relative path's directory part, made under the scratch copies
    */*) mkdir -p "${copies}/${records}/${rel%/*}" || fail "mkdir for ${rel} failed" ;;
    *) mkdir -p "${copies}/${records}" || fail "mkdir for ${rel} failed" ;;
    esac
    cp -p "${live}/${rel}" "${copies}/${records}/${rel}" || fail "cp of ${rel} into the scratch copies failed"
    masked+=("${copies}/${records}/${rel}")
done < "${scratch}/manifest"
[[ -z ${line} ]] || fail 'the manifest ends mid-entry'
if [[ -n ${masked[*]:-} ]]; then
    # The masker prints each copy's path and, on a key collision, the original keys; either may hold a redact word or
    # a secret, so its output goes to a file in the scratch directory and a failure says only that it happened.
    status=0
    uv run --no-project python -I "${tools}/scripts/validate-agent-assets.py" --mask-secrets "${masked[@]}" \
        > "${scratch}/mask.log" 2>&1 || status=$?
    [[ ${status} == 0 ]] || fail "masking the copies failed (exit ${status}); its output is withheld, nothing copied"
fi
: > "${scratch}/differ" || fail 'cannot write the difference list'
live_paths=$'\n'
line=''
while read -r line; do
    rel=${line%%$'\t'*}
    [[ ${rel} != redact-words.txt ]] || continue
    path=${records}/${rel}
    live_paths+=${path}$'\n'
    blob=$(git_scratch hash-object --no-filters -- "${copies}/${path}") || fail "git hash-object of the masked copy of ${rel} failed"
    mode=100644
    if [[ -x ${copies}/${path} ]]; then
        mode=100755
    fi
    if [[ ${base_entries} != *$'\n'"${path}"$'\t'"${mode} blob ${blob}"$'\n'* ]]; then # lint-comparisons: allow a published path and an object id as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/manifest"
[[ -z ${line} ]] || fail 'the manifest ends mid-entry'
# A path main holds that the live store does not is a deletion the sync would carry: a difference too.
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != "${records}/redact-words.txt" ]] || continue # lint-comparisons: allow the one published path the sync never writes
    if [[ ${live_paths} != *$'\n'"${path}"$'\n'* ]]; then      # lint-comparisons: allow published paths as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"
differ=$(tr -cd '\000' < "${scratch}/differ" | wc -c) || fail 'cannot count the differences'
differ=${differ//[[:space:]]/}
[[ ${differ} == 0 ]] ||
    refuse "a records sync is still due (${differ} path(s) differ between the live store, masked, and origin/main at ${records}/); run records-sync.sh, merge it and run this lever again (a path git ignores never syncs and must be removed from the live store by hand); nothing copied"
echo "${lever}: live store ${live} (${count} files); derived store ${dest}; origin/main ${main} at ${records}/ equals the live store masked" >&2

if [[ ${check} == 1 ]]; then
    echo "check: ${count} files would be copied to ${dest}; nothing written"
    print_step
    exit 0
fi

# The move. The components above the program store made as regime-init makes them (`.local/state` is a shared XDG
# directory, held absent or a real directory of this user by regime-env, made with its parent when a fresh host lacks
# it and not held to a mode; `regime-store` and `<slug>` each 0700). Then the staging directory under the root, by its
# own `mkdir` under `umask 077` (an entry of that name fails it), its identity read; every manifest path copied into
# it with `cp -p` (the directories below it made under `umask 077`) and read back with `cmp`.
if [[ ! -e ${state_dir} ]]; then
    mkdir -p "${state_dir}" || refuse "cannot create ${state_dir}"
fi
store_dir_make "${store_parent}" 'the store parent'
store_dir_make "${store_root}" 'the store root'
staging=${store_root}/.${program}.moving-$$
(umask 077 && mkdir "${staging}") || refuse "cannot create the staging directory ${staging} (an entry of that name exists, or ${store_root} is not writable); nothing moved"
staging_made=1
staging_id=$(identity_read "${staging}") || refuse "cannot read the identity of the staging directory ${staging} (/usr/bin/stat failed); nothing moved"
line=''
while read -r line; do
    rel=${line%%$'\t'*}
    case ${rel} in # lint-comparisons: allow the store-relative path's directory part, made under the staging directory
    */*) (umask 077 && mkdir -p "${staging}/${rel%/*}") || fail "mkdir for ${rel} under ${staging} failed (the copy step)" ;;
    esac
    cp -p "${live}/${rel}" "${staging}/${rel}" || fail "cp of ${rel} exited $? (the copy step)"
    cmp -s "${live}/${rel}" "${staging}/${rel}" || fail "cmp of ${rel} exited $? (the read-back step)"
done < "${scratch}/manifest"
[[ -z ${line} ]] || fail 'the manifest ends mid-entry (the copy step)'

# The source stood still: the live store walked again, its second manifest equal to the first byte for byte; else
# the refusal names the count of changed paths and the staging directory goes (the EXIT trap).
walk_store "${live}" "${scratch}/rels-after" 'the live store'
manifest_write "${live}" "${scratch}/rels-after" "${scratch}/manifest-after"
if ! cmp -s "${scratch}/manifest" "${scratch}/manifest-after"; then
    changed=$(manifest_diff_count "${scratch}/manifest" "${scratch}/manifest-after") || fail 'cannot count the changed paths (comm failed)'
    changed=${changed//[[:space:]]/}
    refuse "the live store changed during the move (${changed} paths); nothing moved, rerun"
fi
# The copy is whole: the staging directory walked to the same shape, its manifest equal to the first (the count and
# every file's size and digest, in one comparison).
walk_store "${staging}" "${scratch}/rels-staging" 'the staging directory'
manifest_write "${staging}" "${scratch}/rels-staging" "${scratch}/manifest-staging"
if ! cmp -s "${scratch}/manifest" "${scratch}/manifest-staging"; then
    changed=$(manifest_diff_count "${scratch}/manifest" "${scratch}/manifest-staging") || fail 'cannot count the differing paths (comm failed)'
    changed=${changed//[[:space:]]/}
    fail "the copy under ${staging} differs from the live store's manifest (${changed} paths) (the read-back step)"
fi

# The rename: the final name must still be absent (a directory or a link that took it during the move refuses by
# name, untouched), then one `mv` under `-n`, its status read, and the identity hold that is the rename's proof: `mv`
# of a directory onto a name that exists moves the staging directory into a directory there and skips a file there, each
# with status 0, so the final name must now be a directory whose device and inode are the staging directory's.
[[ ! -e ${dest} && ! -L ${dest} ]] ||
    refuse "${dest} appeared during the move; the staging directory is removed and nothing under ${dest} is touched; nothing moved, rerun after moving or removing it by hand"
mv -n "${staging}" "${dest}" || fail "mv -n of ${staging} to ${dest} exited $? (the rename step)"
final_id=$(identity_read "${dest}") ||
    refuse "cannot read the identity of ${dest} after the rename (/usr/bin/stat failed, or mv moved nothing and the name is absent); the staging directory is removed, nothing moved"
[[ ${final_id} == "${staging_id}" ]] ||
    refuse "${dest} is not the staging directory after the rename (an entry took the name during the move, and mv moved the staging directory into it or skipped it); the staging directory is removed by its identity and nothing else under ${dest} is touched; nothing moved, rerun"
move_state=renamed
store_dir_hold "${dest}" 'the program store'
echo "${lever}: staging ${staging} (identity ${staging_id}) renamed to ${dest}" >&2
echo "copied ${count} files to ${dest}"
print_step
