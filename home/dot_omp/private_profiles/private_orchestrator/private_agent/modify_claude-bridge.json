#!/bin/sh
# Generated from home/dot_agents/agent-config.yaml by scripts/generate-agent-configs.py.
# @file home/dot_omp/private_profiles/private_<role>/private_agent/modify_claude-bridge.json
# @brief Place the kit's Claude Code executable, the pinned lever claude-keyed, into ~/.omp/profiles/<role>/agent/claude-bridge.json and keep every other key.
# @description
#   regime-cutover U510. chezmoi passes the live file on stdin. The pi-claude-bridge extension reads
#   provider.pathToClaudeCodeExecutable from this file alone (patch 06; config.ts:61, :110) and rewrites the
#   file with every key kept when it records startupNoticeShown (config.ts:29). The merge sets that one key to
#   ~/.local/bin/common/claude-keyed (the Agent SDK spawns it in place of Claude Code; it runs the bridge
#   package's Claude Code binary on an API key read from the file REGIME_ANTHROPIC_KEY_FILE names, never on
#   the seats' login) and keeps every other key in its order, written by json.dumps(indent=2) and a newline.
#   Its contract (U510e) is idempotence of its own output, a second run on what it wrote changes nothing,
#   which is what the output index's modify comparison measures (check-agent-runtime.py runs the script on
#   the live file and compares the bytes), and the provider row's presence, which the doctor's claude-keyed
#   row checks by key (U513). It is not byte equality with the bridge's own JSON.stringify(next, null, 2)
#   rewrite: a float's form differs (json.dumps writes 1e-07 where JSON.stringify writes 1e-7), so a bridge
#   rewrite that carries one reads as a change once, until the next apply writes this form again. It runs
#   under the system `python3 -I` with the standard library alone, the kit's baseline, which the apply
#   container has, and no other tool (U510b). Without python3 it prints one line on stderr and nothing on
#   stdout and exits 1, so chezmoi apply fails naming this file: fail closed, never the login route left in
#   place by silence. The live file sits in the seat's own write root, so its content is the seat's (U510d):
#   on an empty, non-UTF-8, unparseable or non-object input, a NaN or an Infinity (refused at the parse and
#   never written: json.dumps would re-emit them and the bridge, reading `{}` from the non-JSON file, would
#   fall back to its bundled binary on the login), a lone surrogate or nesting past the recursion limit it
#   prints the managed object alone with one warning and exits 0, so chezmoi apply never clobbers the
#   bridge's file, never writes one the bridge cannot parse and never fails on the file's content. The
#   warning is one line per run: when more than one condition applies, the first met names the reason.
set -eu

if ! command -v python3 > /dev/null 2>&1; then
    echo "claude-bridge.json: python3 is not on PATH; the apply of this profile's claude-bridge.json fails rather than leave the login route in place" >&2
    exit 1
fi

merge=$(
    cat << 'PY'
import json
import os
import sys

EXECUTABLE = os.path.expanduser("~/.local/bin/common/claude-keyed")
MANAGED_KEY = "pathToClaudeCodeExecutable"


class OddInput(ValueError):
    """An input the merge does not carry forward; its text is the reason the one warning names."""


def warn(reason):
    print(f"claude-bridge.json: {reason}; wrote the managed provider row alone", file=sys.stderr)


def refuse_constant(token):
    raise OddInput(f"the live file holds {token}, which JSON cannot carry")


def read_object(raw):
    """The live file's bytes as a JSON object, or OddInput naming what they are instead."""
    if not raw.strip():
        raise OddInput("the live file is empty or absent")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise OddInput("the live file is not UTF-8") from None
    try:
        data = json.loads(text, parse_constant=refuse_constant)
    except OddInput:
        raise
    except RecursionError:
        raise OddInput("the live file nests deeper than the merge reads") from None
    except ValueError:
        raise OddInput("the live file is not valid JSON") from None
    if not isinstance(data, dict):
        raise OddInput("the live file is not a JSON object")
    return data


def render(data):
    """json.dumps(indent=2) and a newline, as UTF-8 bytes (not JSON.stringify's: a float's form differs)."""
    return (json.dumps(data, indent=2, ensure_ascii=False, allow_nan=False) + "\n").encode("utf-8")


def main():
    """One warning at most per run: the first condition met names the reason, a later one adds no line."""
    reason = None
    try:
        data = read_object(sys.stdin.buffer.read())
    except OddInput as odd:
        reason = str(odd)
        data = {}
    provider = data.get("provider")
    if not isinstance(provider, dict):
        if provider is not None and reason is None:
            reason = "provider is not a JSON object"
        provider = {}
    provider[MANAGED_KEY] = EXECUTABLE
    data["provider"] = provider
    try:
        out = render(data)
    except (ValueError, RecursionError):
        if reason is None:
            reason = "the live file holds a value JSON cannot carry (a lone surrogate)"
        out = render({"provider": {MANAGED_KEY: EXECUTABLE}})
    if reason is not None:
        warn(reason)
    sys.stdout.buffer.write(out)
    return 0


sys.exit(main())
PY
)

exec python3 -I -c "$merge"
