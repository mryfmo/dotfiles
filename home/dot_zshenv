#!/usr/bin/env zsh

# @file home/dot_zshenv
# @brief Configure the minimal environment required by every zsh instance.
# @description
#   This file is also read by non-interactive SSH remote commands used to
#   bootstrap Mosh and Herdr. Keep it silent and lightweight. Claude Code's
#   updater stays disabled so mise remains authoritative: DISABLE_UPDATES "Set
#   to `1` to block all updates including manual `claude update` and `claude
#   install`" (code.claude.com/docs/en/env-vars); DISABLE_AUTOUPDATER stops the
#   background check.
export DISABLE_AUTOUPDATER=1
export DISABLE_UPDATES=1

# A remote seat host's Claude login (regime-cutover U37, docs/remote-host-logins.md): the operator stores
# the `claude setup-token` token in this host-local 0600 file, and only that file feeds the variable.
# Every zsh reads this file, so every zsh child inherits the token; the managed Claude settings withhold
# the variable and the file from sandboxed commands (sandbox.credentials, U68). Under a Seatbelt read deny
# the file test fails, so a sandboxed zsh on macOS exports nothing and prints nothing.
if [[ -r "${HOME}/.config/claude-code/oauth-token" ]]; then
    __claude_code_oauth="$(< "${HOME}/.config/claude-code/oauth-token")"
    # A plain assignment never word-splits, so the value needs no quotes.
    if [[ -n "${__claude_code_oauth}" ]]; then
        CLAUDE_CODE_OAUTH_TOKEN=${__claude_code_oauth}
        export CLAUDE_CODE_OAUTH_TOKEN
    fi
    unset __claude_code_oauth
fi

typeset -gU path PATH
path=(
    "${HOME}/.local/share/mise/shims"
    "${HOME}/.local/bin"
    "${HOME}/.local/bin/common"
    /opt/homebrew/bin(N-/)
    /opt/homebrew/sbin(N-/)
    /usr/local/bin(N-/)
    /usr/local/sbin(N-/)
    "${path[@]}"
)
export PATH

readonly ZSHENV_PRIVATE="${HOME}/.zshenv_private"

if [[ -r "${ZSHENV_PRIVATE}" ]]; then
    source "${ZSHENV_PRIVATE}"
fi
