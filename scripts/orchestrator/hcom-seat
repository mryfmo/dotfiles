case ${role_launch} in
hcom)
    # The extension the role's model route needs first, the optional one second.
    exts=("${bridge}" "${siwc}")
    profile_config=none
    ((! dsh_options)) || refuse '--profile, --home and -- are options of the dsh and router roles'
    ;;
foreground)
    exts=()
    profile_config=${HOME}/.agents/omp/profiles/${omp_profile}.yml
    ((${#user_exts[@]} == 0)) || refuse '--ext is an option of the omp roles'
    dsh_home=${dsh_home:-${DSH_HOME:-${HOME}/.dsh}}
    [[ -z ${profile_name} || ${profile_name} =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] ||
        refuse "profile '${profile_name}' is outside ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}\$"
    # A row that fixes the profile runs that profile alone: the router role's grants exist for the Router, so another
    # profile under them would hold the loopback grant without the listener the grant is for. The verbatim dsh
