#!/bin/bash
# @file hcom-seat
# @brief Start one omp seat for a role in a herdr pane through `hcom omp`, with its profile, policy overlay and extensions wired in.
# @description
#   Plan 025 W5b (U7), the minimal form before X. A seat is one omp process that
#   `hcom omp` starts in a herdr pane (`hcom omp --help`: `hcom [N] omp [args...]`,
#   `--tag <name>`, `--dir <path>`, `--terminal <preset>`; hcom gives the seat
#   HCOM_LAUNCHED=1, HCOM_TAG and HCOM_DIR). For `<role>` the launch line is
#   `hcom omp --tag <name> --dir <dir> --terminal herdr --go -- --profile <role>
#   --config ~/.agents/omp/policies/<role>.yml --config ~/.agents/omp/profiles/<role>.yml
#   -e <ext>...`; hcom drops the `--` and forwards what follows to omp verbatim
#   (hcom 0.7.30 and 0.7.31, measured 2026-10-23 and 2026-10-24; `extract_launch_flags`,
#   `src/commands/launch.rs:572-581` at v0.7.30). `--go`
#   is hcom's launch gate: inside an AI tool, hcom without it prints `== LAUNCH
#   PREVIEW == / Add --go to proceed.` and starts nothing (`launch.rs:48,388-389`,
#   measured on the real host 2026-10-23), and `extract_launch_flags` consumes it
#   only before the `--` (`launch.rs:650-652`). The profile equals the role. A
#   named profile reads its own `~/.omp/profiles/<role>/agent/config.yml`
#   (pi-utils `src/dirs.ts:312-315`, U10),
#   so the manifest's `modelRoles.default` and `skills.customDirectories` reach the
#   seat only through the second overlay, rendered per role (U14); the first overlay
#   owns the approval mode (U6). Both are required. The extensions default to the
#   pi-claude-bridge, which the role's model route needs, plus the openai-siwc when it
#   is present; `--ext` replaces that list. There is no audit seat: every audit is one
#   fresh `omp-run.sh --role audit` run (regime-cutover U57, U58). The stop gate's directory
#   `~/.agents/omp/hooks` is loaded on every launch, whatever `--ext` says, and the
#   launch line ends with `--hcom-team <HCOM_TEAM>`: hcom passes HCOM_DIR into the
#   pane but not HCOM_TEAM, so the flag, which the gate registers, carries exactly the
#   team this launch was given, an explicit one included (regime-cutover U33c; omp
#   refuses the flag when no loaded extension registers it, so a launch without the
#   gate fails instead of running unguarded). Every directory, a default, `--ext` or
#   the gate's, must resolve to an entry of `claude.levers.extensions` in the manifest
#   the self-check reads (regime-cutover U31), else the launch is refused. The
#   orchestrator sits in the repository
#   this command runs in; every other role gets the worktree `<seats-root>/<name>`,
#   which is created detached from `origin/main` (HEAD in a repository without it)
#   when absent and reused when it is a worktree of this repository (any other
#   directory at that path is refused). HCOM_DIR, HCOM_TEAM and the seats root come
#   from the environment or `--seats-root` when set, else from the checkout through
#   the sourced regime-env helper (regime-cutover U33: `~/.local/state/hcom/<slug>`,
#   `<slug>`, `~/.local/state/omp-seats/<slug>`), and are exported to the seat.
#   The seat's omp runs under OS containment (regime-cutover U85): Anthropic's sandbox-runtime `srt`
#   (sandbox-exec on macOS, bubblewrap on Linux) with per-seat settings, through an `omp` shim at
#   `<seats-root>/.sandbox/<name>/bin/omp` that is put first on PATH, so hcom pins it as the pane's tool;
#   the shim runs a canary under the settings and refuses to start omp unless a write into the sandbox
#   directory and reads of the settings and `~/.ssh` fail inside (seat_sandbox_write below). srt and omp
#   run by their physical argv (pin_exec), and so do hcom (exec'd by it) and herdr (through wrappers in the
#   shim directory); none of their files may be or lie under a write root of any seat.
#   No caller PATH entry runs anything: the first statement sets PATH to the system directories (jq is
#   /usr/bin/jq), the complete protected set is built by (device, inode) identity before mise or any other
#   tool runs, and the tools beyond them (git, hcom, herdr, omp, srt, node, bun, claude; bwrap, socat and
#   rg on Linux) are resolved through `mise which` under `env -i` from `/`, else `command -v` on the
#   caller's PATH, checked (absolute, no control character, an executable regular file, no shim, neither
#   it nor a directory above it with the identity of a seat write root) and linked into
#   `~/.local/state/hcom-seat/tools`; PATH is then that directory and the system
#   directories, for hcom-seat, hcom, the shim and srt (whose Linux settings name bwrap, socat and rg).
#   Inside the sandbox omp gets that PATH followed by the caller's absolute entries.
#   Every executable is checked with its interpreter chain, and hcom-seat, the shim and the wrappers run
#   under `#!/bin/bash`. The git state host git reads for this repository's worktrees (config,
#   config.worktree, info, hooks, commondir, gitdir, the worktree's .git file) is denied to every seat,
#   and a launch over such state holding a key host git would act on is refused (git_state_check) before
#   the first git command; every git command hcom-seat runs has hooks, fsmonitor and worktree config off.
#   Every program's seats root is read-denied but the seat's own paths.
#   No seat launches a seat: the orchestrator's sandbox, like the worker's, has no herdr socket and no
#   write to the seats root, and a launch from inside a seat is refused; seats are started from a
#   terminal outside every seat (the operator or the coordinator, as gate G7 was).
#   Every input is checked before anything is created or started: an unknown role, a launch inside a
#   seat, a name or team outside `^[a-z0-9][a-z0-9_-]{0,63}$`, a store regime-env refuses, an absent
#   policy or profile overlay or extension directory, a cwd outside a git checkout, a required tool
#   that is missing, a shim or a file that is or lies under a seat write root, or no sandbox-exec
#   (macOS) or bubblewrap, socat and ripgrep (Linux)
#   is exit 2 with the reason. `--dry-run` prints the launch line, and the derived environment and
#   sandbox on stderr, and creates and starts nothing but the private tool links. Otherwise hcom's own
#   exit status is returned (`hcom omp --help`:
#   0 ready, 1 launch failed, 2 still launching or blocked on user attention).
# @arg $1 string Role: orchestrator or worker.
# @option --name <name> Seat name, passed as the hcom tag (default: the role; `<role>-<n>` for a second seat of a role).
# @option --seats-root <dir> Parent of the seat worktrees (default: ~/.local/state/omp-seats/<slug>, regime-env).
# @option --ext <dir> Extension directory in claude.levers.extensions, repeatable; replaces the role's default list.
# @option --dry-run Print the launch line and exit 0 without creating a worktree or starting hcom.
# @env HCOM_DIR The program's private hcom store (default: ~/.local/state/hcom/<slug>, regime-env).
# @env HCOM_TEAM The team thread (default: the repository slug, regime-env); passed to the seat as --hcom-team.
# @stdout The launch line with --dry-run, else hcom's output.
# @exitcode 0 Dry run printed, or hcom reports the seat ready.
# @exitcode 2 A refusal, before anything is created or started.
# @exitcode * hcom's own status otherwise.
# @example
#   HCOM_DIR=/path/to/.hcom scripts/orchestrator/hcom-seat worker --name worker-2 --dry-run
set -euo pipefail
# No caller PATH entry runs anything (regime-cutover U85): before the first external command PATH holds the fixed
# system directories only, and the tools hcom-seat needs beyond them are resolved below into a private directory.
caller_path=${PATH:-}
system_path=/usr/bin:/bin:/usr/sbin:/sbin
PATH=${system_path}

# @description Refuse to run unless this file's sha256 equals its pin in the manifest beside it (regime-cutover U31):
#   `~/.agents/agent-config.yaml` for the installed copy under ~/.local/bin/common, which a sandboxed session cannot
#   write, else the checkout's home/dot_agents/agent-config.yaml. Every read is checked; a failure exits 2 naming the
#   file. The pin is the `claude.levers.sha256.<name>` line, which `scripts/generate-agent-configs.py` refreshes.
# @set LEVER_MANIFEST The manifest the pin came from.
# @set LEVER_DIR The physical directory of this file, where the sourced regime-env helper sits (U33).
lever_self_check() {
    local src dir self name pin digest home
    # The directory is split from the path in the shell, so no external producer (dirname) can fail unseen.
    src=${BASH_SOURCE[0]}
    case ${src} in
    */*) dir=${src%/*} ;;
    *) dir=. ;;
    esac
    [[ -n ${dir} ]] || dir=/
    dir=$(cd "${dir}" && pwd -P) || {
        echo "${src##*/}: refused: cannot resolve the script directory of ${src}" >&2
        exit 2
    }
    self=${dir}/${BASH_SOURCE[0]##*/}
    # shellcheck disable=SC2034 # read by the levers that source regime-env from this directory
    LEVER_DIR=${dir}
    name=${self##*/}
    home=$(cd "${HOME}" 2> /dev/null && pwd -P) || home=''
    if [[ -n ${home} && ${dir} == "${home}/.local/bin/common" ]]; then # lint-comparisons: allow both sides are pwd -P forms
        LEVER_MANIFEST=${HOME}/.agents/agent-config.yaml
    else
        LEVER_MANIFEST=${dir}/../../home/dot_agents/agent-config.yaml
    fi
    [[ -r ${LEVER_MANIFEST} ]] || {
        echo "${name}: refused: manifest unreadable: ${LEVER_MANIFEST}" >&2
        exit 2
    }
    pin=$(sed -n -E "s/^      ${name//./\\.}: ([0-9a-f]{64})\$/\\1/p" "${LEVER_MANIFEST}") || {
        echo "${name}: refused: cannot read ${LEVER_MANIFEST}" >&2
        exit 2
    }
    [[ ${pin} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: no single sha256 pin for ${name} in ${LEVER_MANIFEST}" >&2
        exit 2
    }
    if command -v sha256sum > /dev/null; then
        digest=$(sha256sum < "${self}") || digest=''
    else
        digest=$(shasum -a 256 < "${self}") || digest=''
    fi
    digest=${digest%% *}
    [[ ${digest} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: cannot hash ${self}" >&2
        exit 2
    }
    [[ ${digest} == "${pin}" ]] || {
        echo "${name}: refused: sha256 ${digest} of ${self} differs from the pin in ${LEVER_MANIFEST}" >&2
        exit 2
    }
}
lever_self_check

usage='usage: hcom-seat <orchestrator|worker> [--name <name>] [--seats-root <dir>] [--ext <dir>]... [--dry-run]'
refuse() {
    echo "hcom-seat: $*" >&2
    exit 2
}

(($# >= 1)) || refuse "${usage}"
role=$1
shift
name=${role} seats_root='' dry_run=0 user_exts=()
while (($#)); do
    case $1 in
    --dry-run) dry_run=1 ;;
    --name | --seats-root | --ext)
        (($# >= 2)) || refuse "${usage}"
        case $1 in
        --name) name=$2 ;;
        --seats-root) seats_root=$2 ;;
        --ext) user_exts+=("$2") ;;
        esac
        shift
        ;;
    *) refuse "${usage}" ;;
    esac
    shift
done

bridge=${HOME}/.local/lib/omp-extensions/pi-claude-bridge
siwc=${HOME}/.agents/omp/extensions/openai-siwc
gate=${HOME}/.agents/omp/hooks
# The extension the role's model route needs first, the optional one second.
case ${role} in
orchestrator | worker) exts=("${bridge}" "${siwc}") ;;
*) refuse "unknown role '${role}'; expected orchestrator or worker" ;;
esac
[[ ${name} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "name '${name}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"
# A seat never launches a seat (regime-cutover U85): a launch is the operator's or the coordinator's step from a
# terminal outside every seat (gate G7). hcom marks the seat's environment and the shim marks its own; the
# filesystem probe after the seats root is known catches a seat that unset them.
for marker in HCOM_LAUNCHED HCOM_PROCESS_ID HCOM_SEAT_SANDBOX; do
    [[ -z ${!marker:-} ]] || refuse "refused inside a seat (${marker} is set): launch seats from a terminal outside every seat"
done

# @description Print the physical form of the absolute path `$1`: every symlink followed (at most 40 in all) and the
#   directory in its `pwd -P` form. A path that does not exist yet is its nearest existing ancestor's physical form
#   with the rest appended, so a write root a launch has not created yet still compares with what it will be. Only
#   shell builtins and `/usr/bin/readlink` run.
# @arg $1 string An absolute path.
# @stdout The physical path.
# @exitcode 1 Not absolute, a control character in it or in a link, a link loop, or a directory that cannot be
#   resolved.
physical_path() {
    local p=$1 tail='' link dir n=0
    [[ ${p} == /* && ${p} != *[[:cntrl:]]* ]] || return 1 # lint-comparisons: allow an absolute-path and content test
    while [[ ! -e ${p} && ! -L ${p} ]]; do
        tail=/${p##*/}${tail}
        p=${p%/*}
        [[ -n ${p} ]] || p=/
    done
    while [[ -L ${p} ]]; do
        n=$((n + 1))
        ((n <= 40)) || return 1
        # The '.' keeps a target's own trailing newlines from the command substitution.
        link=$(/usr/bin/readlink "${p}" && printf .) || return 1
        link=${link%.}
        link=${link%$'\n'}
        [[ ${link} != *[[:cntrl:]]* ]] || return 1
        case ${link} in
        /*) p=${link} ;;
        *) p=${p%/*}/${link} ;;
        esac
    done
    if [[ ! -e ${p} ]]; then
        # A dangling link: resolve what it names, which does not exist yet.
        p=$(physical_path "${p}") || return 1
        printf '%s%s\n' "${p%/}" "${tail:-}"
    elif [[ -d ${p} ]]; then
        dir=$(cd "${p}/" && pwd -P) || return 1
        printf '%s%s\n' "${dir%/}" "${tail:-}"
    else
        dir=$(cd "${p%/*}/" && pwd -P) || return 1
        printf '%s/%s%s\n' "${dir%/}" "${p##*/}" "${tail}"
    fi
}

# @description Print the physical file `$1` names (physical_path); it must be a regular executable file.
# @arg $1 string An absolute path.
# @stdout The physical path.
# @exitcode 1 physical_path failed, or the result is not a regular executable file.
physical_file() {
    local p
    p=$(physical_path "$1") || return 1
    [[ -f ${p} && -x ${p} ]] || return 1
    printf '%s\n' "${p}"
}

# @description Refuse (exit 2) when the physical path `$2`, or any directory above it, has the identity of a
#   protected write root (`root_ids`).
# @arg $1 string A label for the refusal.
# @arg $2 string A physical path.
refuse_if_seat_writable() {
    local p=$2 ids id i named probe=()
    # The physical file and every directory above it, up to /, each compared by (device, inode): a case alias on a
    # case-insensitive file system or a hardlink of a writable file has the identity of what it aliases.
    while :; do
        probe+=("${p}")
        [[ ${p} != / ]] || break # lint-comparisons: allow the walk ends at the root, no path compare
        p=${p%/*}
        [[ -n ${p} ]] || p=/
    done
    ids=$(/usr/bin/stat "${stat_args[@]}" -- "${probe[@]}") || refuse "cannot read the identity of $1 $2 or a directory above it"
    i=0
    while IFS= read -r id; do
        if [[ ${root_ids} == *$'\n'"${id}"$'\n'* ]]; then # lint-comparisons: allow compares (device, inode) identities, not paths
            named=$(root_named "${id}") || named=${id}
            refuse "$1 $2 is or lies under the seat write root ${named} (${probe[i]} has its identity ${id})"
        fi
        i=$((i + 1))
    done <<< "${ids}"
}

# @description Print the write root whose identity is `$1`.
# @arg $1 string A `<device>:<inode>` identity.
root_named() {
    local i
    for ((i = 0; i < ${#root_id_list[@]}; i++)); do
        [[ ${root_id_list[i]} != "$1" ]] || { # lint-comparisons: allow compares (device, inode) identities, not paths
            printf '%s\n' "${root_path_list[i]}"
            return 0
        }
    done
}

# @description Add the (device, inode) identity of every argument that exists, file or directory, every link
#   followed, to the protected set (`root_ids`, `root_id_list`, `root_path_list`). A path that does not exist holds
#   no executable; one that exists and cannot be read is a refusal.
# @arg $@ string Absolute paths.
add_roots() {
    local present=() path ids id i=0
    for path in "$@"; do
        [[ ${path} == /* && ${path} != *[[:cntrl:]]* ]] || refuse "the seat write root '${path}' is not an absolute path" # lint-comparisons: allow an absolute-path and content test
        [[ -e ${path} || -L ${path} ]] || continue
        present+=("${path}")
    done
    ((${#present[@]})) || return 0
    ids=$(/usr/bin/stat "${stat_args[@]}" -- "${present[@]}") || refuse "cannot read the identity of a seat write root among: ${present[*]}"
    while IFS= read -r id; do
        [[ ${id} =~ ^[0-9]+:[0-9]+$ ]] || refuse "unexpected identity '${id}' of ${present[i]}"
        root_ids+=${id}$'\n'
        root_id_list+=("${id}")
        root_path_list+=("$(physical_path "${present[i]}" || printf '%s' "${present[i]}")")
        i=$((i + 1))
    done <<< "${ids}"
}

# @description Succeed when a tool is a shim, as scripts/orchestrator/ci-rerun.sh decides it (U61): its physical file
#   is named mise in any letter case or is the mise binary, or the directory it was found in or resolves to is named
#   shims in any letter case. A mise shim picks its version from the cwd's config files, which a seat writes.
# @arg $1 string The path the tool was found at.
# @arg $2 string Its physical path.
is_shim() {
    local d
    [[ ${2##*/} == [Mm][Ii][Ss][Ee] ]] && return 0 # lint-comparisons: allow a file-name test, not a comparison of two paths
    [[ -n ${mise_real} && $2 -ef ${mise_real} ]] && return 0
    for d in "${1%/*}" "${2%/*}"; do
        d=$(physical_path "${d:-/}") || return 0
        [[ ${d}/ == */[Ss][Hh][Ii][Mm][Ss]/* ]] && return 0 # lint-comparisons: allow a directory-name test, not a comparison of two paths
    done
    return 1
}

# @description Print the first executable `$1` on PATH, which hcom-seat has set: the system directories, then the
#   private tool directory before them once it is filled.
# @arg $1 string The command name.
# @stdout The path, symlinks not yet followed.
# @exitcode 1 None found.
find_on_path() {
    local path_dir path_dirs=()
    IFS=: read -r -a path_dirs <<< "${PATH}"
    for path_dir in "${path_dirs[@]}"; do
        [[ -n ${path_dir} && -x ${path_dir}/$1 && ! -d ${path_dir}/$1 ]] || continue
        printf '%s\n' "${path_dir}/$1"
        return 0
    done
    return 1
}

# @description Resolve `$2` to the argv that runs it with no lookup left: its physical file, preceded by the physical
#   interpreter when it is a `#!` script (`#!/abs/interp` or `#!/usr/bin/env <name>`, no arguments; an interpreter
#   that is itself a script is refused). No part may be, or lie under, a write root of any seat (`root_ids`), since
#   a seat that could rewrite a file the launch runs would run uncontained on the next launch. A failure exits 2
#   naming `$1`.
# @arg $1 string A label for the refusal.
# @arg $2 string The executable's path.
# @set pinned The argv.
pin_exec() {
    local label=$1 file first interp name extra interp_path
    file=$(physical_file "$2") || refuse "cannot resolve ${label} to a physical executable file: $2"
    refuse_if_seat_writable "${label}" "${file}"
    [[ -r ${file} ]] || refuse "cannot read ${label}: ${file}"
    first=''
    IFS= read -r first < "${file}" || [[ -n ${first} ]] || first=''
    pinned=("${file}")
    case ${first} in
    '#!'*)
        extra=''
        read -r interp name extra <<< "${first#??}"
        if [[ ${interp} == /usr/bin/env ]]; then # lint-comparisons: allow the literal interpreter line, no path compare
            [[ -n ${name} && -z ${extra} && ${name} != -* ]] ||
                refuse "${label}: unsupported interpreter line '${first}' in ${file}"
            interp_path=$(find_on_path "${name}") || refuse "${label}: interpreter ${name} not found on PATH"
        else
            [[ -z ${name} ]] || refuse "${label}: unsupported interpreter line '${first}' in ${file}"
            interp_path=${interp}
        fi
        interp=$(physical_file "${interp_path}") || refuse "cannot resolve the interpreter of ${label}: ${interp_path}"
        refuse_if_seat_writable "${label}" "${interp}"
        [[ -r ${interp} ]] || refuse "cannot read the interpreter of ${label}: ${interp}"
        first=''
        IFS= read -r first < "${interp}" || [[ -n ${first} ]] || first=''
        [[ ${first} != '#!'* ]] || refuse "${label}: its interpreter ${interp} is itself a script"
        pinned=("${interp}" "${file}")
        ;;
    esac
}

# The tools (regime-cutover U85, the pattern of scripts/orchestrator/ci-rerun.sh, U61). First the complete protected
# set, by identity: the (device, inode) of every write root any seat may have that exists, files and directories,
# computed with builtins, /usr/bin/stat, /usr/bin/readlink and the system jq only, before any tool outside the
# system directories runs. It holds the seats roots and the hcom stores of every program, ~/Workspace, the checkout
# this runs in and its git directories, the omp profiles and leases, the Claude Code state, srt's implicit write paths,
# and every `allowWrite` entry of every existing seat settings file (another program's checkout outside ~/Workspace
# included). Then mise's own physical file is held to it before mise runs. Every tool beyond the system directories
# is what `mise which` answers under `env -i` from `/` (no project config, no caller environment), else what
# `command -v` finds on the caller's PATH; an answer is only a name until it passes: absolute, no control character,
# a regular executable file once every link is followed, no shim, and neither its physical file nor any directory
# above it has the identity of a protected root. A passing tool is linked into the private directory
# ~/.local/state/hcom-seat/tools (0700, this user's, outside every seat write root), and PATH becomes that directory
# followed by the system directories; no caller entry is inherited.
system_jq=/usr/bin/jq
[[ -x ${system_jq} ]] || refuse "the system jq ${system_jq} is absent; it reads and writes the seat sandbox settings"
os=$(/usr/bin/uname -s) || refuse 'cannot read the operating system name (uname -s)'
case ${os} in
Darwin) stat_args=(-L -f '%d:%i') ;;
Linux) stat_args=(-L -c '%d:%i') ;;
*) refuse "no seat sandbox for ${os}; srt supports macOS and Linux" ;;
esac
root_ids=$'\n' root_id_list=() root_path_list=()
roots=("${HOME}/.local/state/omp-seats" "${HOME}/.local/state/hcom" "${HOME}/Workspace" "${HOME}/.omp/profiles"
    "${HOME}/.omp/run" "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}" "${HOME}/.claude" "${HOME}/.claude.json"
    "${HOME}/.npm/_logs" /tmp/claude /private/tmp/claude)
for root in ${HCOM_DIR:+"${HCOM_DIR}"} ${REGIME_SEATS_ROOT:+"${REGIME_SEATS_ROOT}"} ${seats_root:+"${seats_root}"}; do
    case ${root} in # lint-comparisons: allow a relative operand is made absolute against the cwd, no path compare
    /*) roots+=("${root}") ;;
    *) roots+=("${PWD}/${root}") ;;
    esac
done
# The checkout this runs in, found with builtins: the nearest ancestor with a `.git`, and for a worktree the git
# directory its `.git` file names and that directory's common directory and main checkout.
cwd_real=$(pwd -P) || refuse 'cannot resolve the working directory'
top=${cwd_real}
while [[ ! -e ${top}/.git && -n ${top} ]]; do top=${top%/*}; done
if [[ -n ${top} || -e /.git ]]; then
    top=${top:-/}
    gitdir=${top}/.git
    if [[ -f ${gitdir} ]]; then
        IFS= read -r line < "${gitdir}" || [[ -n ${line:-} ]] || refuse "cannot read ${gitdir}"
        gitdir=${line#gitdir: }
        case ${gitdir} in # lint-comparisons: allow a relative operand is made absolute, no path compare
        /*) ;;
        *) gitdir=${top}/${gitdir} ;;
        esac
    fi
    common_guess=${gitdir}
    if [[ -f ${gitdir}/commondir ]]; then
        IFS= read -r line < "${gitdir}/commondir" || [[ -n ${line:-} ]] || refuse "cannot read ${gitdir}/commondir"
        case ${line} in # lint-comparisons: allow a relative operand is made absolute, no path compare
        /*) common_guess=${line} ;;
        *) common_guess=${gitdir}/${line} ;;
        esac
    fi
    roots+=("${top}" "${gitdir}" "${common_guess}" "${common_guess%/*}")
fi
# Every existing seat settings file, read by the system jq; an entry that cannot be read is a refusal.
for settings_file in ${seats_root:+"${seats_root%/}"/.sandbox/*/srt-settings.json} \
    ${REGIME_SEATS_ROOT:+"${REGIME_SEATS_ROOT%/}"/.sandbox/*/srt-settings.json} \
    "${HOME}"/.local/state/omp-seats/*/.sandbox/*/srt-settings.json; do
    [[ -e ${settings_file} ]] || continue
    listed=$(/usr/bin/jq -er '.filesystem.allowWrite[] | strings' "${settings_file}") ||
        refuse "cannot read the allowWrite list of ${settings_file}"
    while IFS= read -r root; do
        if [[ -n ${root} ]]; then roots+=("${root}"); fi
    done <<< "${listed}"
done
add_roots "${roots[@]}"
tools_dir=${HOME}/.local/state/hcom-seat/tools
/bin/mkdir -p "${tools_dir}" || refuse "cannot create the private tool directory ${tools_dir}"
/bin/chmod 700 "${tools_dir%/*}" "${tools_dir}" || refuse "cannot restrict the private tool directory ${tools_dir}"
for dir_check in "${tools_dir%/*}" "${tools_dir}"; do
    [[ -d ${dir_check} && ! -L ${dir_check} && -O ${dir_check} ]] ||
        refuse "the private tool directory ${dir_check} is not this user's own directory"
done
tools_dir=$(physical_path "${tools_dir}") || refuse "cannot resolve the private tool directory ${tools_dir}"
[[ ${tools_dir} != *:* ]] || refuse "the private tool directory ${tools_dir} holds a ':'" # lint-comparisons: allow a ':' content test
refuse_if_seat_writable 'the private tool directory' "${tools_dir}"
# mise runs only once its physical file and its interpreter chain have passed the complete protected set above, and
# it runs by the argv that check pinned.
mise_cmd=()
mise_real=''
mise_found=$(PATH=${caller_path} && command -v mise && printf .) && mise_found=${mise_found%.} &&
    mise_found=${mise_found%$'\n'} && mise_real=$(physical_file "${mise_found}") || mise_real=''
if [[ -n ${mise_real} ]]; then
    pin_exec mise "${mise_real}"
    mise_cmd=("${pinned[@]}")
fi
# jq is the system's (/usr/bin/jq), not a resolved tool, so a stale link of an earlier launch is dropped.
/bin/rm -f "${tools_dir}/jq" || refuse "cannot clear ${tools_dir}/jq"
required_tools=(git hcom herdr omp srt)
optional_tools=(node bun claude)
case ${OSTYPE} in
linux*) required_tools+=(bwrap socat rg) ;;
esac
for tool in "${required_tools[@]}" "${optional_tools[@]}"; do
    found=$(cd / && {
        { [[ -n ${mise_real} ]] && /usr/bin/env -i PATH="${system_path}" HOME="${HOME}" "${mise_cmd[@]}" which "${tool}" 2> /dev/null; } ||
            { PATH=${caller_path} && command -v "${tool}"; }
    } && printf .) || found=''
    found=${found%.}
    found=${found%$'\n'}
    real=''
    if [[ -n ${found} ]]; then
        real=$(physical_file "${found}") || refuse "${tool} is not an executable file ('${found}')"
        ! is_shim "${found}" "${real}" || refuse "no ${tool} outside a shims directory ('${found}')"
        refuse_if_seat_writable "${tool}" "${real}"
    fi
    if [[ -z ${real} ]]; then
        for required in "${required_tools[@]}"; do
            [[ ${tool} != "${required}" ]] || refuse "${tool} not found (mise which, then the caller's PATH); run make update"
        done
        /bin/rm -f "${tools_dir}/${tool}" || refuse "cannot clear ${tools_dir}/${tool}"
        continue
    fi
    if ! /bin/rm -f "${tools_dir}/.${tool}.$$" || ! /bin/ln -s -- "${real}" "${tools_dir}/.${tool}.$$" ||
        ! /bin/mv -f -- "${tools_dir}/.${tool}.$$" "${tools_dir}/${tool}"; then
        refuse "cannot link ${tool} into ${tools_dir}"
    fi
done
PATH=${tools_dir}:${system_path}
# Every linked tool's interpreter chain (`#!/abs/interp`, or `#!/usr/bin/env X` with X looked up on this PATH, as it
# will be when the tool runs) passes the same identity check before anything runs it; git runs next (regime-env).
for link in "${tools_dir}"/*; do
    [[ -e ${link} || -L ${link} ]] || continue
    pin_exec "${link##*/}" "${link}"
done
# Inside the sandbox the seat works with its tools (gh, uv, linters) from the caller's absolute PATH entries after
# these; every process there is contained, and nothing outside the sandbox runs from that list.
seat_path=${PATH}
IFS=: read -r -a caller_dirs <<< "${caller_path}"
for caller_dir in "${caller_dirs[@]}"; do
    if [[ ${caller_dir} == /* && ${caller_dir} != *[[:cntrl:]]* ]]; then seat_path+=:${caller_dir}; fi # lint-comparisons: allow an absolute-path and content test
done

# @description Collect the git state host git reads for the worktrees of this repository into `git_state`, make sure
#   each file exists, and refuse (exit 2) a launch over state a seat may have written. The set: the common `config`,
#   `config.worktree`, `info/` and `hooks/`; for every linked worktree `worktrees/<n>/config.worktree`, `info/`,
#   `commondir` and `gitdir`; and the seat worktree's own `.git` file. None may be a symbolic link. Every
#   `config.worktree` may hold only the keys `git sparse-checkout` writes (`core.sparseCheckout`,
#   `core.sparseCheckoutCone`): anything else (`core.fsmonitor`, `core.hooksPath`, `filter.*`, `diff.*.textconv`,
#   `include.*`, `includeIf.*`, `extensions.*` among them) is a refusal, read with `git config --no-includes`, which
#   runs nothing the file names. Every `commondir` must lead to this common directory, and the seat worktree's
#   `.git` file into its `worktrees/`. An absent `config.worktree` is created empty and an absent `info/` or `hooks/`
#   empty, which git reads as no setting.
#   It runs before the first host git command (with the seat directory empty) and again before each git command in
#   the seat directory and when the settings are written.
# @arg $1 string The physical git common directory.
# @arg $2 string The physical seat directory, or empty.
# @set git_state The paths, for the seat's write denies.
git_state_check() {
    local common_real=$1 dir_real=$2 wt f names name line target
    git_state=("${common_real}/config" "${common_real}/config.worktree" "${common_real}/info" "${common_real}/hooks")
    for wt in "${common_real}"/worktrees/*/; do
        [[ -d ${wt} ]] || continue
        wt=${wt%/}
        git_state+=("${wt}/config.worktree" "${wt}/info")
        for f in commondir gitdir; do
            if [[ -e ${wt}/${f} || -L ${wt}/${f} ]]; then git_state+=("${wt}/${f}"); fi
        done
        if [[ -e ${wt}/commondir ]]; then
            IFS= read -r line < "${wt}/commondir" || [[ -n ${line:-} ]] || refuse "cannot read ${wt}/commondir"
            case ${line} in # lint-comparisons: allow a relative operand is made absolute, no path compare
            /*) target=${line} ;;
            *) target=${wt}/${line} ;;
            esac
            [[ ${target} -ef ${common_real} ]] || refuse "${wt}/commondir leads to ${line}, not to ${common_real}"
        fi
    done
    if [[ -n ${dir_real} && -f ${dir_real}/.git ]]; then
        git_state+=("${dir_real}/.git")
        IFS= read -r line < "${dir_real}/.git" || [[ -n ${line:-} ]] || refuse "cannot read ${dir_real}/.git"
        target=${line#gitdir: }
        [[ ${target%/*} -ef ${common_real}/worktrees ]] ||
            refuse "${dir_real}/.git leads to ${target}, outside ${common_real}/worktrees"
    fi
    for f in "${git_state[@]}"; do
        [[ ! -L ${f} ]] || refuse "the git state ${f} is a symbolic link"
        case ${f##*/} in
        info | hooks) [[ -d ${f} ]] || /bin/mkdir -p "${f}" || refuse "cannot create ${f}" ;;
        config.worktree) [[ -f ${f} ]] || : >> "${f}" || refuse "cannot create ${f}" ;;
        esac
    done
    for f in "${git_state[@]}"; do
        [[ ${f##*/} == config.worktree ]] || continue
        # From /, so no repository around the cwd is discovered or read; git() adds the overrides.
        names=$(cd / && git config --file "${f}" --no-includes --name-only --list) ||
            refuse "cannot read the git config ${f}"
        while IFS= read -r name; do
            case ${name} in
            '' | core.sparsecheckout | core.sparsecheckoutcone) ;;
            *) refuse "the git config ${f} sets ${name}, which host git would act on; a seat may have written it" ;;
            esac
        done <<< "${names}"
    done
}

# @description Run git with nothing a repository's config or hooks name: no hooks (`core.hooksPath=/dev/null`), no
#   fsmonitor program, no per-worktree config, no transport, and no system config (regime-cutover U85). Every host git
#   command of hcom-seat and the sourced regime-env goes through this function, before and after the git state is
#   checked.
# @arg $@ string git's arguments.
git() {
    GIT_CONFIG_NOSYSTEM=1 command git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        -c extensions.worktreeConfig=false -c protocol.allow=never "$@"
}

# The git state is checked before the first git command: the common directory found with builtins above.
if [[ -n ${top} || -e /.git ]]; then
    early_common=$(physical_path "${common_guess}") || refuse "cannot resolve the git common directory ${common_guess}"
    [[ -d ${early_common} ]] || refuse "the git common directory ${early_common} is not a directory"
    git_state_check "${early_common}" ''
fi

# HCOM_DIR, HCOM_TEAM and the seats root come from the environment when set, else from this checkout (regime-env,
# regime-cutover U33). hcom passes HCOM_DIR into the seat but not HCOM_TEAM, so the team rides --hcom-team below.
[[ -r ${LEVER_DIR}/regime-env ]] || refuse "regime-env unreadable beside this script: ${LEVER_DIR}/regime-env"
# shellcheck source=scripts/orchestrator/regime-env
. "${LEVER_DIR}/regime-env"
regime_env hcom-seat || exit 2
command -v hcom > /dev/null || refuse 'hcom not found on PATH'
[[ ${HCOM_TEAM:-} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "team '${HCOM_TEAM:-}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"
policy=${HOME}/.agents/omp/policies/${role}.yml
profile=${HOME}/.agents/omp/profiles/${role}.yml
[[ -f ${policy} ]] || refuse "policy overlay absent: ${policy}"
[[ -f ${profile} ]] || refuse "profile overlay absent: ${profile}"
if ((${#user_exts[@]})); then
    exts=("${user_exts[@]}")
elif [[ ! -d ${exts[1]} ]]; then
    exts=("${exts[0]}")
fi
# The stop gate rides every launch, after the route's extensions; --ext never drops it (U33c).
exts+=("${gate}")
# The extension allow-list (regime-cutover U31): claude.levers.extensions in the manifest the self-check read, so the
# installed copy reads it from ~/.agents, outside every sandbox write root. A read failure is a refusal, not an empty list.
allowed=$(awk '
    /^  levers:$/ { levers = 1; next }
    levers && /^  [^ ]/ { levers = 0 }
    levers && /^    extensions:$/ { list = 1; next }
    list && /^      - / { sub(/^      - /, ""); print; next }
    list { list = 0 }
' "${LEVER_MANIFEST}") || refuse "cannot read the extension allow-list in ${LEVER_MANIFEST}"
[[ -n ${allowed} ]] || refuse "no extension allow-list (claude.levers.extensions) in ${LEVER_MANIFEST}"
# The launch passes the canonical allow-list entry (`pwd -P` of the listed path), never the caller's spelling: a
# symlink the caller controls could be swapped between this check and omp resolving `-e`.
checked=()
for ext in "${exts[@]}"; do
    [[ -d ${ext} ]] || refuse "extension directory absent: ${ext}"
    real=$(cd "${ext}" && pwd -P) || refuse "cannot resolve extension directory: ${ext}"
    listed=''
    while IFS= read -r entry; do
        entry=${entry/#\~/${HOME}}
        # An entry that is absent or cannot be resolved lists nothing, so the extension stays refused.
        [[ -d ${entry} ]] || continue
        entry_real=$(cd "${entry}" && pwd -P) || continue
        if [[ ${entry_real} == "${real}" ]]; then listed=${entry_real}; fi # lint-comparisons: allow both sides are pwd -P forms
    done <<< "${allowed}"
    [[ -n ${listed} ]] || refuse "extension directory is not in the allow-list (claude.levers.extensions): ${ext}"
    checked+=("${listed}")
done
exts=("${checked[@]}")
repo=$(git rev-parse --show-toplevel 2> /dev/null) || refuse 'run hcom-seat inside the repository checkout'
common=$(git rev-parse --path-format=absolute --git-common-dir) || refuse "cannot read the git common directory of ${repo}"
seats_root=${seats_root:-${REGIME_SEATS_ROOT:-}}
[[ -n ${seats_root} ]] || refuse 'no seats root: pass --seats-root or run inside a checkout'
case ${role} in
orchestrator) dir=${repo} ;;
*) dir=${seats_root}/${name} ;;
esac

# OS containment (regime-cutover U85): the seat's omp runs under Anthropic's sandbox-runtime (`srt`, sandbox-exec on
# macOS, bubblewrap on Linux). hcom pins the `omp` it finds first on this process's PATH as the runner's
# --hcom-tool-path, so a per-seat shim placed first on PATH is what the pane runs; the shim never falls back to an
# uncontained omp. Every prerequisite is checked here, before anything is created or started.
sandbox=${seats_root%/}/.sandbox/${name}
# Every seat's sandbox denies reads of <seats-root>/.sandbox, so a listing that fails means this process runs inside a
# seat that unset the environment markers above.
if [[ -e ${seats_root%/}/.sandbox ]] && ! ls "${seats_root%/}/.sandbox" > /dev/null 2>&1; then
    refuse "refused inside a seat sandbox (${seats_root%/}/.sandbox is unreadable): launch seats from a terminal outside every seat"
fi

# @description Print the srt write roots of one seat, one per line in physical form: the list the seat's settings
#   carry as `allowWrite` (seat_sandbox_write writes exactly this list), followed by the paths srt 0.0.81 makes
#   writable without a listing (`/tmp/claude`, `/private/tmp/claude`, `~/.npm/_logs`, `~/.claude/debug`).
# @arg $1 string The role.
# @arg $2 string The seat name.
# @arg $3 string The seat directory (the worktree, or the checkout for the orchestrator).
# @stdout The roots.
# @exitcode 1 A path could not be resolved.
seat_write_roots() {
    local path claude=${CLAUDE_CONFIG_DIR:-${HOME}/.claude}
    for path in "$3" "${common}" "${HCOM_DIR}" "${HOME}/.omp/profiles/$1" "${HOME}/.omp/run" "${claude}" \
        "${HOME}/.claude.json" "${seats_root%/}/.state/$2" /tmp/claude /private/tmp/claude "${HOME}/.npm/_logs" \
        "${HOME}/.claude/debug"; do
        physical_path "${path}" || return 1
    done
}

# The exact roots (regime-cutover U85): this seat's `allowWrite` list, from the same function that writes the
# settings, so the check and the sandbox cannot drift, and the other role's; the derived seats root and hcom store;
# and every settings file under the derived seats root. Their identities join the set computed before any tool ran
# (which already covers them by their parents); every link, mise included, is then checked again.
seat_write=()
seat_roots_out=$(seat_write_roots "${role}" "${name}" "${dir}") || refuse "cannot resolve the write roots of ${name}"
while IFS= read -r root; do seat_write+=("${root}"); done <<< "${seat_roots_out}"
other_roots=$(seat_write_roots orchestrator orchestrator "${repo}") || refuse 'cannot resolve the orchestrator write roots'
roots=("${seat_write[@]}" "${seats_root}" "${HCOM_DIR}" "${common}")
while IFS= read -r root; do roots+=("${root}"); done <<< "${other_roots}"
for settings_file in "${seats_root%/}"/.sandbox/*/srt-settings.json; do
    [[ -e ${settings_file} ]] || continue
    listed=$(/usr/bin/jq -er '.filesystem.allowWrite[] | strings' "${settings_file}") ||
        refuse "cannot read the allowWrite list of ${settings_file}"
    while IFS= read -r root; do
        if [[ -n ${root} ]]; then roots+=("${root}"); fi
    done <<< "${listed}"
done
add_roots "${roots[@]}"
[[ -z ${mise_real} ]] || PATH=${system_path} pin_exec mise "${mise_real}"

# Every link in the private tool directory, with its interpreter chain, is re-checked against the exact set, and PATH
# is that directory and the system directories, so hcom's own lookups (`herdr`, `node`) and srt's (`env`, the shell)
# find nothing a seat writes.
for link in "${tools_dir}"/*; do
    [[ -e ${link} || -L ${link} ]] || continue
    pin_exec "${link##*/}" "${link}"
done
IFS=: read -r -a path_dirs <<< "${PATH}"
for path_dir in "${path_dirs[@]}"; do
    path_real=$(physical_path "${path_dir}") || refuse "cannot resolve the PATH entry ${path_dir}"
    refuse_if_seat_writable 'the PATH entry' "${path_real}"
done
pinned=()
omp_path=$(find_on_path omp) || refuse 'omp not found in the private tool directory'
pin_exec omp "${omp_path}"
omp_cmd=("${pinned[@]}")
srt_path=$(find_on_path srt) || refuse 'srt (@anthropic-ai/sandbox-runtime) not found in the private tool directory'
pin_exec srt "${srt_path}"
srt_cmd=("${pinned[@]}")
# hcom and the herdr it drives run outside every sandbox: the launch execs hcom by its physical argv, and hcom finds
# `hcom` and `herdr` through the shim directory first on PATH, as wrappers around their physical argv.
hcom_path=$(find_on_path hcom) || refuse 'hcom not found on PATH'
pin_exec hcom "${hcom_path}"
hcom_cmd=("${pinned[@]}")
herdr_path=$(find_on_path herdr) || refuse 'herdr not found on PATH'
pin_exec herdr "${herdr_path}"
herdr_cmd=("${pinned[@]}")
os=$(uname -s) || refuse 'cannot read the operating system name (uname -s)'
linux_tools='{}'
case ${os} in
Darwin) [[ -x /usr/bin/sandbox-exec ]] || refuse 'sandbox-exec absent: /usr/bin/sandbox-exec' ;;
Linux)
    # srt looks bwrap, socat and rg up on PATH unless its settings name them; they name the checked physical files.
    bwrap_real=$(physical_file "${tools_dir}/bwrap") || refuse 'bwrap not found; srt needs bubblewrap on Linux'
    socat_real=$(physical_file "${tools_dir}/socat") || refuse 'socat not found; srt needs socat on Linux'
    rg_real=$(physical_file "${tools_dir}/rg") || refuse 'rg not found; srt needs ripgrep on Linux'
    linux_tools=$(/usr/bin/jq -cn --arg bwrap "${bwrap_real}" --arg socat "${socat_real}" --arg rg "${rg_real}" \
        '{bwrapPath: $bwrap, socatPath: $socat, ripgrep: {command: $rg}}') || refuse 'jq failed on the Linux tool paths'
    ;;
*) refuse "no seat sandbox for ${os}; srt supports macOS and Linux" ;;
esac
# @description Write the seat's srt settings and its `omp` shim under `<seats-root>/.sandbox/<name>` (regime-cutover
#   U85), afresh on every launch, after the seat directory exists. The settings name what the seat may write (its
#   directory, the repository's git common directory, the program's hcom store, its own omp profile and the omp
#   session leases, the Claude Code state the bridge child writes, a per-seat cache root; the same for both roles, so
#   no seat writes the seats root or reaches the herdr socket, and none can start a seat), what it may not change
#   inside those roots (git config and hooks, the hcom store's launch scripts and configuration, agent configuration
#   that runs outside the seat), what it may not read (SSH, GPG, cloud and codex credentials, the chezmoi sources,
#   `~/Workspace` but its own repository, other omp profiles, other hcom stores, every seat's sandbox directory, and
#   for a worker the other seats) and the hosts it may reach. The shim runs a canary under those settings first, a
#   write into the sandbox directory and reads of the settings file and `~/.ssh`, and refuses (exit 2) unless all
#   three fail inside; only then does it run omp under srt, both by the physical argv `pin_exec` checked.
# @noargs
seat_sandbox_write() {
    local h claude dir_real common_real hcom_real seats_real sandbox_real
    local root path settings shim json base sandbox_state origin_url push_url srt_q omp_q
    local write_json deny_write_json deny_read_json allow_read_json
    local write=() deny_write=() deny_read=() allow_read=()
    # srt on Linux grants writes only to paths that exist, so omp's own state directories are made first.
    (umask 077 && mkdir -p "${sandbox}/bin" "${seats_root%/}/.state/${name}" "${HOME}/.omp/profiles/${role}" \
        "${HOME}/.omp/run") || refuse "cannot create the seat sandbox directory ${sandbox} or omp's state directories"
    h=$(physical_path "${HOME}") || refuse "cannot resolve HOME ${HOME}"
    claude=${CLAUDE_CONFIG_DIR:-${h}/.claude}
    dir_real=$(cd "${dir}" && pwd -P) || refuse "cannot resolve the seat directory ${dir}"
    common_real=$(cd "${common}" && pwd -P) || refuse "cannot resolve the git common directory ${common}"
    hcom_real=$(cd "${HCOM_DIR}" && pwd -P) || refuse "cannot resolve the hcom store ${HCOM_DIR}"
    seats_real=$(cd "${seats_root}" && pwd -P) || refuse "cannot resolve the seats root ${seats_root}"
    sandbox_real=$(cd "${sandbox}" && pwd -P) || refuse "cannot resolve the seat sandbox directory ${sandbox}"
    sandbox_state=${seats_real}/.state/${name}
    # Exactly the list the protected set was built from (seat_write_roots), so the check and the sandbox cannot drift.
    write=("${seat_write[@]}")
    deny_write=("${seats_real}/.sandbox")
    for base in "${dir_real}" "${common_real%/.git}"; do
        deny_write+=("${base}/.claude/settings.json" "${base}/.claude/settings.local.json" "${base}/.claude/hooks"
            "${base}/.omp" "${base}/.codex" "${base}/.envrc" "${base}/.mcp.json")
    done
    # The git state host git reads for any worktree of this repository (regime-cutover U85): a seat that could write
    # it could make a later host git command run a program of its choosing (`core.fsmonitor`, `core.hooksPath`,
    # filter and textconv drivers, includes). git_state_check refuses a launch over such state and creates the files
    # that are absent, so each deny below names an existing path (srt on Linux binds only existing paths).
    git_state_check "${common_real}" "${dir_real}"
    deny_write+=("${git_state[@]}")
    # A worktree created after this launch gets its files denied on macOS by pattern; on Linux srt takes literal
    # write denies only, and the next launch's git_state_check covers it.
    [[ ${os} != Darwin ]] || deny_write+=("${common_real}/worktrees/*/config.worktree" "${common_real}/worktrees/*/info"
        "${common_real}/worktrees/*/commondir" "${common_real}/worktrees/*/gitdir")
    for path in config.toml env config.env .tmp/launch scripts integrations shell_env.json; do
        deny_write+=("${hcom_real}/${path}")
    done
    for path in settings.json settings.local.json hooks plugins commands agents skills CLAUDE.md; do
        deny_write+=("${claude}/${path}")
    done
    deny_read=("${h}/.ssh" "${h}/.gnupg" "${h}/.aws" "${h}/.netrc" "${h}/.docker" "${h}/.kube" "${h}/.config/gcloud"
        "${h}/.codex" "${h}/.omp/agent" "${h}/.omp/profiles" "${h}/.hcom" "${h}/.local/state/hcom"
        "${h}/.local/share/chezmoi" "${h}/.local/share/chezmoi-private" "${h}/.config/chezmoi"
        "${h}/.config/chezmoi-private" "${h}/Workspace" "${seats_real}/.sandbox")
    # Every program's seats root is unreadable but this seat's own paths: the whole ~/.local/state/omp-seats tree
    # and every configured seats root. srt keeps a deeper deny under an allow (measured, 0.0.81), so each
    # `.sandbox` stays unreadable inside an allowed root.
    deny_read+=("${h}/.local/state/omp-seats" "${seats_real}")
    if [[ -n ${REGIME_SEATS_ROOT:-} ]]; then
        root=$(physical_path "${REGIME_SEATS_ROOT}") || refuse "cannot resolve the seats root ${REGIME_SEATS_ROOT}"
        deny_read+=("${root}")
    fi
    allow_read=("${dir_real}" "${common_real}" "${hcom_real}" "${h}/.omp/profiles/${role}" "${sandbox_state}")
    # The coordinator's records (briefs, verdict files) are read by absolute path in the main checkout; nothing else
    # of it, or of ~/Workspace, is readable to a worker.
    allow_read+=("${common_real%/.git}/.orchestration/orchestrate")
    # The orchestrator reads the worker clones of its own program, which it reviews; a worker reads no other seat.
    if [[ ${role} == orchestrator ]]; then allow_read+=("${seats_real}"); fi
    settings=${sandbox_real}/srt-settings.json
    write_json=$(/usr/bin/jq -cn '$ARGS.positional' --args "${write[@]}") || refuse 'jq failed on the seat write roots'
    deny_write_json=$(/usr/bin/jq -cn '$ARGS.positional' --args "${deny_write[@]}") || refuse 'jq failed on the seat write denies'
    deny_read_json=$(/usr/bin/jq -cn '$ARGS.positional' --args "${deny_read[@]}") || refuse 'jq failed on the seat read denies'
    allow_read_json=$(/usr/bin/jq -cn '$ARGS.positional' --args "${allow_read[@]}") || refuse 'jq failed on the seat read roots'
    # No unix socket for any seat: the herdr socket would let a seat open a pane outside every sandbox. No local
    # binding either: srt 0.0.81 grants it as bind and inbound on `*:*` (every interface); the one listener a seat
    # runs, the hcom plugin's notify server, falls back to polling every 5 s when its bind fails (hcom.ts
    # `startNotifyServer`, `FALLBACK_PENDING_POLL_MS`).
    json=$(/usr/bin/jq -n --argjson write "${write_json}" --argjson deny_write "${deny_write_json}" \
        --argjson deny_read "${deny_read_json}" --argjson allow_read "${allow_read_json}" \
        --argjson linux "${linux_tools}" '{
        network: {
            allowedDomains: ["github.com", "api.github.com", "uploads.github.com", "codeload.github.com",
                "objects.githubusercontent.com", "raw.githubusercontent.com", "release-assets.githubusercontent.com",
                "pypi.org", "files.pythonhosted.org",
                "api.anthropic.com", "claude.ai", "platform.claude.com", "console.anthropic.com",
                "chatgpt.com", "auth.openai.com", "api.openai.com"],
            deniedDomains: [],
            allowUnixSockets: [],
            allowMachLookup: ["com.apple.trustd.agent"],
            allowLocalBinding: false
        },
        filesystem: {denyRead: $deny_read, allowRead: $allow_read, allowWrite: $write, denyWrite: $deny_write},
        allowPty: true
    } + $linux') || refuse "cannot render the seat sandbox settings for ${name}"
    if ! printf '%s\n' "${json}" > "${settings}.tmp" || ! mv -f "${settings}.tmp" "${settings}"; then
        refuse "cannot write ${settings}"
    fi
    # ~/.ssh is unreadable inside, so the seat pushes over HTTPS through the gh credential helper: an explicit
    # pushurl wins over a global `url.<ssh>.pushInsteadOf` rewrite. An origin that is neither HTTPS nor
    # git@github.com gets no override, and an SSH push from the seat fails.
    origin_url=$(git -C "${repo}" config --get remote.origin.url) || {
        (($? == 1)) || refuse "cannot read remote.origin.url in ${repo}"
        origin_url=''
    }
    case ${origin_url} in # lint-comparisons: allow a URL scheme prefix is the classification, no path compare
    https://*) push_url=${origin_url} ;;
    git@github.com:*) push_url=https://github.com/${origin_url#git@github.com:} ;;
    *) push_url='' ;;
    esac
    shim=${sandbox_real}/bin/omp
    {
        echo '#!/bin/bash'
        echo "# Generated by hcom-seat for the ${role} seat ${name} (regime-cutover U85); rewritten on every launch."
        echo '# A canary proves the sandbox holds before omp starts; there is no uncontained fallback.'
        echo 'set -u'
        printf -v srt_q '%q ' "${srt_cmd[@]}"
        printf -v omp_q '%q ' "${omp_cmd[@]}"
        echo "srt_cmd=(${srt_q}) omp_cmd=(${omp_q})"
        printf 'settings=%q canary=%q state=%q push_url=%q sandbox=%q\n' "${settings}" "${sandbox_real}/canary" \
            "${sandbox_state}" "${push_url}" "${sandbox_real}"
        # Outside the sandbox the shim and srt look up only in the private tool directory and the system directories;
        # inside it omp gets the seat's working PATH, applied by /usr/bin/env under srt.
        printf 'outer_path=%q seat_path=%q\n' "${sandbox_real}/bin:${PATH}" "${seat_path}"
        cat << 'SHIM'
export PATH=${outer_path}
/bin/rm -f "${canary}" || { echo "hcom-seat shim: cannot clear ${canary}" >&2; exit 2; }
# `true`, not `:`: a failed redirection on a special builtin ends a POSIX shell (dash, Ubuntu's /bin/sh).
probe=$("${srt_cmd[@]}" --settings "${settings}" -- /bin/sh -c 'if true 2> /dev/null > "$1"; then w=write-open; else w=write-denied; fi
if cat "$2" > /dev/null 2>&1; then r=read-open; else r=read-denied; fi
if ls "$3" > /dev/null 2>&1; then s=ssh-open; else s=ssh-denied; fi
echo "$w $r $s"' canary "${canary}" "${settings}" "${HOME}/.ssh") || {
    echo "hcom-seat shim: the sandbox canary did not run under ${srt_cmd[*]}; omp not started" >&2
    exit 2
}
if [[ ${probe} != 'write-denied read-denied ssh-denied' || -e ${canary} ]]; then
    echo "hcom-seat shim: the sandbox does not hold (canary: ${probe}); omp not started" >&2
    exit 2
fi
export UV_CACHE_DIR=${state}/uv-cache
# omp's Bedrock discovery stats ~/.aws/{credentials,config} unless these name the files, and an EPERM from the read
# deny ends omp at start (measured, omp 18.11.3); /dev/null reads as no AWS profile.
export AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_CONFIG_FILE=/dev/null
unset SSH_AUTH_SOCK
# Seat commits and tags are unsigned (standing order 29): the signing key under ~/.ssh is unreadable inside, so a
# host config with commit.gpgsign or tag.gpgsign true would fail every commit. GIT_CONFIG_* outranks every file.
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false \
    GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false
if [[ -n ${push_url} ]]; then
    export GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_2=remote.origin.pushurl GIT_CONFIG_VALUE_2=${push_url}
fi
# hcom-seat refuses to launch a seat where this is set.
export HCOM_SEAT_SANDBOX=${sandbox}
exec "${srt_cmd[@]}" --settings "${settings}" -- /usr/bin/env PATH="${seat_path}" "${omp_cmd[@]}" --no-extensions "$@"
SHIM
    } > "${shim}.tmp" || refuse "cannot write ${shim}.tmp"
    if ! chmod 700 "${shim}.tmp" || ! mv -f "${shim}.tmp" "${shim}"; then
        refuse "cannot install ${shim}"
    fi
    # hcom resolves `hcom` (for the runner script) and `herdr` (the terminal preset) from PATH; both find these
    # wrappers first, each of which runs exactly the physical argv pin_exec checked.
    seat_wrapper_write hcom "${hcom_cmd[@]}"
    seat_wrapper_write herdr "${herdr_cmd[@]}"
}

# @description Write `<sandbox>/bin/$1`, a wrapper that execs the given physical argv with its own arguments.
# @arg $1 string The command name.
# @arg $@ string The physical argv after the name.
seat_wrapper_write() {
    local tool=$1 argv_q
    shift
    printf -v argv_q '%q ' "$@"
    printf '#!/bin/bash\n# Generated by hcom-seat (regime-cutover U85): %s by its checked physical argv.\nexec %s"$@"\n' \
        "${tool}" "${argv_q}" > "${sandbox}/bin/${tool}.tmp" || refuse "cannot write ${sandbox}/bin/${tool}.tmp"
    if ! chmod 700 "${sandbox}/bin/${tool}.tmp" || ! mv -f "${sandbox}/bin/${tool}.tmp" "${sandbox}/bin/${tool}"; then
        refuse "cannot install ${sandbox}/bin/${tool}"
    fi
}

argv=(hcom omp --tag "${name}" --dir "${dir}" --terminal herdr --go -- --profile "${role}" --config "${policy}" --config "${profile}")
for ext in "${exts[@]}"; do
    argv+=(-e "${ext}")
done
argv+=(--hcom-team "${HCOM_TEAM}")
if ((dry_run)); then
    printf '%q ' "${argv[@]}"
    echo
    echo "hcom-seat: environment HCOM_DIR=${HCOM_DIR} HCOM_TEAM=${HCOM_TEAM:-}" >&2
    echo "hcom-seat: sandbox ${sandbox} (srt ${srt_cmd[*]}, omp ${omp_cmd[*]}, hcom ${hcom_cmd[*]}, herdr ${herdr_cmd[*]})" >&2
    exit 0
fi
# U37: a remote seat host needs this host's own login first (seat-login-preflight beside this file).
/bin/bash "${BASH_SOURCE[0]%/*}/seat-login-preflight" "${role}" || exit $?
if [[ ! -e ${dir} ]]; then
    # A repository without a remote (a fresh project) seats its worktrees at HEAD instead of origin/main. Only a
    # genuinely absent ref means that: a ref that is broken or names no commit, or a failed git, is a refusal.
    origin_main=$(git -C "${repo}" for-each-ref --format='%(objecttype)' refs/remotes/origin/main 2>&1) ||
        refuse "cannot inspect refs/remotes/origin/main in ${repo}: ${origin_main}"
    case ${origin_main} in
    commit) base=origin/main ;;
    '')
        base=HEAD
        echo "hcom-seat: origin/main is absent in ${repo}; the seat worktree starts at HEAD" >&2
        ;;
    *) refuse "refs/remotes/origin/main in ${repo} does not resolve to a commit: ${origin_main}" ;;
    esac
    git -C "${repo}" worktree add --detach "${dir}" "${base}"
elif seat_common='' && [[ -d ${dir} ]] && dir_phys=$(physical_path "${dir}") &&
    common_phys=$(physical_path "${common}") && git_state_check "${common_phys}" "${dir_phys}" &&
    ! seat_common=$(git -C "${dir}" rev-parse --path-format=absolute --git-common-dir 2> /dev/null) ||
    ! [[ -d ${dir} && ${seat_common} -ef ${common} ]]; then
    # A stale or foreign directory at the seat path would seat omp in the wrong tree.
    refuse "seat directory exists and is not a worktree of ${repo}: ${dir}"
fi
seat_sandbox_write
# hcom resolves `omp`, `hcom` and `herdr` from this PATH and pins the shim as the runner's tool path (U85); hcom
# itself runs by the physical argv checked above, with no second lookup.
export PATH="${sandbox}/bin:${PATH}"
exec "${hcom_cmd[@]}" "${argv[@]:1}"
