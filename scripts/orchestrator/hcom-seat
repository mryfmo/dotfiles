cred_root=router-credentials
case ${role} in
orchestrator | worker) role_launch=hcom omp_profile=${role} allow_local_binding=false role_profile='' state_root='' broker_dir='' cred_root_grant='' ;;
dsh) role_launch=foreground omp_profile=dsh allow_local_binding=false role_profile='' state_root='' broker_dir='' cred_root_grant=deny ;;
