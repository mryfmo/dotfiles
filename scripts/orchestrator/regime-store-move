#!/usr/bin/env bash
# @file regime-store-move
# @brief Judge whether a program's live store may move out of the main checkout to the derived store root, and print the operator's whole procedure, the copy included; this lever moves nothing.
# @description
#   Regime-cutover U221, store move 5 of 5 (handoff/07-store-move-design.md; U215 gave regime-env the root, U216 and
#   U220 gave the levers the two-form rule, U219 the seats' grants), reshaped by U221b, U221c and U221d (verdicts
#   U221-e82581f3, U221-738e89ca and U221-595a116a, class move-race; the mechanism-change rows of decisions
#   2026-11-08T05:44:20Z and 2026-11-08T10:26:46Z, form remove). The live store of a program is written unmasked
#   inside the main checkout's working tree at `.orchestration/orchestrate/<program>/` while `main` holds its masked
#   copies, so the checkout is never clean after a records sync and nothing fast-forwards it (standing order 40,
#   struck: no procedure or lever writes the coordinator's live main checkout again; decisions 2026-11-05T23:34:51Z).
#   The move of the live store to `${REGIME_STORE_ROOT}/<program>` (the root the sourced `regime-env` derives from the
#   physical HOME and the checkout's slug) is the mechanism that ends that class; this lever is the move's judge, not
#   its hand.
#   Why it moves nothing (U221d). Three rounds had the lever copy the live store itself, each under a control meant
#   to catch a writer during the run: two observations of the source held equal (rounds 1 and 2), then the source
#   made unwritable by mode before anything was read and a staging directory renamed into place under an identity
#   hold (round 3). Each round's audit found a same-user writer the control did not see: a record written between
#   two observations, a descriptor opened before the mode change, a pathname replaced between an identity read and
#   its removal, two movers overlapping. A same-user writer defeats every observation, mode and identity control. The
#   one actor who can make the host quiescent is the operator, by stopping every seat and ending every coordinator
#   process, and the write to the checkout was the operator's already; so the copy phase left the lever. It reads,
#   judges and prints the operator's procedure as commands to run from a terminal on a quiescent host.
#   What it reads. The main checkout (a linked worktree is refused), `regime_env` for the root, the live store's walk
#   (U220's derived walk, `find ! -type d` through `read_listing`: every entry a regular file below the store with no
#   symlink component, no control character, no `..`, no name beginning with `.`; `redact-words.txt` included, since
#   the new root is the live store), and whether the derived store `${REGIME_STORE_ROOT}/<program>` exists (a link or
#   a file there, or a component whose mode is not 0700, is refused by name).
#   Before the move (the derived store absent; the store root `${REGIME_STORE_ROOT}` must exist, as hcom-seat makes it
#   when a seat starts, U219) it checks that a sync is not still due: origin's `main` is fetched into a scratch
#   repository (`git init --bare --template=` under `$TMPDIR`, every command through `git_isolated`, the https URL
#   read once from the checkout, the credential helper `!gh auth git-credential` only), its tree is listed at the
#   published prefix (`ls-tree -r -z`), each live file but `redact-words.txt` is read into a scratch copy (`cat`, the
#   status read) and masked there with main's `scripts/validate-agent-assets.py --mask-secrets` (the checkout's files
#   are never changed; the masker's output is withheld), and the masked copy's `<mode> blob <oid>` must equal main's
#   entry for every path, no live path may be absent from main but `redact-words.txt`, and no path of main may be
#   absent from the live store (a deletion the sync would carry); otherwise `refused: a records sync is still due
#   (<n> path(s) differ ...)`, the count and not the paths (a path may hold a redact word). When every path is equal
#   it prints the verdict `ready: <n> live files equal origin/main's masked copies` and the procedure, seven
#   numbered lines, each a complete command or one sentence: (1) stop every seat and end every coordinator process
#   (`regime-stop --all`, the kit's stop); (2) the copy of the checkout store to `${REGIME_STORE_ROOT}/<program>`
#   with its modes and times kept; (3) the recursive comparison of the two and the count of the copy's files (`<n>`
#   plus `redact-words.txt`); (4) the checkout's own `checkout -- <prefix>`; (5) its `clean -fd -- <prefix>`; (6) its
#   `pull --ff-only`; (7) this lever again. The operator runs them by hand, once, after the last records sync from
#   inside has merged; lines (4) to (6) are the last write to the coordinator's live checkout by anyone.
#   After the move (the derived store present) it counts the derived store's files (`find ! -type d` through
#   `read_listing`; a derived store with no file is refused: regime-init's empty directory, not the moved store) and
#   reads `git status --porcelain` of the checkout's store subtree (under `--no-optional-locks`, so the read refreshes
#   no index): empty, it prints `moved: the derived store holds <m> files; the checkout store is clean against HEAD`;
#   else `refused: the checkout store is not clean (<k> entries); finish the step`.
#   Every producer's status is read (standing order 21): a failed or warning walk, an unreadable `origin` URL, a
#   failed `git status` or a count that fails refuses (exit 2); a step after the reads that fails (the fetch, a write
#   under the scratch directory, the masker, a hash) exits 1 naming the step. The lever writes nothing anywhere but
#   its scratch directory under `$TMPDIR`, which is removed on every exit, changes no mode, and runs no git against
#   the checkout but `rev-parse` and `status`; the fetched `main` and the masked copies live in the scratch directory
#   alone.
# @arg $1 string The program (`^[a-z0-9][a-z0-9_-]{0,63}$`), whose live store is `<toplevel>/.orchestration/orchestrate/<program>/`; the one argument.
# @stdout Before the move: `ready: <n> live files equal origin/main's masked copies`, then the procedure, seven numbered lines. After it: `moved: the derived store holds <m> files; the checkout store is clean against HEAD`.
# @stderr `regime-store-move: live store <dir> (<n> files); derived store <dir>; origin/main <sha> at <prefix>/ equals the live store masked`, or `regime-store-move: derived store <dir> (<m> files); checkout store <dir> clean against HEAD`, or the refusal.
# @exitcode 0 The verdict is `ready` or `moved`.
# @exitcode 1 A step after the reads failed (the fetch, a write under the scratch directory, the masker, a hash); nothing is printed on stdout.
# @exitcode 2 Refused: usage, a linked worktree, no live store, a listed entry outside the derived walk's shape, a destination component that is not a 0700 directory of this user, a store root that does not exist, a derived store with no file, a sync still due, a checkout store not clean after the move, or a failed or warning read (a walk, the origin URL, `git status`, a count).
# @example
#   regime-store-move regime-cutover
set -euo pipefail

# @description Refuse to run unless this file's sha256 equals its pin in the manifest beside it (regime-cutover U31):
#   `~/.agents/agent-config.yaml` for the installed copy under ~/.local/bin/common, which a sandboxed session cannot
#   write, else the checkout's home/dot_agents/agent-config.yaml. Every read is checked; a failure exits 2 naming the
#   file. The pin is the `claude.levers.sha256.<name>` line, which `scripts/generate-agent-configs.py` refreshes. The
#   HOME read and the hash read are each tested where they stand (an `if`, a `||` with the refusal), so no read
#   carries a producer-status allow comment (U221).
# @set LEVER_MANIFEST The manifest the pin came from.
# @set LEVER_DIR The physical directory of this file, where the sourced libraries sit.
lever_self_check() {
    local src dir self name pin digest home
    # The directory is split from the path in the shell, so no external producer (dirname) can fail unseen.
    src=${BASH_SOURCE[0]}
    case ${src} in
    */*) dir=${src%/*} ;;
    *) dir=. ;;
    esac
    [[ -n ${dir} ]] || dir=/
    dir=$(cd "${dir}" && pwd -P) || {
        echo "${src##*/}: refused: cannot resolve the script directory of ${src}" >&2
        exit 2
    }
    self=${dir}/${BASH_SOURCE[0]##*/}
    LEVER_DIR=${dir}
    name=${self##*/}
    # The checkout layout unless this file sits in the installed directory under the physical HOME; a HOME that cannot
    # be entered is the checkout layout too, decided here, not by an empty value read later.
    LEVER_MANIFEST=${dir}/../../home/dot_agents/agent-config.yaml
    if home=$(cd "${HOME}" 2> /dev/null && pwd -P); then
        if [[ ${dir} == "${home}/.local/bin/common" ]]; then # lint-comparisons: allow both sides are pwd -P forms
            LEVER_MANIFEST=${HOME}/.agents/agent-config.yaml
        fi
    fi
    [[ -r ${LEVER_MANIFEST} ]] || {
        echo "${name}: refused: manifest unreadable: ${LEVER_MANIFEST}" >&2
        exit 2
    }
    pin=$(sed -n -E "s/^      ${name//./\\.}: ([0-9a-f]{64})\$/\\1/p" "${LEVER_MANIFEST}") || {
        echo "${name}: refused: cannot read ${LEVER_MANIFEST}" >&2
        exit 2
    }
    [[ ${pin} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: no single sha256 pin for ${name} in ${LEVER_MANIFEST}" >&2
        exit 2
    }
    if command -v sha256sum > /dev/null; then
        digest=$(sha256sum < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    else
        digest=$(shasum -a 256 < "${self}") || {
            echo "${name}: refused: cannot hash ${self}" >&2
            exit 2
        }
    fi
    digest=${digest%% *}
    [[ ${digest} =~ ^[0-9a-f]{64}$ ]] || {
        echo "${name}: refused: cannot hash ${self}" >&2
        exit 2
    }
    [[ ${digest} == "${pin}" ]] || {
        echo "${name}: refused: sha256 ${digest} of ${self} differs from the pin in ${LEVER_MANIFEST}" >&2
        exit 2
    }
}
lever_self_check
# The isolated git and the environment scrub come from the library beside this script (U113). The scrub runs here,
# before the first git: GIT_CONFIG_* would add config, includes and URL rewrites to every git command, GIT_DIR would
# point every command at another repository, and a proxy or certificate variable would steer the fetch.
[[ -r ${LEVER_DIR}/git-isolated.sh ]] || {
    echo "regime-store-move: refused: git-isolated.sh unreadable beside this script: ${LEVER_DIR}/git-isolated.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/git-isolated.sh
. "${LEVER_DIR}/git-isolated.sh"
# shellcheck disable=SC2119 # no name is kept: every GIT_* and transport variable goes
git_env_scrub

[[ -r ${LEVER_DIR}/read-lib.sh ]] || {
    echo "regime-store-move: refused: read-lib.sh unreadable beside this script: ${LEVER_DIR}/read-lib.sh" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/read-lib.sh
. "${LEVER_DIR}/read-lib.sh"

# The store root (U215, U216): the program stores lie under `REGIME_STORE_ROOT`, the root the sourced regime-env
# derives from the physical HOME and this checkout's slug and holds component by component; the helper is sourced
# from the directory this lever runs from and self-checked like a lever (U33), so a rewritten copy stops this lever.
# The call that derives the root comes after this lever's own checkout checks, below.
[[ -r ${LEVER_DIR}/regime-env ]] || {
    echo "regime-store-move: refused: regime-env unreadable beside this script: ${LEVER_DIR}/regime-env" >&2
    exit 2
}
# shellcheck source=scripts/orchestrator/regime-env
. "${LEVER_DIR}/regime-env"

lever=regime-store-move
usage='usage: regime-store-move <program>'

# @description Print the refusal on stderr and exit 2.
# @arg $@ string The reason.
refuse() {
    echo "${lever}: refused: $*" >&2
    exit 2
}

# @description Print the failure on stderr and exit 1 (the EXIT trap removes the scratch directory).
# @arg $@ string The reason.
fail() {
    echo "${lever}: $*" >&2
    exit 1
}

scratch=''
# @description The EXIT trap: the scratch directory goes, and nothing else; this lever makes nothing anywhere else.
cleanup() {
    if [[ -n ${scratch} && -d ${scratch} ]]; then
        rm -r "${scratch}" 2> /dev/null || echo "${lever}: could not remove ${scratch}" >&2
    fi
}

# @description Run the isolated git in the comparison's own repository (the shape of records-sync.sh, U101): the
#   repository named by `--git-dir`, so no checkout is consulted, and nothing of the user, system or checkout
#   configuration (git-isolated.sh, U113).
# @arg $@ string The `git` arguments.
git_scratch() {
    git_isolated --git-dir="${repo}" "$@"
}

# @description Print the number of entries of a NUL-separated listing: `tr` keeps the NULs alone and `wc -c` counts
#   them, the status of the pipeline read (`pipefail`), the blanks of wc's output removed.
# @arg $1 path The listing.
# @exitcode 0 The count was printed.
# @exitcode 2 tr or wc failed, or printed no number.
count_entries() {
    local ce_out
    ce_out=$(tr -cd '\000' < "$1" | wc -c) || return 2
    ce_out=${ce_out//[[:space:]]/}
    [[ ${ce_out} =~ ^[0-9]+$ ]] || return 2
    printf '%s\n' "${ce_out}"
}

# @description Print the operator's procedure, seven numbered lines, each a complete command or one sentence, the
#   paths quoted for the shell: the stop of every seat and every coordinator process (`regime-stop --all`, the kit's
#   stop, which is `regime-start --stop --all`), the copy of the checkout store to the derived store with its modes
#   and times kept, the recursive comparison and the count of the copy's files, the checkout's own `checkout --
#   <prefix>`, `clean -fd -- <prefix>` and `pull --ff-only`, and this lever again, which then reports the moved
#   state. The procedure is printed, never run: the host is quiescent only under the operator's hand, and the live
#   checkout is written by the operator's hand alone, once (the struck order 40's successor rule).
# @arg $1 int The number of files of the live store, the count the copy must show.
# @arg $2 string What that count is made of (the compared files and `redact-words.txt`), for the note of line 3.
print_procedure() {
    local pp_total=$1 pp_note=$2
    printf '1. Stop every seat and end every coordinator process: run regime-stop --all in %q (the stop of the kit, regime-start --stop --all), confirm with hcom list -v that no seat of this checkout is alive, and close every session that runs a lever of the kit against it.\n' "${top_real}"
    printf '2. cp -a %q %q\n' "${live}" "${dest}"
    printf '3. diff -r %q %q && find %q -type f | wc -l   # expect no line from diff and the count %s (%s)\n' "${live}" "${dest}" "${dest}" "${pp_total}" "${pp_note}"
    printf '4. git -C %q checkout -- %q\n' "${top_real}" "${records}"
    printf '5. git -C %q clean -fd -- %q\n' "${top_real}" "${records}"
    printf '6. git -C %q pull --ff-only\n' "${top_real}"
    printf '7. regime-store-move %q\n' "${program}"
}

case ${OSTYPE} in
darwin*) stat_mode=(-f %Lp) ;;
*) stat_mode=(-c %a) ;;
esac

# @description Hold one component of the destination (`regime-store`, the store root `<slug>`, the program directory)
#   as regime-init holds them (U215b, U215c): a symbolic link refuses by name; present, it must be a real directory of
#   this user whose mode is 0700, read by `/usr/bin/stat` with its status (a failed read refuses, standing order 21);
#   absent, nothing. Nothing is written.
# @arg $1 path The directory.
# @arg $2 string What it is, for the refusal.
store_dir_hold() {
    local path=$1 what=$2 mode
    [[ ! -L ${path} ]] || refuse "${what} ${path} is a symlink"
    [[ -e ${path} ]] || return 0
    [[ -d ${path} && -O ${path} ]] || refuse "${what} ${path} is not a real directory of this user"
    mode=$(/usr/bin/stat "${stat_mode[@]}" "${path}") || refuse "cannot read the mode of ${what} ${path}"
    [[ ${mode} == 700 ]] || refuse "${what} ${path} has mode ${mode}, not 0700"
}

# @description Hold one entry of the live store's walk to the derived walk's shape (U220, U28b F2): below the store,
#   no control character (a newline would hide a component), no `..`, no component beginning with `.` (no record
#   carries such a name, and the derived form's walk refuses it, so the move does too), no symbolic link at any
#   component, a regular file whose directory resolves (`pwd -P`) inside the store; then append its relative path to
#   the file list. A refusal names the entry's relative path, never its text.
# @arg $1 path The entry as find prints it.
# @arg $2 path The NUL-separated file list the relative path is appended to.
check_entry() {
    local ce_entry=$1 ce_out=$2 rel prefix part rest entry_dir
    case ${ce_entry} in # lint-comparisons: allow a path as find prints it, refused unless below the live store
    "${live}"/?*) ;;
    *) refuse "the walk of ${live} names a path outside the live store; the procedure is not printed" ;;
    esac
    rel=${ce_entry#"${live}/"}
    [[ ${rel} != *[[:cntrl:]]* ]] || refuse "a path of the live store holds a control character; the procedure is not printed" # lint-comparisons: allow a character test on the raw path
    [[ ${rel} != *..* ]] || refuse "a path of the live store holds '..': ${rel}; the procedure is not printed"                 # lint-comparisons: allow refuses a raw path that holds ..
    prefix=${live}
    rest=${rel}
    # Split on `/` by parameter expansion (no here-string, so no temporary file can go missing, U101).
    while [[ -n ${rest} ]]; do
        part=${rest%%/*}
        if [[ ${rest} == */* ]]; then # lint-comparisons: allow splits the path into its components
            rest=${rest#*/}
        else
            rest=''
        fi
        [[ ${part} != .* ]] || # lint-comparisons: allow a name test on one component of the walk
            refuse "a name of the live store begins with '.', which no record carries and the derived walk refuses (U220): ${rel}; remove it by hand, the procedure is not printed"
        prefix=${prefix}/${part}
        [[ ! -L ${prefix} ]] || refuse "a component of a path of the live store is a symlink: ${prefix}; the derived walk refuses it (U220); remove it by hand, the procedure is not printed"
    done
    [[ -f ${prefix} ]] || refuse "a path of the live store is not a regular file: ${rel}; the procedure is not printed"
    entry_dir=$(cd "${prefix%/*}" && pwd -P) || refuse "cannot resolve the directory of ${rel}"
    [[ ${entry_dir} == "${live}" || ${entry_dir} == "${live}"/* ]] || # lint-comparisons: allow both sides are pwd -P forms
        refuse "a path of the live store resolves outside ${live}: ${rel}; the procedure is not printed"
    printf '%s\0' "${rel}" >> "${ce_out}" || fail 'cannot write the file list'
}

# @description Walk the live store as U220's derived walk does: the directories first, each readable and searchable
#   (find exits non-zero for a directory it cannot read, and any warning of either producer refuses the run,
#   read_listing); then every entry below it that is not a directory (`-type f` would skip a symbolic link instead of
#   refusing it), each held by check_entry, its relative path appended to the file list. Neither find output is shown
#   (a store path may hold a redact word).
# @arg $1 path The NUL-separated file list this writes, under the scratch directory.
walk_store() {
    local ws_out=$1 ws_dir='' ws_entry='' ws_status=0
    read_listing "${ws_out}.dirs" "${ws_out}.dirs.err" find "${live}" -type d -print0 ||
        refuse "the directory walk of the live store ${live} failed or warned (find; its output is withheld); the procedure is not printed"
    while read -r -d '' ws_dir; do
        [[ -r ${ws_dir} && -x ${ws_dir} ]] || refuse "a directory under ${live} cannot be read or entered; the procedure is not printed"
    done < "${ws_out}.dirs"
    [[ -z ${ws_dir} ]] || refuse "the directory walk of ${live} ends mid-entry; the procedure is not printed"
    read_listing "${ws_out}.listing" "${ws_out}.listing.err" find "${live}" ! -type d -print0 || ws_status=$?
    case ${ws_status} in
    0) ;;
    1) refuse "the live store ${live} holds no file; nothing to move" ;;
    *) refuse "the walk of the live store ${live} failed or warned (find; its output is withheld); the procedure is not printed" ;;
    esac
    : > "${ws_out}" || fail "cannot write the file list ${ws_out}"
    while read -r -d '' ws_entry; do
        check_entry "${ws_entry}" "${ws_out}"
    done < "${ws_out}.listing"
    [[ -z ${ws_entry} ]] || refuse "the walk of ${live} ends mid-entry; the procedure is not printed"
}

program=''
for arg in "$@"; do
    case ${arg} in
    -*) refuse "${usage}" ;;
    *)
        [[ -z ${program} ]] || refuse "${usage}"
        program=${arg}
        ;;
    esac
done
[[ -n ${program} ]] || refuse "${usage}"
[[ ${program} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "program '${program}' is outside ^[a-z0-9][a-z0-9_-]{0,63}\$"

toplevel=$(git_isolated rev-parse --show-toplevel 2> /dev/null) || refuse 'not in a git checkout'
git_dir=$(git_isolated rev-parse --path-format=absolute --git-dir) || refuse 'cannot read the git directory'
common_dir=$(git_isolated rev-parse --path-format=absolute --git-common-dir) || refuse 'cannot read the git common directory'
git_dir=$(cd "${git_dir}" && pwd -P) || refuse "cannot resolve ${git_dir}"
common_dir=$(cd "${common_dir}" && pwd -P) || refuse "cannot resolve ${common_dir}"
[[ ${git_dir} == "${common_dir}" ]] || # lint-comparisons: allow both sides are pwd -P forms
    refuse "${toplevel} is a linked worktree; run from the main checkout, where the live store lies"
cd "${toplevel}" || refuse "cannot enter ${toplevel}"
# The toplevel is physical, so every path below is measured against the real checkout (U28b F2).
top_real=$(pwd -P) || refuse "cannot resolve ${toplevel}"
# regime-env derives `REGIME_STORE_ROOT` for this checkout (its own refusals name this lever). This lever reads nothing
# in the hcom store, so the store's `origin` binding is not asked of it (`--unbound-ok`, as pr-merge.sh and
# records-sync.sh ask: the dotfiles program runs on the pre-U33 store pair and its derived hcom store carries no
# `origin`); the collision refusal and every store-root hold stay. The helper's return 1 is this lever's exit 2.
regime_env regime-store-move --unbound-ok || exit 2
[[ -n ${REGIME_STORE_ROOT:-} ]] || refuse "regime-env derived no store root for ${top_real}; the derived store lies under it (U215, U216)"

# The live store: the checkout's own `.orchestration/orchestrate/<program>`, the pre-move form, each of its three
# components a directory of this user and no symlink (the pr-merge.sh hold of U216).
records=.orchestration/orchestrate/${program}
live=${top_real}/${records}
path=${top_real}
for part in .orchestration orchestrate "${program}"; do
    path=${path}/${part}
    [[ -d ${path} && ! -L ${path} && -O ${path} ]] ||
        refuse "${path} is not a directory of this user (a symlink or a missing store); the live store this lever judges is the checkout's ${records}/"
done
# The destination and its components, outermost first: `regime-store`, the store root `<slug>`, the program store.
store_root=${REGIME_STORE_ROOT}
store_parent=${store_root%/*}
dest=${store_root}/${program}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/regime-store-move.XXXXXX") || fail 'mktemp failed'
trap cleanup EXIT

# The destination before anything is read from the store: every component held, nothing written. The program store's
# existence is the state: absent, the move is still to come and the procedure is judged; present, the move ran and
# the operator's step is judged.
store_dir_hold "${store_parent}" 'the store parent'
store_dir_hold "${store_root}" 'the store root'
store_dir_hold "${dest}" 'the program store'

if [[ -e ${dest} ]]; then
    # After the move. The derived store's files are counted (a report, not a decision: no shape hold, since the
    # levers write there now), and the checkout's store subtree is read through `git status --porcelain`, under
    # `--no-optional-locks` so the read refreshes no index: an empty status is the operator's step finished; anything
    # else is the step still to finish, refused naming the count of entries; a status that fails or warns refuses.
    derived_status=0
    read_listing "${scratch}/derived" "${scratch}/derived.err" find "${dest}" ! -type d -print0 || derived_status=$?
    case ${derived_status} in
    0) ;;
    1) refuse "the derived store ${dest} exists and holds no file: regime-init's empty directory, not the moved store; remove it by hand before the move, nothing printed" ;;
    *) refuse "the walk of the derived store ${dest} failed or warned (find; its output is withheld); nothing printed" ;;
    esac
    moved=$(count_entries "${scratch}/derived") || refuse "cannot count the files of the derived store ${dest} (tr or wc failed); nothing printed"
    status_state=0
    read_listing "${scratch}/status" "${scratch}/status.err" git_isolated --no-optional-locks status --porcelain -- "${records}" || status_state=$?
    case ${status_state} in
    0)
        dirty=$(wc -l < "${scratch}/status") || refuse 'cannot count the entries of git status (wc failed); nothing printed'
        dirty=${dirty//[[:space:]]/}
        refuse "the checkout store is not clean (${dirty} entries); finish the step"
        ;;
    1) ;;
    *) refuse "cannot read git status of ${records} (git status failed or warned; its output is withheld); nothing printed" ;;
    esac
    echo "${lever}: derived store ${dest} (${moved} files); checkout store ${live} clean against HEAD" >&2
    echo "moved: the derived store holds ${moved} files; the checkout store is clean against HEAD"
    exit 0
fi

# Before the move. The store root must exist: hcom-seat makes it when a seat of this checkout starts (U219), and the
# procedure's copy lands under it; this lever makes nothing.
[[ -d ${store_root} ]] ||
    refuse "the store root ${store_root} does not exist (hcom-seat makes it when the orchestrator seat starts, U219; this lever makes nothing); the procedure is not printed"

# The live store's walk, every entry held to the derived walk's shape; its count is the count the copy must show.
walk_store "${scratch}/rels"
total=$(count_entries "${scratch}/rels") || refuse 'cannot count the live store (tr or wc failed); the procedure is not printed'

# origin's main, fetched into a scratch repository from the https URL read once from the checkout (the shape of
# records-sync.sh, U101): the checkout's own `refs/remotes/origin/main` may be stale, and its configuration is not
# read. The listing at the published prefix is the comparison's other side.
status=0
push_url=''
read_config git_isolated remote.origin.url push_url "${scratch}/config.err" || status=$?
case ${status} in
0) ;;
1) refuse 'remote.origin.url is unset or empty in the checkout; origin/main is fetched from it' ;;
*) refuse 'cannot read git config remote.origin.url (git config failed); the procedure is not printed' ;;
esac
case ${push_url} in # lint-comparisons: allow the URL's scheme as configured, the fetch source itself
https://?*) ;;
*) refuse "the fetch of origin/main needs an https origin URL, not ${push_url}" ;;
esac
repo=${scratch}/repo.git
git_isolated init --quiet --bare --template= "${repo}" || fail 'git init --bare for the comparison failed'
git_scratch -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
    fetch --quiet --no-tags "${push_url}" refs/heads/main || fail 'git fetch main from origin failed'
main=$(git_scratch rev-parse --verify 'FETCH_HEAD^{commit}') || fail 'cannot read the fetched main'
# Full entries (`<mode> blob <oid>` TAB path) of main at the published prefix.
git_scratch ls-tree -r -z "${main}" -- "${records}/" > "${scratch}/main-listing" || fail "git ls-tree origin/main ${records}/ failed"
base_entries=$'\n'
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != *[[:cntrl:]]* ]] || refuse "a path of origin/main:${records}/ holds a control character" # lint-comparisons: allow a character test on the raw git path
    base_entries+=${path}$'\t'${entry%%$'\t'*}$'\n'
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"

# The masker and the comparison: main's validator alone in a tools tree under the scratch directory whose `home/`
# holds main's top-level entry names (so its home-path pattern skips the repository's own `home/<entry>` paths as in
# a checkout; empty when main has no `home/`), the directories made by `install -d` with the status read; each live
# file but `redact-words.txt` read by `cat` into a scratch copy named by `mktemp` (the copy takes the default mode, so
# the masker can rewrite it in place; the live file's executable bit is read from the live file) and masked there;
# the masked copy's `<mode> blob <oid>` against main's entry. The checkout's files are never changed.
tools=${scratch}/tools
install -d "${tools}/scripts" "${tools}/home" || fail 'cannot make the tools tree'
git_scratch cat-file blob "${main}:scripts/validate-agent-assets.py" > "${tools}/scripts/validate-agent-assets.py" ||
    fail 'cannot read scripts/validate-agent-assets.py of origin/main'
git_scratch ls-tree -z --name-only "${main}" -- home/ > "${scratch}/home-entries" || fail 'cannot list home/ of origin/main'
entry=''
while read -r -d '' entry; do
    entry=${entry#home/}
    [[ -n ${entry} && ${entry} != *[/[:cntrl:]]* && ${entry} != . && ${entry} != .. ]] || # lint-comparisons: allow a tree entry name as git prints it
        fail 'home/ of origin/main holds an unusable entry name'
    install -d "${tools}/home/${entry}" || fail 'cannot make the tools tree'
done < "${scratch}/home-entries"
[[ -z ${entry} ]] || fail 'the listing of home/ of origin/main ends mid-entry'
: > "${scratch}/copy-map" || fail 'cannot write the copy map'
masked=()
has_redact=0
rel=''
while read -r -d '' rel; do
    if [[ ${rel} == redact-words.txt ]]; then
        has_redact=1
        continue
    fi
    copy=$(mktemp "${scratch}/copy.XXXXXX") || fail 'mktemp for a scratch copy failed'
    cat -- "${live}/${rel}" > "${copy}" || fail 'the read of a live file into its scratch copy failed (cat)'
    printf '%s\t%s\n' "${copy}" "${rel}" >> "${scratch}/copy-map" || fail 'cannot write the copy map'
    masked+=("${copy}")
done < "${scratch}/rels"
[[ -z ${rel} ]] || refuse "the file list of ${live} ends mid-entry; the procedure is not printed"
compared=$(wc -l < "${scratch}/copy-map") || refuse 'cannot count the compared files (wc failed); the procedure is not printed'
compared=${compared//[[:space:]]/}
if [[ -n ${masked[*]:-} ]]; then
    # The masker prints each copy's path and, on a key collision, the original keys; either may hold a redact word or
    # a secret, so its output goes to a file in the scratch directory and a failure says only that it happened.
    status=0
    uv run --no-project python -I "${tools}/scripts/validate-agent-assets.py" --mask-secrets "${masked[@]}" \
        > "${scratch}/mask.log" 2>&1 || status=$?
    [[ ${status} == 0 ]] || fail "masking the copies failed (exit ${status}); its output is withheld, the procedure is not printed"
fi
: > "${scratch}/differ" || fail 'cannot write the difference list'
live_paths=$'\n'
line=''
while read -r line; do
    copy=${line%%$'\t'*}
    rel=${line#*$'\t'}
    path=${records}/${rel}
    live_paths+=${path}$'\n'
    blob=$(git_scratch hash-object --no-filters -- "${copy}") || fail 'git hash-object of a masked copy failed'
    mode=100644
    if [[ -x ${live}/${rel} ]]; then
        mode=100755
    fi
    if [[ ${base_entries} != *$'\n'"${path}"$'\t'"${mode} blob ${blob}"$'\n'* ]]; then # lint-comparisons: allow a published path and an object id as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/copy-map"
[[ -z ${line} ]] || fail 'the copy map ends mid-entry'
# A path main holds that the live store does not is a deletion the sync would carry: a difference too.
entry=''
while read -r -d '' entry; do
    path=${entry#*$'\t'}
    [[ ${path} != "${records}/redact-words.txt" ]] || continue # lint-comparisons: allow the one published path the sync never writes
    if [[ ${live_paths} != *$'\n'"${path}"$'\n'* ]]; then      # lint-comparisons: allow published paths as git prints them
        printf '%s\0' "${path}" >> "${scratch}/differ" || fail 'cannot write the difference list'
    fi
done < "${scratch}/main-listing"
[[ -z ${entry} ]] || refuse "the listing of origin/main:${records}/ ends mid-entry"
differ=$(count_entries "${scratch}/differ") || refuse 'cannot count the differences (tr or wc failed); the procedure is not printed'
[[ ${differ} == 0 ]] ||
    refuse "a records sync is still due (${differ} path(s) differ between the live store, masked, and origin/main at ${records}/); run records-sync.sh, merge it and run this lever again (a path git ignores never syncs and must be removed from the live store by hand); the procedure is not printed"
echo "${lever}: live store ${live} (${total} files); derived store ${dest}; origin/main ${main} at ${records}/ equals the live store masked" >&2

if [[ ${has_redact} == 1 ]]; then
    note="${compared} compared files and redact-words.txt"
else
    note="${compared} compared files, no redact-words.txt"
fi
echo "ready: ${compared} live files equal origin/main's masked copies"
print_procedure "${total}" "${note}"
